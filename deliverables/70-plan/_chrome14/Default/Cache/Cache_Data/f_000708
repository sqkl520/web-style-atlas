<script>
(function () {
  var doc = document.documentElement;
  var grid = document.querySelector('.fork__grid');
  var stack = document.querySelector('[data-stack]');
  var state = document.querySelector('[data-fault-state]');

  /* 入场：节点进入视口上方 60% 才展开（不是整块淡入）；首屏里的元素先放行 */
  var grow = document.querySelectorAll('[data-grow]');
  var fold = innerHeight * 0.92;
  grow.forEach(function (el) {
    var r = el.getBoundingClientRect();
    if (r.top < fold && r.bottom > 0) el.classList.add('in');
  });
  if ('IntersectionObserver' in window) {
    var io = new IntersectionObserver(function (list) {
      list.forEach(function (e) {
        if (!e.isIntersecting) return;
        e.target.classList.add('in');
        io.unobserve(e.target);
      });
    }, { rootMargin: '0px 0px -40% 0px', threshold: 0 });
    grow.forEach(function (el) { io.observe(el); });
  } else {
    grow.forEach(function (el) { el.classList.add('in'); });
  }

  /* 孢子节点：选中时内部填纸色、外缘多 1px 未曝光白晕 */
  document.addEventListener('click', function (e) {
    var node = e.target.closest('.node');
    if (node) {
      var on = node.getAttribute('aria-pressed') === 'true';
      node.setAttribute('aria-pressed', on ? 'false' : 'true');
      return;
    }
    /* 微交互：末端叶的叶柄上出现或收掉一枚 4px 纸白缺口 */
    var pick = e.target.closest('.leaf__pick');
    if (pick) {
      var leaf = pick.closest('.leaf');
      var got = leaf.getAttribute('data-picked') === 'true';
      leaf.setAttribute('data-picked', got ? 'false' : 'true');
      pick.setAttribute('aria-pressed', got ? 'false' : 'true');
      pick.textContent = got ? '标记已采集' : '取消采集标记';
      return;
    }
    /* 回缩一层：同一路径再次点击把下一层的线按原路退回去 */
    var retract = e.target.closest('.retract');
    if (retract) {
      var target = document.querySelector(retract.getAttribute('data-retract'));
      if (!target) return;
      var back = target.classList.toggle('is-retracted');
      retract.setAttribute('aria-pressed', back ? 'true' : 'false');
      retract.textContent = back ? '长回一层' : '回缩一层';
      return;
    }
    /* 跳过这一轮曝光 */
    if (e.target.closest('[data-skip]')) {
      stack.classList.add('done');
      e.target.closest('[data-skip]').textContent = '已经跳过了这一轮';
      return;
    }
    /* 768–1023：叶脉小图回溯导航，切换当前选中的那一条路径 */
    var btn = e.target.closest('[data-path-btn]');
    if (btn) {
      var want = btn.getAttribute('data-path-btn');
      grid.setAttribute('data-path', want);
      document.querySelectorAll('[data-path-btn]').forEach(function (b) {
        b.setAttribute('aria-pressed', b === btn ? 'true' : 'false');
      });
      document.querySelectorAll('.veinmap path').forEach(function (p, i) {
        p.classList.toggle('on', (want === 'a' && i === 0) || (want === 'b' && i === 1));
      });
      return;
    }
    /* 错误态：把缺段排进下一次采集窗口 */
    if (e.target.closest('[data-resync]')) {
      var b = e.target.closest('[data-resync]');
      b.disabled = true;
      b.textContent = '已排进 2019 年 4 月之后的第一场雨';
      state.textContent = '第 12 支的缺段还没回来。错误码 VEIN-47 仍然挂着，已经标好的 11 支线宽与 2px 节点缺口不受影响。';
    }
  });

  /* 键盘也能触发展开：焦点进入分支时按 60% 规则放行一次 */
  document.addEventListener('focusin', function (e) {
    var el = e.target.closest('[data-grow]');
    if (el) el.classList.add('in');
  });
})();
</script>
