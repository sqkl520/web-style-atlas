  <p class="foot__note">本簿 14 枚锁闭条由同一把刻刀逐条刻成，条尾墨点随刻程向右下各偏 0.25 像素，刻到第 14 枚时共偏出 3.5 像素，正好压在线框上。</p>
  <p class="foot__note foot__note--src">形制参考：1900 至 1950 年代机械联锁机锁闭表、瑞士联邦铁路值班室行车序列表、道岔号牌的黑底白字刻印。本页不含蒸汽机车、钢轨或制服图形。</p>
</footer>

<script>
(function () {
  'use strict';
  var rm = window.matchMedia('(prefers-reduced-motion: reduce)');

  var path = document.getElementById('release-path');
  if (path) {
    var arm = function () { path.classList.add('is-armed'); };
    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (e.intersectionRatio >= 0.2) { arm(); io.disconnect(); }
        });
      }, { threshold: [0.2] });
      io.observe(path);
    } else { arm(); }
  }

  var bars = Array.prototype.slice.call(document.querySelectorAll('.lockbar[data-lock]'));
  var byNo = {};
  bars.forEach(function (b) { byNo[b.getAttribute('data-lock')] = b; });
  var note = document.getElementById('path-note');
  var noteDefault = note ? note.textContent : '';
  var clear = function () {
    bars.forEach(function (b) { b.classList.remove('is-excl', 'is-hovered'); });
    if (note) { note.textContent = noteDefault; }
  };
  var light = function (bar) {
    clear();
    bar.classList.add('is-hovered');
    var ex = (bar.getAttribute('data-excl') || '').split(',').filter(Boolean);
    ex.forEach(function (n) {
      var t = byNo[n.trim()];
      if (t) { t.classList.add('is-excl'); }
    });
    if (note) {
      note.textContent = '第 ' + bar.getAttribute('data-lock') + ' 枚锁闭条（'
        + bar.getAttribute('data-lever') + '）与 ' + ex.length + ' 枚锁互斥：'
        + ex.join(' 号、') + ' 号。切口 ' + bar.getAttribute('data-angle')
        + ' 度，与角度表第四列的水平进深一致。';
    }
  };
  bars.forEach(function (b) {
    if (b.tagName !== 'BUTTON') { b.setAttribute('tabindex', '0'); }
    b.addEventListener('mouseenter', function () { light(b); });
    b.addEventListener('focus', function () { light(b); });
    b.addEventListener('mouseleave', clear);
    b.addEventListener('blur', clear);
  });

  Array.prototype.forEach.call(document.querySelectorAll('.plate[data-flip]'), function (p) {
    var orig = p.textContent;
    var busy = false;
    var flip = function () {
      if (busy) { return; }
      busy = true;
      p.textContent = p.getAttribute('data-flip');
      p.classList.add('is-flipped');
      window.setTimeout(function () {
        p.textContent = orig;
        p.classList.remove('is-flipped');
        busy = false;
      }, 140);
    };
    p.addEventListener('click', flip);
    if (p.tagName !== 'BUTTON') {
      p.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); flip(); }
      });
    }
  });

  var grid = document.getElementById('board-grid');
  var emptyState = document.getElementById('empty-state');
  var slotInputs = Array.prototype.slice.call(document.querySelectorAll('input[name="slot"]'));
  var applySlot = function (v) {
    document.body.setAttribute('data-slot', v);
    Array.prototype.forEach.call(document.querySelectorAll('tr[data-slot]'), function (tr) {
      tr.hidden = tr.getAttribute('data-slot') !== v;
    });
    var isEmpty = (v === 'c');
    if (grid) { grid.hidden = isEmpty; }
    if (emptyState) { emptyState.hidden = !isEmpty; }
    Array.prototype.forEach.call(document.querySelectorAll('.ill-table tbody'), function (tb) {
      tb.classList.remove('is-cut');
      void tb.offsetWidth;
      tb.classList.add('is-cut');
      window.setTimeout(function () { tb.classList.remove('is-cut'); }, 140);
    });
  };
  slotInputs.forEach(function (s) {
    s.addEventListener('change', function () { applySlot(s.value); });
  });
  applySlot('a');

  var btn = document.getElementById('excl-btn');
  var list = document.getElementById('excl-list');
  if (btn && list) {
    var openLabel = btn.textContent;
    btn.addEventListener('click', function () {
      var open = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!open));
      list.hidden = open;
      btn.textContent = open ? openLabel : '收起 3 号锁的互斥清单（4 条）';
    });
  }

  if (rm.addEventListener) {
    rm.addEventListener('change', function (e) {
      if (e.matches && path) { path.classList.add('is-armed'); }
    });
  }
}());
</script>
</body>
