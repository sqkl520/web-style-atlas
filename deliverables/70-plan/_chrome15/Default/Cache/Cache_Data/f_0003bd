<!-- 自绘刮板光标：26px，刃口 2px，静态截图里停在撕痕起点 -->
<svg class="scraper" id="scraper" viewBox="0 0 28 28" aria-hidden="true"><use href="#g-scraper"/></svg>

<script>
(function () {
  var $ = function (id) { return document.getElementById(id); };
  var cut = $('cut');
  var reduce = matchMedia('(prefers-reduced-motion: reduce)');
  var WAVE = 2400, PUSH = 24, MIS = 9, sy = 0, raf = 0;
  /* 滚动：三角波把推挤量推到 24px，同时把错位量从 9px 收到 0 再放回 9px */
  function tick() {
    raf = 0;
    if (reduce.matches) return;   /* 减少动态：推挤量与错位量都不再由滚动改写，按本档原值定格 */
    var cy = window.scrollY;
    sy += (cy - sy) * 0.2;
    if (Math.abs(cy - sy) < 0.5) sy = cy;
    var t = (Math.abs(sy) % (WAVE * 2)) / WAVE, w = t <= 1 ? t : 2 - t;
    cut.style.setProperty('--push', (PUSH * w).toFixed(2) + 'px');
    cut.style.setProperty('--mis', (MIS * Math.abs(1 - 2 * w)).toFixed(2) + 'px');
    if (Math.abs(cy - sy) > 0.5) raf = requestAnimationFrame(tick);
  }
  function kick() { if (!raf) raf = requestAnimationFrame(tick); }
  window.addEventListener('scroll', kick, { passive: true });

  /* 微交互：点贴纸 -> 背胶残迹变浓 5%（100ms）并显出编号 */
  document.addEventListener('click', function (e) {
    var s = e.target.closest('.sticker');
    if (!s) return;
    var on = s.classList.contains('is-peeled');
    document.querySelectorAll('.is-peeled').forEach(function (o) { o.classList.remove('is-peeled'); });
    if (!on) s.classList.add('is-peeled');
  });

  /* 错误态的修正入口：按构建期顺序重排，编号与读数不动 */
  var btn = $('realign'), packet = $('packet');
  btn.addEventListener('click', function () {
    btn.disabled = true;
    btn.textContent = '撕痕已排进重排队列：离型纸底 120ms -> 逐张贴回 140ms / 间隔 40ms -> 重划撕痕 240ms';
    packet.textContent = '撕痕位图还在偏移 3px 的那一帧（错误码 GRIP-30）。36 张贴纸已经贴回原位，ST-12 那张要等撕痕重划完才落位；在那之前分数 84,200 与全部编号照旧可读。';
  });

  /* 刮板光标：只在精细指针下跟手（直接操作，不做自动动画） */
  var scraper = $('scraper');
  if (matchMedia('(pointer: fine)').matches) {
    window.addEventListener('pointermove', function (e) {
      scraper.classList.add('is-on');
      scraper.style.transform = 'translate(' + (e.clientX - 13) + 'px,' + (e.clientY - 22) + 'px)';
    }, { passive: true });
  }

  /* 入场：只动 transform 与 opacity，元素始终留在文档里 */
  var rise = document.querySelectorAll('[data-rise]');
  if ('IntersectionObserver' in window) {
    var io = new IntersectionObserver(function (list) {
      list.forEach(function (en) {
        if (!en.isIntersecting) return;
        en.target.classList.add('in');
        io.unobserve(en.target);
      });
    }, { rootMargin: '0px 0px -40px 0px' });
    rise.forEach(function (el) { io.observe(el); });
  } else {
    rise.forEach(function (el) { el.classList.add('in'); });
  }
  kick();
})();
</script>
</body>
