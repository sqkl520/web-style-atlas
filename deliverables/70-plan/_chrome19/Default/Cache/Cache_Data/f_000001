  i = POOL.indexOf(el); if (i < 0) return;
  el.classList.add('is-probed');
  PB.textContent = 'i = ' + i + ' ，声压级 ' + (94 - i * 2.4).toFixed(1) + 'dB';
});
WALK.addEventListener('pointerout', function (e) { if (e.target.classList) e.target.classList.remove('is-probed'); });
var HB = document.getElementById('hold'), HN = document.getElementById('hold-note');
function SN() { return cur ? cur.f + 'Hz ／ 振幅 ' + cur.a.toFixed(2) + ' ／ 间距 ' + cur.s + 'px ／ ' + Math.min(cur.segs, CAP) + ' 段' : '当前参数'; }
HB.addEventListener('click', function () {
  held = Date.now() + 3000; GO(1); HB.disabled = true;
  HN.textContent = '已锁定 3 秒：滚动不改参数，图纸停在 ' + SN() + '。';
  setTimeout(function () { HB.disabled = false; HN.textContent = '3 秒到了，滚动重新接管：接着滚，频率档位接着走。'; GO(1); }, 3000);
});
var FX = document.getElementById('fix'), AF = document.getElementById('fault-after');
FX.addEventListener('click', function () {
  MAN.s = 1.2; document.getElementById('in-s').value = 1; GO(1); FX.disabled = true;
  AF.textContent = '走线间距已写死 1.2px：圈数回到 ' + cur.C + ' 圈，请求 ' + cur.segs + ' 段，落回 4000 段上限内，PLOT-4000 解除。频率与振幅两档仍由滚动驱动，间距这一档等按「交给滚动」再还回去。';
});
[['in-f', 'f', function (v) { return +v; }, 'out-f', function (v) { return v + 'Hz'; }],
 ['in-a', 'a', function (v) { return +v / 100; }, 'out-a', function (v) { return (+v / 100).toFixed(2); }],
 ['in-s', 's', function (v) { return SP[+v]; }, 'out-s', function (v) { return SP[+v] + 'px'; }]
].forEach(function (c) {
  var el = document.getElementById(c[0]);
  el.addEventListener('input', function () {
    MAN[c[1]] = c[2](el.value);
    document.getElementById(c[3]).textContent = c[4](el.value);
    GO(1);
  });
});
document.getElementById('release').addEventListener('click', function () {
  MAN = {}; FX.disabled = false;
  AF.textContent = '三个参数都还给了滚动：继续滚，频率每 100px 走一格、振幅每 3 格走一档、走线间距每 6 格换一档。';
  GO(1);
});
var DP = document.getElementById('drop');
['dragenter', 'dragover', 'dragleave', 'drop'].forEach(function (t) {
  DP.addEventListener(t, function (e) { e.preventDefault(); });
});
DP.addEventListener('drop', function () {
  DP.querySelector('.drop__line').textContent = '已登记 SAMPLE-D：20.0 秒。原型不解析音频内容，按 240ms 的擦除转场重绘一次。';
  CV.classList.add('is-erasing');
  setTimeout(function () { CV.classList.remove('is-erasing'); GO(1); }, 240);
});
GO(0);
})();
</script>
</body>
</html>
