<script>
(function () {
  var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  var status = document.getElementById('spec-status');
  var say = function (t) { if (status) status.textContent = t; };
  var rows = [].slice.call(document.querySelectorAll('.spec tbody tr'));
  rows.forEach(function (tr, i) { tr.style.setProperty('--i', String(i)); });
  /* 规格表落进视口 15% 时逐行落下，每行 60ms，阶跃步进，不做淡入 */
  function land() {
    if (land.ok) return;
    land.ok = 1;
    rows.forEach(function (tr) { tr.classList.add('landing'); });
    say('表内 6 行已随视口逐行落位，每行间隔 60ms。');
  }
  var spec = document.querySelector('.spec');
  if (spec && !reduce && 'IntersectionObserver' in window) {
    var io = new IntersectionObserver(function (es) {
      es.forEach(function (e) { if (e.isIntersecting) { land(); io.disconnect(); } });
    }, { threshold: 0.15 });
    io.observe(spec);
  } else { land(); }

  function rise(el) { el.classList.add('enter'); }
  var parts = [].slice.call(document.querySelectorAll('.chapter-head, .prose, .aside, .plate'));
  if (!reduce && 'IntersectionObserver' in window) {
    var io2 = new IntersectionObserver(function (es) {
      es.forEach(function (e) { if (e.isIntersecting) { rise(e.target); io2.unobserve(e.target); } });
    }, { rootMargin: '0px 0px -8% 0px' });
    parts.forEach(function (el) { io2.observe(el); });
  } else { parts.forEach(rise); }

  function cut(el) {
    el.classList.remove('is-cut');
    void el.offsetWidth;
    el.classList.add('is-cut');
    setTimeout(function () { el.classList.remove('is-cut'); }, 200);
  }
  [].forEach.call(document.querySelectorAll('.chapter-strip a'), function (a) {
    a.addEventListener('click', function () {
      var t = document.querySelector(a.getAttribute('href'));
      if (t) cut(t);
    });
  });

  document.getElementById('go-42').addEventListener('click', function () {
    var s = document.getElementById('ch-04-2');
    cut(document.getElementById('ch-04'));
    s.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'center' });
    s.setAttribute('tabindex', '-1');
    s.focus({ preventScroll: true });
    say('已翻到 4.2 节：色带更换。');
  });

  var al = document.getElementById('scan-alert');
  function press() {
    al.classList.add('is-pressed');
    setTimeout(function () { al.classList.remove('is-pressed'); }, 120);
  }
  al.addEventListener('click', function (e) { if (!e.target.closest('button')) press(); });
  al.addEventListener('keydown', function (e) {
    if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); press(); }
  });

  /* 复核第 4 联：损坏态本身是静态可见的一块；复核后转为「复核通过但仍退回第 3 联」 */
  var rs = document.getElementById('rescan');
  var st = document.getElementById('alert-state');
  var ok = false, busy = false;
  rs.addEventListener('click', function () {
    if (busy) return;
    busy = true;
    rs.setAttribute('aria-busy', 'true');
    rs.textContent = '正在核对损坏件 113…';
    setTimeout(function () {
      busy = false;
      rs.removeAttribute('aria-busy');
      ok = !ok;
      al.classList.toggle('is-recovered', ok);
      st.textContent = ok ? '当前状态：复核通过，第 4 联仍不可用，引用继续走第 3 联。' : '当前状态：已退回第 3 联，引用可用但须标注联次。';
      rs.textContent = ok ? '重新核对损坏件 113' : '复核第 4 联扫描件';
      say(ok ? '损坏件 113 复核完成：丢行 5 处，第 4 联维持退回状态。' : '已恢复损坏件 113 的退回状态。');
    }, reduce ? 60 : 900);
  });
})();
</script>
