e);\n  box-shadow: inset 0 1px 0 var(--paper), inset 0 -1px 0 var(--ink);\n  transition: height 300ms cubic-bezier(.34,1.2,.64,1), box-shadow 300ms cubic-bezier(.34,1.2,.64,1);\n}\n.fold-line::before, .fold-line::after {\n  content: \"\";\n  position: absolute;\n  top: -1px;\n  width: 4px;\n  height: 5px;\n  background: var(--ink);\n}\n.fold-line::before { left: 0; transform: rotate(-12deg); }\n.fold-line::after { right: 0; transform: rotate(12deg); }\n.fold-line.deep { height: 6px; box-shadow: inset 0 2px 0 var(--paper), inset 0 -2px 0 var(--ink); }\n.hero {\n  position: relative;\n  display: grid;\n  grid-template-columns: repeat(6, minmax(0, 1fr));\n  column-gap: var(--gutter);\n  min-height: 570px;\n  padding-top: 44px;\n  padding-bottom: 44px;\n}\n.hero::after {\n  content: \"\";\n  position: absolute;\n  left: calc(50% - var(--fold) / 2);\n  top: 0;\n  bottom: 0;\n  width: var(--fold);\n  background: var(--paper);\n  box-shadow: inset 1px 0 0 var(--crease), inset -1px 0 0 var(--crease);\n  pointer-events: none;\n}\n.hero-copy { grid-column: 1 / span 2; align-self: start; }\n.kicker { margin: 0 0 20px; color: var(--matcha); font-size: 14px; letter-spacing: .12em; }\nh1, h2, h3 { font-family: Petrona, \"Zhuque Fangsong\", Georgia, serif; font-weight: 600; }\nh1 { margin: 0; font-size: clamp(54px, 6.6vw, 81px); line-height: .98; letter-spacing: -.045em; }\n.hero-intro { max-width: 360px; margin: 30px 0 0; }\n.call {\n  display: inline-flex;\n  align-items: center;\n  gap: 14px;\n  margin-top: 30px;\n  padding: 9px 0 8px;\n  border-top: 3px solid var(--matcha);\n  border-bottom: 1px solid var(--matcha);\n  color: var(--matcha);\n  font-size: 18px;\n}\n.call::after { content: \"↗\"; font-family: \"IBM Plex Mono\", monospace; }\n.hero-aside { grid-column: 5 / span 2; align-self: end; padding-bottom: 18px; }\n.hero-aside p { margin: 0; max-width: 260px; }\n.hero-aside strong { display: block; color: var(--matcha); font-size: 26px; font-family: \"IBM Plex Mono\", monospace; font-weight: 500; }\n.ghost {\n  position: absolute;\n  z-index: 0;\n  top: 175px;\n  right: 10%;\n  font-family: Petrona, \"Zhuque Fangsong\", Georgia, serif;\n  font-size: 62px;\n  color: var(--matcha);\n  opacity: .18;\n  transform: rotateY(180deg);\n  pointer-events: none;\n}\n.content {\n  position: relative;\n  display: grid;\n  grid-template-columns: repeat(6, minmax(0, 1fr));\n  gap: var(--section-gap) var(--gutter);\n  padding-top: var(--section-gap);\n}\n.content::before {\n  content: \"\";\n  position: absolute;\n  top: 0;\n  left: calc(50% - var(--fold) / 2);\n  width: var(--fold);\n  height: 100%;\n  background: var(--paper);\n  box-shadow: inset 1px 0 0 var(--crease), inset -1px 0 0 var(--crease);\n  pointer-events: none;\n}\n.entry { position: relative; min-width: 0; }\n.entry:nth-child(1) { grid-column: 1 / span 2; }\n.entry:nth-child(2) { grid-column: 3 / span 2; margin-top: 30px; }\n.entry:nth-child(3) { grid-column: 5 / span 2; }\n.entry:nth-child(4) { grid-column: 1 / span 3; }\n.entry:nth-child(5) { grid-column: 4 / span 2; margin-top: 42px; }\n.entry:nth-child(6) { grid-column: 6; min-height: 240px; display: flex; align-items: end; }\n.entry figure { margin: 0 0 var(--paragraph-gap); border-bottom: 3px solid var(--matcha); }\n.entry img { display: block; width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; filter: sepia(.12) saturate(.45); }\n.entry:nth-child(2) img { aspect-ratio: 3 / 4; }\n.entry:nth-child(3) img { aspect-ratio: 1 / 1; }\n.entry:nth-child(4) img { aspect-ratio: 16 / 9; }\n.entry:nth-child(5) img { aspect-ratio: 4 / 5; }\n.entry-meta { display: flex; justify-content: space-between; align-items: baseline; color: var(--crease); font-family: \"IBM Plex Mono\", monospace; font-size: 13px; }\n.entry h2 { margin: 0 0 12px; font-size: 31px; line-height: 1.08; }\n.entry p { margin: 0; }\n.entry-number { color: var(--matcha); font-family: \"IBM Plex Mono\", monospace; font-variant-numeric: tabular-nums; font-size: 15px; }\n.blank-note { border-top: 1px solid var(--crease); padding-top: 14px; color: var(--matcha); }\n.blank-note p { font-size: 15px; }\n.footer {\n  display: grid;\n  grid-template-columns: 2fr 1fr 1fr;\n  gap: var(--gutter);\n  margin-top: var(--section-gap);\n  padding-top: 24px;\n  border-top: 3px solid var(--crease);\n}\n.footer p { margin: 0; }\n.footer a { color: var(--matcha); border-bottom: 1px solid var(--matcha); }\n.page-anchor { justify-self: end; color: var(--matcha); font-family: \"IBM Plex Mono\", monospace; font-variant-numeric: tabular-nums; }\n.anchor-dot { display: inline-block; width: 6px; height: 6px; margin-right: 8px; background: var(--ink); }\n.reveal { opacity: 0; animation: reveal 240ms ease-out forwards; }\n.reveal.lower { animation-delay: 240ms; }\n@keyframes reveal { from { opacity: .12; } to { opacity: 1; } }\n.entry:hover figure { opacity: .84; transition: opacity 160ms ease; }\n@media (max-width: 800px) {\n  :root { --outer: 24px; --fold: 52px; --section-gap: 64px; }\n  .nav { min-height: 64px; }\n  .nav-note { display: none; }\n  .hero { display: block; min-height: auto; padding: 48px 0 76px; }\n  .hero::after, .content::before { display: none; }\n  .hero-aside { margin-top: 64px; padding: 0; }\n  .ghost { top: 245px; right: 4%; font-size: 40px; }\n  .fold-line { left: var(--outer); right: var(--outer); top: 50.4%; }\n  .content { display: block; padding-top: var(--section-gap); }\n  .entry, .entry:nth-child(2), .entry:nth-child(5), .entry:nth-child(6) { margin: 0 0 var(--section-gap); }\n  .entry:nth-child(6) { min-height: 160px; }\n  .footer { display: block; }\n  .footer > * { margin-bottom: 18px; }\n  .page-anchor { text-align: left; }\n}\n@media (prefers-reduced-motion: reduce) {\n  html { scroll-behavior: auto; }\n  *, *::before, *::after { animation-duration: 120ms !important; transition-duration: 120ms !important; }\n  .fold-line { height: 3px; }\n}\n</style>\n</head>\n<body>\n<main class=\"page\">\n  <div class=\"sheet\">\n    <nav class=\"nav\" aria-label=\"主导航\">\n      <div class=\"brand\">老程 · 修鞋配钥匙</div>\n      <div class=\"nav-note\">一针一线，把日子接起来</div>\n    </nav>\n    <div class=\"fold-line\" aria-hidden=\"true\"></div>\n    <section class=\"hero\" aria-labelledby=\"page-title\">\n      <div class=\"ghost\" aria-hidden=\"true\">再用一次</div>\n      <div class=\"hero-copy reveal\">\n        <p class=\"kicker\">街角小铺 / 1998—今日</p>\n        <h1 id=\"page-title\">东西坏了，<br>先别急着扔。</h1>\n        <p class=\"hero-intro\">鞋跟松了，钥匙旧了，拉链不肯往前走。拿来给我看看，能修的，我都尽量让它再陪你久一点。</p>\n        <a class=\"call\" href=\"tel:13800001234\">打电话，约个时间</a>\n      </div>\n      <div class=\"hero-aside reveal lower\">\n        <strong>138 0000 1234</strong>\n        <p>周一至周六<br>08:30—18:30<br>中午也在，门口有一盏小灯。</p>\n      </div>\n    </section>\n    <section class=\"content\" aria-label=\"小店能做的事\">\n      <article class=\"entry reveal\">\n        <figure><img src=\"images/占位-1.jpg\" width=\"800\" height=\"600\" alt=\"一双正在修补的旧皮鞋\"></figure>\n        <div class=\"entry-meta\"><span class=\"entry-number\">01</span><span>鞋面与鞋底</span></div>\n        <h2>鞋，先把脚托稳。</h2>\n        <p>鞋底磨偏、鞋跟摇晃，或者只是穿久了有点不顺脚。我会照着你的走路习惯看，不急着换新的。</p>\n      </article>\n      <article class=\"entry reveal lower\">\n        <figure><img src=\"images/占位-2.jpg\" width=\"600\" height=\"800\" alt=\"手里整理好的几把钥匙\"></figure>\n        <div class=\"entry-meta\"><span class=\"entry-number\">02</span><span>配钥匙</span></div>\n        <h2>钥匙，配一把顺手的。</h2>\n        <p>家门、信箱、老抽屉，都可以拿来试试。配好先当场转两圈，免得你回家才发现卡住。</p>\n      </article>\n      <article class=\"entry reveal\">\n        <figure><img src=\"images/占位-3.jpg\" width=\"700\" height=\"700\" alt=\"桌上放着针线和皮料\"></figure>\n        <div class=\"entry-meta\"><span class=\"entry-number\">03</span><span>小件修补</span></div>\n        <h2>小毛病，也值得修。</h2>\n        <p>包带断了、扣子掉了、拉链咬住了。东西陪你过了几年，修好它，比重新认识一个新的更踏实。</p>\n      </article>\n      <article class=\"entry reveal lower\">\n        <figure><img src=\"images/占位-4.jpg\" width=\"960\" height=\"540\" alt=\"修鞋台上的木槌与皮革\"></figure>\n        <div class=\"entry-meta\"><span class=\"entry-number\">04</span><span>手工护理</span></div>\n        <h2>旧皮子，要慢慢养。</h2>\n        <p>皮鞋不是越亮越好。先把灰擦干净，再上一点油，让它保留原来的纹路。你常穿的东西，我不舍得把它做得不像它。</p>\n      </article>\n      <article class=\"entry reveal\">\n        <figure><img src=\"images/占位-5.jpg\" width=\"640\" height=\"800\" alt=\"店里靠窗的一张修理工作台\"></figure>\n        <div class=\"entry-meta\"><span class=\"entry-number\">05</span><span>取件与叮嘱</span></div>\n        <h2>取的时候，我讲清楚。</h2>\n        <p>哪里动过，怎么用能耐久，我都会说一遍。你不用懂修理，只要知道它接下来该怎么陪你。</p>\n      </article>\n      <article class=\"entry reveal lower\">\n        <div class=\"blank-note\">\n          <div class=\"entry-meta\"><span class=\"entry-number\">06</span><span>留给下一双</span></div>\n          <p>这一格不放新故事。小店的第六个位置，留给你下次带来的那件旧东西。</p>\n        </div>\n      </article>\n    </section>\n    <footer class=\"footer\">\n      <p>街角见。进门不用客气，先把东西放在台上。</p>\n      <p><a href=\"tel:13800001234\">138 0000 1234</a><br>城南菜市场旁，蓝色门框</p>\n      <p class=\"page-anchor\"><span class=\"anchor-dot\"></span>05 / 06</p>\n    </footer>\n  </div>\n</main>\n<script>\n(function () {\n  var crease = document.querySelector('.fold-line');\n  if (!crease || !('IntersectionObserver' in window)) return;\n  var observer = new IntersectionObserver(function (entries) {\n    entries.forEach(function (entry) {\n      if (entry.isIntersecting && entry.intersectionRatio >= 0.5) crease.classList.add('deep');\n    });\n  }, { threshold: [0.5] });\n  observer.observe(crease);\n})();\n</script>\n</body>\n</html>\n"
        }
      }
    }
  },
