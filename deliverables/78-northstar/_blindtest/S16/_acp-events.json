px, 78vw); position: relative; z-index: 3; }\n.kicker { color: var(--red); font-family: \"Fragment Mono\", monospace; font-size: 14px; letter-spacing: .08em; line-height: 1.1; }\nh1 {\n  margin: 16px 0 20px;\n  font-family: \"LXGW Marker Gothic\", \"Noto Serif SC\", serif;\n  font-size: clamp(62px, 8.6vw, 88px);\n  font-weight: 400;\n  line-height: .95;\n  letter-spacing: .02em;\n  max-width: 700px;\n}\n.lede { font-size: 20px; line-height: 1.35; max-width: 350px; }\n.cta {\n  display: inline-flex; align-items: center; gap: 15px;\n  margin-top: 25px; padding: 16px 19px 14px;\n  color: var(--paper); background: var(--red); border: var(--line) solid var(--red);\n  box-shadow: 7px 7px 0 var(--pressed);\n  line-height: 1; cursor: pointer;\n  transition: box-shadow 180ms steps(2), transform 180ms steps(2);\n}\n.cta:hover { box-shadow: 10px 10px 0 var(--pressed); transform: translate(-3px, -3px); }\n.cta .mono { font-size: 14px; }\n.slant-rail {\n  position: absolute; left: 31%; top: 28px; width: 66%;\n  transform: skewY(-12deg); transform-origin: left top;\n  display: flex; flex-direction: column; gap: 22px;\n}\n.word-block {\n  position: relative; min-height: 74px; display: flex; align-items: center;\n  border: var(--line) solid var(--ink); background: var(--paper);\n  filter: drop-shadow(8px 8px 0 var(--pressed));\n  transition: filter 180ms steps(2);\n  cursor: pointer;\n}\n.word-block::after {\n  content: \"\"; position: absolute; left: 25%; bottom: -9px; width: 2px; height: 2px;\n  background: var(--ink); transform: translateX(var(--dot-shift));\n}\n.word-block:hover { filter: drop-shadow(11px 11px 0 var(--pressed)); }\n.word-block:hover .speed-lines, .word-block.is-scrolling .speed-lines { display: block; }\n.block-content { width: 100%; padding: 13px 18px 11px; transform: skewY(12deg); display: flex; align-items: baseline; justify-content: space-between; gap: 14px; }\n.block-word { font-family: \"LXGW Marker Gothic\", \"Noto Serif SC\", serif; font-size: clamp(27px, 4vw, 48px); line-height: .95; white-space: nowrap; }\n.block-note { font-size: 15px; line-height: 1.15; color: var(--ink-2); text-align: right; max-width: 180px; }\n.block-number { position: absolute; left: -14px; top: -13px; padding: 3px 6px 2px; background: var(--red); color: var(--paper); font-size: 13px; line-height: 1; transform: skewY(12deg); z-index: 2; }\n.speed-lines { display: none; position: absolute; left: -26px; top: 50%; width: 18px; height: 3px; background: var(--red); box-shadow: 0 -8px 0 var(--red), 0 8px 0 var(--red); }\n.w4 { width: 46%; } .w6 { width: 62%; } .w7 { width: 72%; } .w9 { width: 90%; }\n.w4 .block-content { padding-right: 12px; } .w9 { align-self: flex-end; }\n.track { position: absolute; left: 31%; right: 0; bottom: 13px; border-bottom: 2px solid var(--ink); transform: rotate(-12deg); transform-origin: left; }\n.track-label { position: absolute; right: 0; bottom: 12px; font: 12px/1 \"Fragment Mono\", monospace; transform: rotate(-12deg); }\n.pointer { position: absolute; left: 43%; bottom: -7px; width: 13px; height: 13px; background: var(--red); transition: left 140ms steps(1); }\n.section-rule { display: flex; align-items: center; gap: 18px; border-top: 6px solid var(--ink); padding-top: 13px; margin-top: 6px; }\n.section-rule h2 { margin: 0; font-family: \"LXGW Marker Gothic\", \"Noto Serif SC\", serif; font-size: 38px; font-weight: 400; }\n.section-rule p { margin: 0; font-size: 15px; color: var(--ink-2); line-height: 1.15; }\n.cards { display: grid; grid-template-columns: 1.15fr .8fr 1fr; gap: 22px; margin-top: 22px; align-items: stretch; }\n.card { border: var(--line) solid var(--ink); background: var(--paper); position: relative; filter: drop-shadow(6px 6px 0 var(--pressed)); }\n.card-image { display: block; width: 100%; height: 166px; object-fit: cover; border-bottom: var(--line) solid var(--ink); background: var(--ink-2); }\n.card:nth-child(2) .card-image { height: 202px; }\n.card-body { padding: 15px 16px 17px; line-height: 1.15; }\n.card-title { margin: 0 0 10px; font-family: \"LXGW Marker Gothic\", \"Noto Serif SC\", serif; font-size: 28px; line-height: .95; }\n.card p { margin: 0; font-size: 16px; }\n.card-price { margin-top: 16px; display: block; text-align: right; font: 18px/1 \"Fragment Mono\", monospace; }\nfooter { display: flex; justify-content: space-between; gap: 20px; border-top: var(--line) solid var(--ink); margin-top: 30px; padding-top: 12px; font-size: 14px; line-height: 1.2; }\nfooter strong { color: var(--red); font-family: \"LXGW Marker Gothic\", \"Noto Serif SC\", serif; font-size: 23px; font-weight: 400; }\n@keyframes press { 0% { transform: translate(-12px, 12px); } 70% { transform: translate(3px, -3px); } 100% { transform: translate(0, 0); } }\n.word-block { animation: press 330ms steps(3, end) both; animation-delay: calc(var(--i) * 110ms); }\n@media (prefers-reduced-motion: reduce) {\n  *, *::before, *::after { animation-duration: 1ms !important; animation-iteration-count: 1 !important; transition-duration: 1ms !important; }\n  .speed-lines { display: none !important; }\n  .slant-rail { transform: skewY(-12deg) translateY(calc(var(--scroll-y, 0px) * .5)); }\n}\n@media (max-width: 760px) {\n  body { cursor: auto; }\n  body::before, body::after { display: none; }\n  .page { padding: 18px 16px 32px; }\n  .topbar { align-items: flex-start; }\n  .hero { min-height: 0; padding-bottom: 31px; }\n  .hero-intro { width: 100%; }\n  h1 { font-size: clamp(57px, 17vw, 78px); max-width: 600px; }\n  .slant-rail { position: relative; left: 6%; top: auto; width: 94%; margin-top: 55px; gap: 18px; }\n  .word-block, .w4, .w6, .w7, .w9 { width: 100%; }\n  .block-note { max-width: 44%; }\n  .track { position: relative; left: 7%; width: 93%; bottom: auto; margin-top: 38px; }\n  .track-label { bottom: -20px; }\n  .pointer { bottom: -7px; }\n  .cards { grid-template-columns: 1fr; gap: 19px; }\n  .card-image, .card:nth-child(2) .card-image { height: 190px; }\n  footer { flex-direction: column; }\n}\n</style>\n</head>\n<body>\n<main class=\"page\">\n  <header class=\"topbar\">\n    <div class=\"masthead\">北星修补站 / NORTHSTAR</div>\n    <div class=\"meta\">街角 07:30—19:30<br>不接急单，只接好活</div>\n  </header>\n\n  <section class=\"hero\" aria-labelledby=\"main-title\">\n    <div class=\"hero-intro\">\n      <div class=\"kicker\">鞋底在喊 / 钥匙在响 / 现在就来</div>\n      <h1 id=\"main-title\">鞋坏了？<br>钥匙呢？</h1>\n      <p class=\"lede\">别把今天交给坏鞋底。把鞋、锁、还有那点不服输，统统带到街角来。</p>\n      <a class=\"cta\" href=\"tel:010-5800-7716\"><span class=\"mono\">CALL 01</span><span>打电话，约个时间 →</span></a>\n    </div>\n\n    <div class=\"slant-rail\" aria-label=\"服务项目\">\n      <div class=\"word-block w9\" style=\"--i:0;--dot-shift:0px\" data-index=\"01\">\n        <span class=\"block-number mono\">01</span><span class=\"speed-lines\"></span><div class=\"block-content\"><span class=\"block-word\">补鞋底</span><span class=\"block-note\">旧鞋不退场<br>再跑一轮</span></div>\n      </div>\n      <div class=\"word-block w6\" style=\"--i:1;--dot-shift:1px\" data-index=\"02\">\n        <span class=\"block-number mono\">02</span><span class=\"speed-lines\"></span><div class=\"block-content\"><span class=\"block-word\">配钥匙</span><span class=\"block-note\">一拧就开<br>不和门较劲</span></div>\n      </div>\n      <div class=\"word-block w7\" style=\"--i:2;--dot-shift:2px\" data-index=\"03\">\n        <span class=\"block-number mono\">03</span><span class=\"speed-lines\"></span><div class=\"block-content\"><span class=\"block-word\">换鞋跟</span><span class=\"block-note\">站稳了<br>气势才出来</span></div>\n      </div>\n      <div class=\"word-block w4\" style=\"--i:3;--dot-shift:3px\" data-index=\"04\">\n        <span class=\"block-number mono\">04</span><span class=\"speed-lines\"></span><div class=\"block-content\"><span class=\"block-word\">修拉链</span><span class=\"block-note\">卡住的<br>给它一条路</span></div>\n      </div>\n      <div class=\"word-block w9\" style=\"--i:4;--dot-shift:4px\" data-index=\"05\">\n        <span class=\"block-number mono\">05</span><span class=\"speed-lines\"></span><div class=\"block-content\"><span class=\"block-word\">刻门牌</span><span class=\"block-note\">你的门<br>要有自己的字</span></div>\n      </div>\n    </div>\n    <div class=\"track\" aria-hidden=\"true\"><span class=\"pointer\"></span></div><div class=\"track-label\">TRACK / 01—05</div>\n  </section>\n\n  <section aria-labelledby=\"visit-title\">\n    <div class=\"section-rule\"><h2 id=\"visit-title\">带上它，来。</h2><p>五个动作，都是街坊每天会用到的硬招。</p></div>\n    <div class=\"cards\">\n      <article class=\"card\">\n        <img class=\"card-image\" src=\"images/占位-1.jpg\" width=\"720\" height=\"400\" alt=\"磨旧的皮鞋和修鞋工具\">\n        <div class=\"card-body\"><h3 class=\"card-title\">鞋底重做</h3><p>走路打滑、鞋底开口，别等它在雨里散架。先打电话，留一段时间给师傅。</p><span class=\"card-price\">FROM 68</span></div>\n      </article>\n      <article class=\"card\">\n        <img class=\"card-image\" src=\"images/占位-2.jpg\" width=\"520\" height=\"500\" alt=\"一串不同形状的钥匙\">\n        <div class=\"card-body\"><h3 class=\"card-title\">钥匙复制</h3><p>家门、信箱、车库。带原钥匙来，现场试到顺手为止。</p><span class=\"card-price\">FROM 12</span></div>\n      </article>\n      <article class=\"card\">\n        <img class=\"card-image\" src=\"images/占位-3.jpg\" width=\"640\" height=\"400\" alt=\"鞋跟和金属修补件\">\n        <div class=\"card-body\"><h3 class=\"card-title\">鞋跟换新</h3><p>高跟、皮靴、工作鞋，站不稳的那一下，我们把它按回地面。</p><span class=\"card-price\">FROM 35</span></div>\n      </article>\n    </div>\n  </section>\n\n  <footer>\n    <div><strong>北星修补站</strong><br>北京市东城区北新桥街 16 号 · 010-5800-7716</div>\n    <div class=\"mono\">CALL INDEX / 01—05<br>先约时间，再来敲门。</div>\n  </footer>\n</main>\n<script>\n(function () {\n  const root = document.documentElement;\n  const rail = document.querySelector('.slant-rail');\n  const pointer = document.querySelector('.pointer');\n  const blocks = document.querySelectorAll('.word-block');\n  let ticking = false;\n  function moveRail() {\n    const y = window.scrollY || 0;\n    root.style.setProperty('--scroll-y', y + 'px');\n    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {\n      rail.style.transform = 'skewY(-12deg) translateY(' + (y * y / 9000) + 'px)';\n      blocks.forEach(function (block) { block.classList.toggle('is-scrolling', y > 4); });\n    }\n    pointer.style.left = (43 + Math.min(46, y / 10)) + '%';\n    ticking = false;\n  }\n  window.addEventListener('scroll', function () {\n    if (!ticking) { window.requestAnimationFrame(moveRail); ticking = true; }\n  }, { passive: true });\n  blocks.forEach(function (block, i) {\n    block.addEventListener('click', function () {\n      block.animate([{ transform: 'translate(-12px, 12px)' }, { transform: 'translate(0, 0)' }], { duration: 240, easing: 'steps(2, end)' });\n      pointer.style.left = (12 + i * 18) + '%';\n    });\n  });\n  document.addEventListener('mousemove', function (event) {\n    root.style.setProperty('--mx', event.clientX + 'px');\n    root.style.setProperty('--my', event.clientY + 'px');\n  });\n}());\n</script>\n</body>\n</html>\n"
        }
