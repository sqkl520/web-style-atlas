          "text": " <!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>街角修鞋配钥匙｜Northstar</title>\n<style>\n:root {\n  --red: #C52C0F;\n  --paper: #F7EBCF;\n  --ink: #1A1A1A;\n  --pressed: #8E2A18;\n  --ink-2: #5C5C55;\n  --line: 3px;\n}\n@font-face {\n  font-family: \"LXGW Marker Gothic\";\n  src: local(\"LXGW Marker Gothic\");\n}\n@font-face {\n  font-family: \"Noto Serif SC\";\n  src: local(\"Noto Serif SC\");\n}\n@font-face {\n  font-family: \"Fragment Mono\";\n  src: local(\"Fragment Mono\");\n}\n* {\n  box-sizing: border-box;\n}\nhtml {\n  background: var(--paper);\n}\nbody {\n  margin: 0;\n  color: var(--ink);\n  background: var(--paper);\n  font-family: \"Noto Serif SC\", Georgia, \"Songti SC\", serif;\n  font-size: 20px;\n  line-height: .95;\n  overflow-x: hidden;\n  cursor: none;\n}\nbody::before,\nbody::after {\n  content: \"\";\n  position: fixed;\n  z-index: 20;\n  pointer-events: none;\n  background: var(--ink);\n}\nbody::before {\n  width: 2px;\n  height: 18px;\n  left: var(--mx, -10px);\n  top: calc(var(--my, -10px) - 9px);\n  transform: rotate(12deg);\n}\nbody::after {\n  width: 18px;\n  height: 2px;\n  left: calc(var(--mx, -10px) - 8px);\n  top: var(--my, -10px);\n  transform: rotate(12deg);\n}\na {\n  color: inherit;\n  text-decoration: none;\n}\nbutton {\n  font: inherit;\n}\n.page {\n  min-height: 100vh;\n  padding: 28px 5vw 44px;\n  position: relative;\n}\n.topbar {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  border-bottom: var(--line) solid var(--ink);\n  padding-bottom: 14px;\n  line-height: 1.1;\n}\n.masthead {\n  font-family: \"LXGW Marker Gothic\", \"Noto Serif SC\", serif;\n  font-size: 27px;\n  letter-spacing: .02em;\n}\n.meta,\n.mono {\n  font-family: \"Fragment Mono\", monospace;\n  font-variant-numeric: tabular-nums;\n}\n.meta {\n  font-size: 13px;\n  text-align: right;\n  line-height: 1.15;\n}\n.hero {\n  position: relative;\n  padding: 28px 0 24px;\n  min-height: 650px;\n}\n.hero-intro {\n  width: min(410px, 78vw);\n  position: relative;\n  z-index: 3;\n}\n.kicker {\n  color: var(--red);\n  font-family: \"Fragment Mono\", monospace;\n  font-size: 14px;\n  letter-spacing: .08em;\n  line-height: 1.1;\n}\nh1 {\n  margin: 16px 0 20px;\n  font-family: \"LXGW Marker Gothic\", \"Noto Serif SC\", serif;\n  font-size: clamp(62px, 8.6vw, 88px);\n  font-weight: 400;\n  line-height: .95;\n  letter-spacing: .02em;\n  max-width: 700px;\n}\n.lede {\n  font-size: 20px;\n  line-height: 1.35;\n  max-width: 350px;\n}\n.cta {\n  display: inline-flex;\n  align-items: center;\n  gap: 15px;\n  margin-top: 25px;\n  padding: 16px 19px 14px;\n  color: var(--paper);\n  background: var(--red);\n  border: var(--line) solid var(--red);\n  box-shadow: 7px 7px 0 var(--pressed);\n  line-height: 1;\n  cursor: pointer;\n  transition: box-shadow 180ms steps(2), transform 180ms steps(2);\n}\n.cta:hover {\n  box-shadow: 10px 10px 0 var(--pressed);\n  transform: translate(-3px, -3px);\n}\n.cta .mono {\n  font-size: 14px;\n}\n.slant-rail {\n  position: absolute;\n  left: 31%;\n  top: 28px;\n  width: 66%;\n  transform: skewY(-12deg);\n  transform-origin: left top;\n  display: flex;\n  flex-direction: column;\n  gap: 22px;\n}\n.word-block {\n  position: relative;\n  min-height: 74px;\n  display: flex;\n  align-items: center;\n  border: var(--line) solid var(--ink);\n  background: var(--paper);\n  filter: drop-shadow(8px 8px 0 var(--pressed));\n  transition: filter 180ms steps(2);\n  cursor: pointer;\n}\n.word-block::after {\n  content: \"\";\n  position: absolute;\n  left: 25%;\n  bottom: -9px;\n  width: 2px;\n  height: 2px;\n  background: var(--ink);\n  transform: translateX(var(--dot-shift));\n}\n.word-block:hover {\n  filter: drop-shadow(11px 11px 0 var(--pressed));\n}\n.word-block:hover .speed-lines,\n.word-block.is-scrolling .speed-lines {\n  display: block;\n}\n.block-content {\n  width: 100%;\n  padding: 13px 18px 11px;\n  transform: skewY(12deg);\n  display: flex;\n  align-items: baseline;\n  justify-content: space-between;\n  gap: 14px;\n}\n.block-word {\n  font-family: \"LXGW Marker Gothic\", \"Noto Serif SC\", serif;\n  font-size: clamp(27px, 4vw, 48px);\n  line-height: .95;\n  white-space: nowrap;\n}\n.block-note {\n  font-size: 15px;\n  line-height: 1.15;\n  color: var(--ink-2);\n  text-align: right;\n  max-width: 180px;\n}\n.block-number {\n  position: absolute;\n  left: -14px;\n  top: -13px;\n  padding: 3px 6px 2px;\n  background: var(--red);\n  color: var(--paper);\n  font-size: 13px;\n  line-height: 1;\n  transform: skewY(12deg);\n  z-index: 2;\n}\n.speed-lines {\n  display: none;\n  position: absolute;\n  left: -26px;\n  top: 50%;\n  width: 18px;\n  height: 3px;\n  background: var(--red);\n  box-shadow: 0 -8px 0 var(--red), 0 8px 0 var(--red);\n}\n.w4 {\n  width: 46%;\n}\n.w6 {\n  width: 62%;\n}\n.w7 {\n  width: 72%;\n}\n.w9 {\n  width: 90%;\n}\n.w4 .block-content {\n  padding-right: 12px;\n}\n.w9 {\n  align-self: flex-end;\n}\n.track {\n  position: absolute;\n  left: 31%;\n  right: 0;\n  bottom: 13px;\n  border-bottom: 2px solid var(--ink);\n  transform: rotate(-12deg);\n  transform-origin: left;\n}\n.track-label {\n  position: absolute;\n  right: 0;\n  bottom: 12px;\n  font: 12px/1 \"Fragment Mono\", monospace;\n  transform: rotate(-12deg);\n}\n.pointer {\n  position: absolute;\n  left: 43%;\n  bottom: -7px;\n  width: 13px;\n  height: 13px;\n  background: var(--red);\n  transition: left 140ms steps(1);\n}\n.section-rule {\n  display: flex;\n  align-items: center;\n  gap: 18px;\n  border-top: 6px solid var(--ink);\n  padding-top: 13px;\n  margin-top: 6px;\n}\n.section-rule h2 {\n  margin: 0;\n  font-family: \"LXGW Marker Gothic\", \"Noto Serif SC\", serif;\n  font-size: 38px;\n  font-weight: 400;\n}\n.section-rule p {\n  margin: 0;\n  font-size: 15px;\n  color: var(--ink-2);\n  line-height: 1.15;\n}\n.cards {\n  display: grid;\n  grid-template-columns: 1.15fr .8fr 1fr;\n  gap: 22px;\n  margin-top: 22px;\n  align-items: stretch;\n}\n.card {\n  border: var(--line) solid var(--ink);\n  background: var(--paper);\n  position: relative;\n  filter: drop-shadow(6px 6px 0 var(--pressed));\n}\n.card-image {\n  display: block;\n  width: 100%;\n  height: 166px;\n  object-fit: cover;\n  border-bottom: var(--line) solid var(--ink);\n  background: var(--ink-2);\n}\n.card:nth-child(2) .card-image {\n  height: 202px;\n}\n.card-body {\n  padding: 15px 16px 17px;\n  line-height: 1.15;\n}\n.card-title {\n  margin: 0 0 10px;\n  font-family: \"LXGW Marker Gothic\", \"Noto Serif SC\", serif;\n  font-size: 28px;\n  line-height: .95;\n}\n.card p {\n  margin: 0;\n  font-size: 16px;\n}\n.card-price {\n  margin-top: 16px;\n  display: block;\n  text-align: right;\n  font: 18px/1 \"Fragment Mono\", monospace;\n}\nfooter {\n  display: flex;\n  justify-content: space-between;\n  gap: 20px;\n  border-top: var(--line) solid var(--ink);\n  margin-top: 30px;\n  padding-top: 12px;\n  font-size: 14px;\n  line-height: 1.2;\n}\nfooter strong {\n  color: var(--red);\n  font-family: \"LXGW Marker Gothic\", \"Noto Serif SC\", serif;\n  font-size: 23px;\n  font-weight: 400;\n}\n@keyframes press {\n  0% {\n    transform: translate(-12px, 12px);\n  }\n  70% {\n    transform: translate(3px, -3px);\n  }\n  100% {\n    transform: translate(0, 0);\n  }\n}\n.word-block {\n  animation: press 330ms steps(3, end) both;\n  animation-delay: calc(var(--i) * 110ms);\n}\n@media (prefers-reduced-motion: reduce) {\n  *,\n  *::before,\n  *::after {\n    animation-duration: 1ms !important;\n    animation-iteration-count: 1 !important;\n    transition-duration: 1ms !important;\n  }\n  .speed-lines {\n    display: none !important;\n  }\n  .slant-rail {\n    transform: skewY(-12deg) translateY(calc(var(--scroll-y, 0px) * .5));\n  }\n}\n@media (max-width: 760px) {\n  body {\n    cursor: auto;\n  }\n  body::before,\n  body::after {\n    display: none;\n  }\n  .page {\n    padding: 18px 16px 32px;\n  }\n  .topbar {\n    align-items: flex-start;\n  }\n  .hero {\n    min-height: 0;\n    padding-bottom: 31px;\n  }\n  .hero-intro {\n    width: 100%;\n  }\n  h1 {\n    font-size: clamp(57px, 17vw, 78px);\n    max-width: 600px;\n  }\n  .slant-rail {\n    position: relative;\n    left: 6%;\n    top: auto;\n    width: 94%;\n    margin-top: 55px;\n    gap: 18px;\n  }\n  .word-block,\n  .w4,\n  .w6,\n  .w7,\n  .w9 {\n    width: 100%;\n  }\n  .block-note {\n    max-width: 44%;\n  }\n  .track {\n    position: relative;\n    left: 7%;\n    width: 93%;\n    bottom: auto;\n    margin-top: 38px;\n  }\n  .track-label {\n    bottom: -20px;\n  }\n  .pointer {\n    bottom: -7px;\n  }\n  .cards {\n    grid-template-columns: 1fr;\n    gap: 19px;\n  }\n  .card-image,\n  .card:nth-child(2) .card-image {\n    height: 190px;\n  }\n  footer {\n    flex-direction: column;\n  }\n}\n</style>\n</head>\n<body>\n<main class=\"page\">\n  <header class=\"topbar\">\n    <div class=\"masthead\">北星修补站 / NORTHSTAR</div>\n    <div class=\"meta\">街角 07:30—19:30<br>不接急单，只接好活</div>\n  </header>\n\n  <section class=\"hero\" aria-labelledby=\"main-title\">\n    <div class=\"hero-intro\">\n      <div class=\"kicker\">鞋底在喊 / 钥匙在响 / 现在就来</div>\n      <h1 id=\"main-title\">鞋坏了？<br>钥匙呢？</h1>\n      <p class=\"lede\">别把今天交给坏鞋底。把鞋、锁、还有那点不服输，统统带到街角来。</p>\n      <a class=\"cta\" href=\"tel:010-5800-7716\"><span class=\"mono\">CALL 01</span><span>打电话，约个时间 →</span></a>\n    </div>\n\n    <div class=\"slant-rail\" aria-label=\"服务项目\">\n      <div class=\"word-block w9\" style=\"--i:0;--dot-shift:0px\" data-index=\"01\">\n        <span class=\"block-number mono\">01</span>\n        <span class=\"speed-lines\"></span>\n        <div class=\"block-content\">\n          <span class=\"block-word\">补鞋底</span>\n          <span class=\"block-note\">旧鞋不退场<br>再跑一轮</span>\n        </div>\n      </div>\n      <div class=\"word-block w6\" style=\"--i:1;--dot-shift:1px\" data-index=\"02\">\n        <span class=\"block-number mono\">02</span>\n        <span class=\"speed-lines\"></span>\n        <div class=\"block-content\">\n          <span class=\"block-word\">配钥匙</span>\n          <span class=\"block-note\">一拧就开<br>不和门较劲</span>\n        </div>\n      </div>\n      <div class=\"word-block w7\" style=\"--i:2;--dot-shift:2px\" data-index=\"03\">\n        <span class=\"block-number mono\">03</span>\n        <span class=\"speed-lines\"></span>\n        <div class=\"block-content\">\n          <span class=\"block-word\">换鞋跟</span>\n          <span class=\"block-note\">站稳了<br>气势才出来</span>\n        </div>\n      </div>\n      <div class=\"word-block w4\" style=\"--i:3;--dot-shift:3px\" data-index=\"04\">\n        <span class=\"block-number mono\">04</span>\n        <span class=\"speed-lines\"></span>\n        <div class=\"block-content\">\n          <span class=\"block-word\">修拉链</span>\n          <span class=\"block-note\">卡住的<br>给它一条路</span>\n        </div>\n      </div>\n      <div class=\"word-block w9\" style=\"--i:4;--dot-shift:4px\" data-index=\"05\">\n        <span class=\"block-number mono\">05</span>\n        <span class=\"speed-lines\"></span>\n        <div class=\"block-content\">\n          <span class=\"block-word\">刻门牌</span>\n          <span class=\"block-note\">你的门<br>要有自己的字</span>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"track\" aria-hidden=\"true\"><span class=\"pointer\"></span></div>\n    <div class=\"track-label\">TRACK / 01—05</div>\n  </section>\n\n  <section aria-labelledby=\"visit-title\">\n    <div class=\"section-rule\">\n      <h2 id=\"visit-title\">带上它，来。</h2>\n      <p>五个动作，都是街坊每天会用到的硬招。</p>\n    </div>\n    <div class=\"cards\">\n      <article class=\"card\">\n        <img class=\"card-image\" src=\"images/占位-1.jpg\" width=\"720\" height=\"400\" alt=\"磨旧的皮鞋和修鞋工具\">\n        <div class=\"card-body\">\n          <h3 class=\"card-title\">鞋底重做</h3>\n          <p>走路打滑、鞋底开口，别等它在雨里散架。先打电话，留一段时间给师傅。</p>\n          <span class=\"card-price\">FROM 68</span>\n        </div>\n      </article>\n      <article class=\"card\">\n        <img class=\"card-image\" src=\"images/占位-2.jpg\" width=\"520\" height=\"500\" alt=\"一串不同形状的钥匙\">\n        <div class=\"card-body\">\n          <h3 class=\"card-title\">钥匙复制</h3>\n          <p>家门、信箱、车库。带原钥匙来，现场试到顺手为止。</p>\n          <span class=\"card-price\">FROM 12</span>\n        </div>\n      </article>\n      <article class=\"card\">\n        <img class=\"card-image\" src=\"images/占位-3.jpg\" width=\"640\" height=\"400\" alt=\"鞋跟和金属修补件\">\n        <div class=\"card-body\">\n          <h3 class=\"card-title\">鞋跟换新</h3>\n          <p>高跟、皮靴、工作鞋，站不稳的那一下，我们把它按回地面。</p>\n          <span class=\"card-price\">FROM 35</span>\n        </div>\n      </article>\n    </div>\n  </section>\n\n  <footer>\n    <div>\n      <strong>北星修补站</strong><br>\n      北京市东城区北新桥街 16 号 · 010-5800-7716\n    </div>\n    <div class=\"mono\">\n      CALL INDEX / 01—05<br>\n      先约时间，再来敲门。\n    </div>\n  </footer>\n</main>\n\n<script>\n(function () {\n  const root = document.documentElement;\n  const rail = document.querySelector(\".slant-rail\");\n  const pointer = document.querySelector(\".pointer\");\n  const blocks = document.querySelectorAll(\".word-block\");\n  let ticking = false;\n\n  function moveRail() {\n    const y = window.scrollY || 0;\n    root.style.setProperty(\"--scroll-y\", y + \"px\");\n\n    if (!window.matchMedia(\"(prefers-reduced-motion: reduce)\").matches) {\n      rail.style.transform = \"skewY(-12deg) translateY(\" + (y * y / 9000) + \"px)\";\n      blocks.forEach(function (block) {\n        block.classList.toggle(\"is-scrolling\", y > 4);\n      });\n    }\n\n    pointer.style.left = (43 + Math.min(46, y / 10)) + \"%\";\n    ticking = false;\n  }\n\n  window.addEventListener(\"scroll\", function () {\n    if (!ticking) {\n      window.requestAnimationFrame(moveRail);\n      ticking = true;\n    }\n  }, { passive: true });\n\n  blocks.forEach(function (block, i) {\n    block.addEventListener(\"click\", function () {\n      block.animate(\n        [\n          { transform: \"translate(-12px, 12px)\" },\n          { transform: \"translate(0, 0)\" }\n        ],\n        {\n          duration: 240,\n          easing: \"steps(2, end)\"\n        }\n      );\n      pointer.style.left = (12 + i * 18) + \"%\";\n    });\n  });\n\n  document.addEventListener(\"mousemove\", function (event) {\n    root.style.setProperty(\"--mx\", event.clientX + \"px\");\n    root.style.setProperty(\"--my\", event.clientY + \"px\");\n  });\n}());\n</script>\n</body>\n</html>"
        }
      }
    }
  },
