0 var(--matcha);\n94:       transition: width 300ms cubic-bezier(.34,1.2,.64,1), background-color 300ms cubic-bezier(.34,1.2,.64,1);\n95:     }\n96:     .fold-line::before, .fold-line::after {\n97:       content: \"\";\n98:       position: absolute;\n99:       left: -1px;\n100:       width: 5px;\n101:       height: 4px;\n102:       background: var(--matcha);\n103:     }\n104:     .fold-line::before { top: 50.4%; transform: translateY(-1px) rotate(-8deg); }\n105:     .fold-line::after { top: 50.4%; transform: translateY(3px) rotate(7deg); }\n106:     .crease-deeper .fold-line { width: 6px; background: var(--crease); }\n107:     .mirror {\n108:       position: absolute;\n109:       inset: 0;\n110:       pointer-events: none;\n111:       background: var(--matcha);\n112:       opacity: .14;\n113:       mix-blend-mode: multiply;\n114:       transition: opacity 240ms ease;\n115:     }\n116:     .half.right .mirror { opacity: .22; transform: scaleX(-1); transform-origin: center; }\n117:     .hero { min-height: 310px; display: flex; flex-direction: column; justify-content: center; position: relative; }\n118:     .eyebrow { font-family: var(--mono); font-size: 12px; letter-spacing: .08em; margin-bottom: 14px; }\n119:     h1, h2, h3 { font-family: var(--title); font-weight: 500; margin: 0; }\n120:     h1 { font-size: clamp(58px, 7vw, 81px); line-height: .98; letter-spacing: -.04em; max-width: 5ch; }\n121:     .hero p { max-width: 31em; margin: 28px 0 0; }\n122:     .call { display: inline-flex; align-items: center; gap: 16px; align-self: flex-start; margin-top: 28px; padding: 11px 14px; border: 3px solid var(--matcha); box-shadow: inset 0 -3px 0 var(--matcha); background: var(--paper); }\n123:     .call strong { font-family: var(--mono); font-size: 16px; font-variant-numeric: tabular-nums; }\n124:     .chapter-note { margin: 0 0 28px auto; max-width: 24ch; border-left: 3px solid var(--matcha); padding-left: 14px; }\n125:     .chapter-note h2 { font-size: 31px; line-height: 1.08; margin-bottom: 12px; }\n126:     .index { font-family: var(--mono); font-size: 12px; letter-spacing: .08em; }\n127:     .entries { display: grid; grid-template-columns: 1.22fr .86fr; gap: var(--gutter); align-items: start; }\n128:     .entry { border-top: 1px solid var(--crease); padding-top: 10px; }\n129:     .entry:nth-child(2) { margin-top: 56px; }\n130:     .entry:nth-child(3) { grid-column: 1 / -1; display: grid; grid-template-columns: 1fr 1.4fr; gap: 18px; margin-top: 20px; }\n131:     .entry:nth-child(4) { margin-top: 15px; }\n132:     .entry:nth-child(5) { margin-top: 78px; }\n133:     .entry h3 { font-size: 25px; line-height: 1.12; margin: 4px 0 8px; }\n134:     .entry p { margin: 0; }\n135:     .entry-image { display: block; width: 100%; height: auto; border: 1px solid var(--crease); filter: grayscale(1) sepia(.12); }\n136:     .entry-image.tall { aspect-ratio: 4 / 5; object-fit: cover; }\n137:     .entry-image.wide { aspect-ratio: 3 / 2; object-fit: cover; }\n138:     .blank-image { min-height: 150px; border: 1px solid var(--crease); padding: 14px; display: flex; align-items: end; background: var(--paper); }\n139:     .blank-image span { font-family: var(--mono); font-size: 11px; }\n140:     .price { float: right; font-family: var(--mono); font-size: 13px; font-variant-numeric: tabular-nums; }\n141:     .footer { margin-top: var(--section-gap); display: grid; grid-template-columns: repeat(6, 1fr); gap: var(--gutter); border-top: 3px solid var(--matcha); padding-top: 16px; }\n142:     .footer-note { grid-column: 1 / span 3; }\n143:     .footer-number { grid-column: 6; text-align: right; font-family: var(--mono); font-size: 12px; }\n144:     .ink-dot { width: 6px; height: 6px; background: var(--ink); display: inline-block; margin-left: 8px; vertical-align: middle; }\n145:     .load-top, .load-bottom { opacity: 1; transform: none; }\n146:     .js-ready .load-top { animation: reveal 240ms ease-out both; }\n147:     .js-ready .load-bottom { animation: reveal 240ms 240ms ease-out both; }\n148:     @keyframes reveal { from { opacity: .12; } to { opacity: 1; } }\n149:     @media (max-width: 760px) {\n150:       body { cursor: auto; }\n151:       .cursor-mark { display: none; }\n152:       .page { padding: 20px 22px 48px; }\n153:       .masthead { grid-template-columns: repeat(2, 1fr); min-height: 88px; }\n154:       .brand { grid-column: 1; }\n155:       .nav { grid-column: 2; display: block; text-align: right; }\n156:       .nav a { display: block; width: max-content; margin-left: auto; margin-bottom: 7px; }\n157:       .spread { display: block; min-height: auto; }\n158:       .half.left, .half.right { padding: 0; transform: none; }\n159:       .fold-line { height: 3px; min-height: 3px; width: 100%; margin: 42px 0; }\n160:       .fold-line::before, .fold-line::after { top: 50%; left: 50%; }\n161:       .half.right .mirror { transform: scaleY(-1); }\n162:       h1 { font-size: 64px; }\n163:       .hero { min-height: 520px; }\n164:       .entries { grid-template-columns: 1fr; }\n165:       .entry:nth-child(2), .entry:nth-child(4), .entry:nth-child(5) { margin-top: 28px; }\n166:       .entry:nth-child(3) { grid-column: auto; display: block; margin-top: 28px; }\n167:       .entry:nth-child(3) .entry-image { margin-top: 16px; }\n168:       .footer { grid-template-columns: 1fr 1fr; }\n169:       .footer-note { grid-column: 1; }\n170:       .footer-number { grid-column: 2; }\n171:     }\n172:     @media (prefers-reduced-motion: reduce) {\n173:       html { scroll-behavior: auto; }\n174:       *, *::before, *::after { animation-duration: 120ms !important; transition-duration: 120ms !important; }\n175:       .crease-deeper .fold-line { width: 3px; }\n176:     }\n177:   </style>\n178: </head>\n179: <body>\n180:   <div class=\"cursor-mark\" aria-hidden=\"true\"></div>\n181:   <main class=\"page\" id=\"top\">\n182:     <header class=\"masthead\">\n183:       <a class=\"brand\" href=\"#top\"><strong>一针一匙</strong>修鞋 · 配钥匙</a>\n184:       <nav class=\"nav\" aria-label=\"页面导航\"><a href=\"#work\">手上的活</a><a href=\"#visit\">来坐坐</a></nav>\n185:     </header>\n186: \n187:     <section class=\"spread\" aria-label=\"店铺介绍与服务目录\">\n188:       <div class=\"half left load-top\">\n189:         <div class=\"mirror\"></div>\n190:         <div class=\"hero\">\n191:           <div class=\"eyebrow\">A SMALL REPAIR SHOP · 01—05</div>\n192:           <h1>鞋底有路，钥匙有门。</h1>\n193:           <p>我们在街角做一点慢工：把穿旧的鞋再缝牢，把手里那把钥匙配得顺手。进门不用预约，电话告诉我一声，我给你留个时间。</p>\n194:           <a class=\"call\" href=\"tel:010-6288-1726\"><span>电话约时间</span><strong>010—6288—1726</strong></a>\n195:         </div>\n196:         <div class=\"footer\">\n197:           <div class=\"footer-note\">不赶着把东西换掉。能修的，先好好修。</div>\n198:           <div class=\"footer-number\">PAGE 01 <span class=\"ink-dot\"></span></div>\n199:         </div>\n200:       </div>\n201: \n202:       <div class=\"fold-line\" aria-hidden=\"true\"></div>\n203: \n204:       <div class=\"half right load-bottom\" id=\"work\">\n205:         <div class=\"mirror\"></div>\n206:         <div class=\"chapter-note\">\n207:           <div class=\"index\">手上的活 / 05 件</div>\n208:           <h2>每一件，都从手感开始。</h2>\n209:           <p>你带来的东西，我们先摸一遍，再说怎么做。下面是店里常做的五件小事。</p>\n210:         </div>\n211:         <div class=\"entries\">\n212:           <article class=\"entry\">\n213:             <div class=\"index\">01</div><span class=\"price\">¥35 起</span>\n214:             <h3>鞋底补一补</h3>\n215:             <p>磨到薄处补一层，走路不硌脚。黑、棕、米色的底都有，尽量找和原来一样的。</p>\n216:             <img class=\"entry-image wide\" src=\"images/占位-1.jpg\" width=\"640\" height=\"427\" alt=\"正在修补的鞋底\">\n217:           </article>\n218:           <article class=\"entry\">\n219:             <div class=\"index\">02</div><span class=\"price\">¥60 起</span>\n220:             <h3>鞋面缝合</h3>\n221:             <p>线头松了别急着扔，针脚能接回去。留下些手工痕迹，也不妨碍它继续陪你走。</p>\n222:             <img class=\"entry-image tall\" src=\"images/占位-2.jpg\" width=\"512\" height=\"640\" alt=\"手工缝合鞋面\">\n223:           </article>\n224:           <article class=\"entry\">\n225:             <div>\n226:               <div class=\"index\">03</div><span class=\"price\">¥20 起</span>\n227:               <h3>配一把钥匙</h3>\n228:               <p>带原钥匙来就好。我们会把边缘磨顺，插进锁里，不顶、不涩，转起来轻一点。</p>\n229:             </div>\n230:             <img class=\"entry-image wide\" src=\"images/占位-3.jpg\" width=\"640\" height=\"427\" alt=\"钥匙坯与工具\">\n231:           </article>\n232:           <article class=\"entry\">\n233:             <div class=\"index\">04</div><span class=\"price\">¥15</span>\n234:             <h3>换鞋带</h3>\n235:             <p>旧鞋带断在半路，换一副合脚的。棉的、蜡的，颜色都在抽屉里。</p>\n236:             <img class=\"entry-image tall\" src=\"images/占位-4.jpg\" width=\"512\" height=\"640\" alt=\"整齐放置的鞋带\">\n237:           </article>\n238:           <article class=\"entry\">\n239:             <div class=\"index\">05</div><span class=\"price\">¥10 起</span>\n240:             <h3>小地方整理</h3>\n241:             <p>鞋跟松动、鞋垫卷边、钥匙圈缺一环——小问题也值得被认真对待。</p>\n242:             <div class=\"blank-image\"><span>这里留给你带来的那一件</span></div>\n243:           </article>\n244:         </div>\n245:         <div class=\"footer\" id=\"visit\">\n246:           <div class=\"footer-note\">周一至周六 09:30—19:00<br>周日给自己留半天，下午见。</div>\n247:           <div class=\"footer-number\">PAGE 01 <span class=\"ink-dot\"></span></div>\n248:         </div>\n249:       </div>\n250:     </section>\n251:   </main>\n252:   <script>\n253:     (function () {\n254:       document.documentElement.classList.add('js-ready');\n255:       var page = document.querySelector('.page');\n256:       var fold = document.querySelector('.fold-line');\n257:       var cursor = document.querySelector('.cursor-mark');\n258:       var links = document.querySelectorAll('a, button');\n259:       window.addEventListener('pointermove', function (event) {\n260:         cursor.style.left = event.clientX + 'px';\n\n(Showing lines 1-260 of 276. Use offset=261 to continue.)\n</content>"}}]}}}
