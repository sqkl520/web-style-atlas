solid var(--paper);border-left:9px solid transparent}\n.fold.deep .half:after{box-shadow:inset 6px 0 0 var(--crease),inset -6px 0 0 var(--crease);opacity:.4;transition:box-shadow 300ms cubic-bezier(.34,1.2,.64,1)}\n.flip{animation:fold 420ms cubic-bezier(.34,1.2,.64,1) forwards;transform-origin:50% 100%}@keyframes fold{to{transform:rotateX(-88deg)}}\n@media (max-width:760px){body{cursor:auto}.page{padding:0 22px}.masthead{height:72px}.nav{gap:12px;font-size:12px}.half{display:block}.upper,.lower{min-height:0;padding:28px 0}.lower{margin-left:0;padding-top:32px}.half:after,.ghost,.fray{display:none}.cell,.hero-title,.hero-note{display:block;margin-bottom:34px}.hero-title{font-size:clamp(54px,15vw,70px);margin-top:30px}.hero-note{border-left:0;border-top:1px solid var(--crease);padding:12px 0 0;max-width:none}.image,.image.tall{height:210px}.lower .cell:nth-child(2),.lower .cell:nth-child(3){padding-top:0}.rule{height:72px}.story{display:block;padding-top:32px}.story-intro,.story-body,.story-aside{margin-bottom:34px}.story-body{border-left:0;border-top:1px solid var(--crease);padding:18px 0 0}.footer{display:block}.footer>*{display:block;margin-bottom:8px}.cursor{display:none}}\n@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}.fold.deep .half:after{transition:opacity 120ms ease}.flip{animation:none}.ghost{opacity:.18}}\n</style>\n</head>\n<body>\n<div class=\"cursor\" aria-hidden=\"true\"></div>\n<div class=\"page\">\n<header class=\"masthead\"><div class=\"brand\">老周修鞋 · 配钥匙</div><nav class=\"nav\"><a href=\"#work\">手上做的事</a><a href=\"#about\">关于小店</a><a href=\"tel:13800138000\">电话预约</a></nav></header>\n<main>\n<section class=\"fold\" id=\"fold\" aria-label=\"一张对折的店铺纸页\">\n<div class=\"half upper\">\n<div class=\"ghost\">鞋还好着，别急着换。把一件东西再用久一点，是我愿意做的事。</div>\n<div class=\"cell\"><p class=\"eyebrow\">01 / OPENING HOURS</p><p class=\"quiet\">周一至周六　09:00—19:00<br>午间不关门，人在就接活。</p></div>\n<h1 class=\"hero-title\">鞋还好着，<br>别急着换。</h1>\n<div class=\"hero-note\"><p>我在巷口修鞋，也配钥匙。先打个电话，留一盏灯给你。</p><a class=\"action\" href=\"tel:13800138000\">打电话约时间</a></div>\n</div>\n<div class=\"half lower\" id=\"work\">\n<div class=\"ghost\">一针一线，边角磨圆。钥匙转得顺，鞋底走得稳，这就是小店的好消息。</div>\n<article class=\"cell\"><div class=\"image\"><img src=\"images/占位-1.jpg\" width=\"640\" height=\"420\" alt=\"手工修补鞋面\"></div><p class=\"eyebrow\">02 / SHOE REPAIR</p><h2 class=\"card-title\">鞋底换新</h2><p class=\"card-copy\">走路硌脚了，拿来看看。该换底就换底，不该换的，我也会告诉你。</p><div class=\"meta\"><span>从 ¥35</span><span>02</span></div></article>\n<article class=\"cell\"><div class=\"image tall\"><img src=\"images/占位-2.jpg\" width=\"560\" height=\"680\" alt=\"擦亮后的皮鞋\"></div><p class=\"eyebrow\">03 / KEY CUTTING</p><h2 class=\"card-title\">钥匙配得顺</h2><p class=\"card-copy\">带原钥匙来就好。我照着齿口慢慢磨，转进锁里不顶不涩。</p><div class=\"meta\"><span>从 ¥8</span><span>03</span></div></article>\n<article class=\"cell\"><div class=\"image empty\">这一格留给<br>鞋里看不见的功夫。</div><p class=\"eyebrow\">04 / SMALL FIX</p><h2 class=\"card-title\">小地方，慢慢补</h2><p class=\"card-copy\">断线、开胶、掉跟，带来就好。小毛病不值得让一双鞋退休。</p><div class=\"meta\"><span>先看再说</span><span>04</span></div></article>\n</div>\n<div class=\"fray left\"></div><div class=\"fray right\"></div>\n</section>\n<section class=\"rule\"><h2>手上做的事</h2><span>一间店，五种耐心</span></section>\n<section class=\"story\" id=\"about\">\n<div class=\"story-intro\"><p class=\"eyebrow\">05 / ABOUT THE SHOP</p><h2 class=\"card-title\" style=\"font-size:40px\">我不赶时间，<br>你也不用。</h2></div>\n<div class=\"story-body\"><p>这间店开在菜市场后面，门脸不大，桌面总有一点皮屑和铜屑。老周说，修东西和做人差不多：先找出哪里不对，再决定要不要动它。</p><p>钥匙要对得上锁，鞋底要对得上脚。每一件送到手里的东西，我都当作还要陪你走很久。要是着急，提前来个电话；不着急，就坐一会儿，听听机器响。</p><a class=\"action\" href=\"tel:13800138000\">138 0013 8000</a></div>\n<aside class=\"story-aside\"><p class=\"eyebrow\">06 / NOTE</p><p>“修好以后，别忘了多走几步试试。”</p><span class=\"quiet\">— 老周</span></aside>\n</section>\n</main>\n<footer class=\"footer\"><span><i class=\"dot\"></i>北京市南锣鼓巷 17 号旁</span><span>预约电话 138 0013 8000</span><span>© 2024 老周</span></footer>\n</div>\n<script>\n(function(){\n  var fold=document.getElementById('fold'),cursor=document.querySelector('.cursor');\n  function deepen(){var box=fold.getBoundingClientRect();if(box.top<innerHeight*.5&&box.bottom>innerHeight*.5)fold.classList.add('deep')}\n  addEventListener('scroll',deepen,{passive:true});deepen();\n  addEventListener('pointermove',function(e){cursor.style.left=e.clientX+'px';cursor.style.top=e.clientY+'px'});\n  document.querySelectorAll('a').forEach(function(link){link.addEventListener('mouseenter',function(){cursor.classList.add('link')});link.addEventListener('mouseleave',function(){cursor.classList.remove('link')})});\n  var call=document.querySelector('.hero-note .action');call.addEventListener('click',function(){if(!matchMedia('(prefers-reduced-motion: reduce)').matches){fold.classList.add('flip');setTimeout(function(){fold.classList.remove('flip')},430)}});\n}());\n</script>\n</body>\n</html>"}}}}
