th:24px;height:24px;border:1px solid var(--ink);pointer-events:none;transform:translate(-3px,-3px);background:var(--paper)}.fiber-cursor:before{content:\"\";position:absolute;left:-1px;top:-1px;border-top:9px solid var(--paper);border-right:9px solid transparent}.fiber-cursor.is-link:before{left:auto;top:auto;right:-1px;bottom:-1px;border-top:0;border-bottom:9px solid var(--paper);border-left:9px solid transparent}\n48: .crease-fray{position:absolute;top:var(--fold-pos);left:calc(50% - var(--gutter)/2 - 1px);width:4px;height:4px;background:var(--crease);z-index:7;box-shadow:0 0 0 1px var(--paper),0 2px 0 var(--crease)}.crease-fray.right{left:calc(50% + var(--gutter)/2 - 3px)}\n49: .fold-page.deep .half:after{box-shadow:inset 6px 0 0 rgba(107,101,88,.35),inset -6px 0 0 rgba(107,101,88,.35);transition:box-shadow 300ms cubic-bezier(.34,1.2,.64,1)}\n50: .flip{animation:fold 420ms cubic-bezier(.34,1.2,.64,1) forwards;transform-origin:50% 100%}\n51: @keyframes fold{to{transform:rotateX(-88deg)}}\n52: @media (max-width:760px){body{cursor:auto}.paper-shell{padding:0 22px}.masthead{height:72px}.masthead nav{gap:12px;font-size:12px}.half{display:block;padding:28px 0}.half.upper{min-height:auto}.half.lower{margin-left:0;min-height:auto;padding-top:32px}.half:after,.ghost,.crease-fray{display:none}.cell,.hero-title,.hero-note{display:block;margin-bottom:34px}.hero-title{font-size:clamp(48px,15vw,70px);margin-top:32px}.hero-note{border-left:0;border-top:1px solid var(--crease);padding:12px 0 0;max-width:none}.image-frame,.image-frame.tall{height:210px}.lower .cell:nth-child(2),.lower .cell:nth-child(3){padding-top:0}.section-rule{height:72px}.story{display:block;padding-top:32px}.story-intro,.story-body,.story-aside{margin-bottom:34px}.story-body{border-left:0;border-top:1px solid var(--crease);padding:18px 0 0}.footer{display:block}.footer>*{display:block;margin-bottom:8px}.fiber-cursor{display:none}}\n53: @media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}.fold-page.deep .half:after{transition:opacity 120ms ease}.flip{animation:none}.ghost{opacity:.18}}\n54: </style>\n55: </head>\n56: <body>\n57: <div class=\"fiber-cursor\" aria-hidden=\"true\"></div>\n58: <div class=\"paper-shell\">\n59: <header class=\"masthead\"><div class=\"mark\">老周修鞋 · 配钥匙</div><nav><a href=\"#work\">手上做的事</a><a href=\"#about\">关于这间小店</a><a href=\"tel:13800138000\">电话预约</a></nav></header>\n60: <main>\n61: <section class=\"fold-page\" id=\"fold-page\" aria-label=\"店铺首页，对折纸页布局\">\n62: <div class=\"half upper\">\n63: <div class=\"ghost\">让旧东西继续陪你走一段。每一双鞋都有它的脾气，慢慢做，才不辜负。</div>\n64: <div class=\"cell\"><p class=\"eyebrow\">01 / OPENING HOURS</p><p class=\"small-label\">周一至周六　09:00—19:00<br>午间不关门，人在就接活。</p></div>\n65: <h1 class=\"hero-title\">鞋还好着，<br>别急着换。</h1>\n66: <div class=\"hero-note\"><p>我在巷口修鞋，也配钥匙。先打个电话，留一盏灯给你。</p><a class=\"call\" href=\"tel:13800138000\">打电话约时间</a></div>\n67: </div>\n68: <div class=\"half lower\" id=\"work\">\n69: <div class=\"ghost\">一针一线，边角磨圆。钥匙转得顺，鞋底走得稳，这就是小店的好消息。</div>\n70: <article class=\"cell\"><div class=\"image-frame\"><img src=\"images/占位-1.jpg\" width=\"640\" height=\"420\" alt=\"手工修补鞋面\"></div><p class=\"eyebrow\">02 / SHOE REPAIR</p><h2 class=\"card-title\">鞋底换新</h2><p class=\"card-copy\">走路硌脚了，拿来看看。该换底就换底，不该换的，我也会告诉你。</p><div class=\"card-meta\"><span>从 ¥35</span><span>02</span></div></article>\n71: <article class=\"cell\"><div class=\"image-frame tall\"><img src=\"images/占位-2.jpg\" width=\"560\" height=\"680\" alt=\"擦亮后的皮鞋\"></div><p class=\"eyebrow\">03 / CARE</p><h2 class=\"card-title\">皮面养护</h2><p class=\"card-copy\">皮子也会口渴。擦一层油，颜色慢慢回来，像老朋友又见面。</p><div class=\"card-meta\"><span>从 ¥25</span><span>03</span></div></article>\n72: <article class=\"cell\"><div class=\"image-frame blank\">这里不放照片。<br>有些修补，要把鞋翻过来，才看得见。</div><p class=\"eyebrow\">04 / SMALL FIX</p><h2 class=\"card-title\">小地方，慢慢补</h2><p class=\"card-copy\">断线、开胶、掉跟，带来就好。小毛病不值得让一双鞋退休。</p><div class=\"card-meta\"><span>先看再说</span><span>04</span></div></article>\n73: </div>\n74: <div class=\"crease-fray\"></div><div class=\"crease-fray right\"></div>\n75: </section>\n76: <section class=\"section-rule\"><h2>手上做的事</h2><span>一间店，五种耐心</span></section>\n77: <section class=\"story\" id=\"about\">\n78: <div class=\"story-intro\"><p class=\"eyebrow\">05 / ABOUT THE SHOP</p><h2 class=\"card-title\" style=\"font-size:40px\">我不赶时间，<br>你也不用。</h2></div>\n79: <div class=\"story-body\"><p>这间店开在菜市场后面，门脸不大，桌面总有一点皮屑和铜屑。老周说，修东西和做人差不多：先找出哪里不对，再决定要不要动它。</p><p>钥匙要对得上锁，鞋底要对得上脚。每一件送到手里的东西，我都当作还要陪你走很久。要是着急，提前来个电话；不着急，就坐一会儿，听听机器响。</p><a class=\"call\" href=\"tel:13800138000\">138 0013 8000</a></div>\n80: <aside class=\"story-aside\"><p class=\"eyebrow\">06 / NOTE</p><p>“修好以后，别忘了多走几步试试。”</p><span class=\"small-label\">— 老周</span></aside>\n81: </section>\n82: </main>\n83: <footer class=\"footer\"><span><i class=\"dot\"></i>北京市南锣鼓巷 17 号旁</span><span>预约电话 138 0013 8000</span><span>© 2024 老周</span></footer>\n84: </div>\n85: <script>\n86: (function(){\n87:  const page=document.getElementById('fold-page'), cursor=document.querySelector('.fiber-cursor');\n88:  const onScroll=()=>{const r=page.getBoundingClientRect();if(r.top<innerHeight*.5&&r.bottom>innerHeight*.5)page.classList.add('deep')};\n89:  addEventListener('scroll',onScroll,{passive:true});onScroll();\n90:  addEventListener('pointermove',e=>{cursor.style.left=e.clientX+'px';cursor.style.top=e.clientY+'px'});\n91:  document.querySelectorAll('a').forEach(a=>{a.addEventListener('mouseenter',()=>cursor.classList.add('is-link'));a.addEventListener('mouseleave',()=>cursor.classList.remove('is-link'))});\n92:  const button=document.querySelector('.hero-note .call');button.addEventListener('click',()=>{if(!matchMedia('(prefers-reduced-motion: reduce)').matches){page.classList.add('flip');setTimeout(()=>page.classList.remove('flip'),430)}});\n93: })();\n94: </script>\n95: </body>\n96: </html>\n\n(End of file - total 96 lines)\n</content>"}}]}}}
