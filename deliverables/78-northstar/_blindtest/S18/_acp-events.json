:relative;}\n26: .kicker{font-family:VT323,\"Courier New\",monospace;font-size:18px;letter-spacing:.08em;margin:0 0 10px;}\n27: h1{font-size:clamp(50px,7.3vw,76px);line-height:.92;margin:0;letter-spacing:-.06em;font-weight:700;}\n28: .lede{max-width:490px;margin:18px 0 0;line-height:1.55;}\n29: .registry{border-left:1px solid var(--ink);padding-left:14px;align-self:end;font-family:VT323,\"Courier New\",monospace;font-variant-numeric:tabular-nums;}\n30: .registry strong{display:block;font-size:38px;line-height:1;color:var(--deep);}\n31: .registry span{display:block;margin-top:8px;font-size:15px;line-height:1.2;}\n32: .subhead{display:flex;justify-content:space-between;align-items:baseline;border-bottom:1px solid var(--ink);padding:10px 0 8px;font-family:VT323,\"Courier New\",monospace;font-size:17px;}\n33: .subhead b{font-family:GlowSansSC,\"Songti SC\",Georgia,\"Times New Roman\",serif;font-weight:400;}\n34: .jobs{display:grid;grid-template-columns:1.1fr .78fr 1.22fr;gap:0;border-bottom:1px solid var(--ink);}\n35: .job{position:relative;border-right:1px solid var(--ink);min-height:238px;padding:18px 16px 20px 0;margin-right:16px;display:flex;flex-direction:column;}\n36: .job:nth-child(3n){border-right:0;margin-right:0;padding-right:0;}\n37: .job:nth-child(n+4){min-height:218px;border-top:1px solid var(--ink);padding-top:18px;}\n38: .job-id{font-family:VT323,\"Courier New\",monospace;font-size:21px;letter-spacing:.04em;margin-bottom:9px;display:flex;justify-content:space-between;}\n39: .job-id .hand{font-family:\"Comic Sans MS\",\"Segoe Print\",cursive;font-weight:400;transform:rotate(-3deg);display:inline-block;}\n40: .job h2{font-size:23px;line-height:1.1;margin:0 0 9px;}\n41: .job p{line-height:1.45;margin:0 0 14px;max-width:33ch;}\n42: .job-meta{margin-top:auto;border-top:1px solid var(--tag);padding-top:9px;font-family:VT323,\"Courier New\",monospace;font-size:16px;display:flex;justify-content:space-between;gap:8px;}\n43: .photo{width:100%;height:78px;object-fit:cover;display:block;border:1px solid var(--ink);margin:0 0 12px;background:var(--paper);}\n44: .text-photo{height:78px;border:1px solid var(--ink);padding:12px;font-family:VT323,\"Courier New\",monospace;font-size:17px;line-height:1.05;margin-bottom:12px;display:flex;align-items:center;justify-content:space-between;background:var(--paper);}\n45: .text-photo i{font-style:normal;font-size:32px;color:var(--deep);}\n46: .tag{position:absolute;right:-17px;top:18px;background:var(--tag);color:var(--paper);padding:7px 8px 8px;border:1px solid var(--ink);font-family:VT323,\"Courier New\",monospace;font-size:15px;line-height:1;transform-origin:top center;}\n47: .tag:before{content:\"\";position:absolute;top:-15px;left:50%;width:1px;height:15px;background:var(--ink);}\n48: .job:hover .tag{animation:sway 240ms ease-out both;}\n49: @keyframes sway{0%{transform:rotate(0)}35%{transform:rotate(6deg)}70%{transform:rotate(-2deg)}100%{transform:rotate(0)}}\n50: .contact{display:grid;grid-template-columns:1.2fr .8fr;gap:22px;padding:20px 0 0;}\n51: .contact h2{font-size:30px;margin:0 0 6px;line-height:1;}\n52: .contact p{margin:0;line-height:1.45;}\n53: .phone{display:flex;align-items:end;justify-content:space-between;border-left:4px solid var(--phos);padding:0 0 0 14px;}\n54: .phone a{font-family:VT323,\"Courier New\",monospace;color:var(--deep);text-decoration:none;font-size:34px;line-height:1;white-space:nowrap;}\n55: .phone small{font-family:VT323,\"Courier New\",monospace;font-size:15px;}\n56: .command{margin-top:22px;border-top:2px solid var(--ink);padding-top:12px;font-family:VT323,\"Courier New\",monospace;}\n57: .command form{display:flex;align-items:center;gap:8px;}\n58: .command label{font-size:19px;white-space:nowrap;}\n59: .command input{flex:1;background:var(--paper);border:0;border-bottom:1px solid var(--ink);font:19px VT323,\"Courier New\",monospace;color:var(--ink);padding:5px 4px;outline:0;min-width:0;}\n60: .command button{background:var(--phos);color:var(--bay);border:1px solid var(--ink);font:18px VT323,\"Courier New\",monospace;padding:6px 13px;cursor:pointer;}\n61: .command button:focus-visible{outline:2px solid var(--ink);outline-offset:2px;}\n62: .output{min-height:22px;margin:8px 0 0;color:var(--deep);}\n63: .footer{font-family:VT323,\"Courier New\",monospace;border-top:1px solid var(--ink);margin-top:20px;padding-top:9px;display:flex;justify-content:space-between;gap:10px;font-size:15px;}\n64: .cursor{display:inline-block;width:8px;height:14px;background:var(--deep);vertical-align:-2px;animation:blink 530ms steps(1,end) infinite;}\n65: @keyframes blink{50%{visibility:hidden}}\n66: .paper.loaded .edge{animation:holes 160ms steps(2,end) both;}\n67: .job{animation:drop 40ms steps(1,end) both;}\n68: .job:nth-child(1){animation-delay:160ms}.job:nth-child(2){animation-delay:200ms}.job:nth-child(3){animation-delay:240ms}.job:nth-child(4){animation-delay:280ms}.job:nth-child(5){animation-delay:320ms}\n69: @keyframes drop{from{opacity:0;transform:translateY(-8px)}to{opacity:1;transform:translateY(0)}}\n70: @keyframes holes{from{opacity:0}to{opacity:1}}\n71: .command.sent{border-left:1px solid var(--phos);padding-left:3px;transform:translateX(3px);transition:none;}\n72: .command.return{transform:translateX(0);transition:transform 300ms steps(1,end);}\n73: @media(max-width:800px){.edge{width:6%;}.paper{width:88%;margin-left:6%;padding:30px 18px 50px 22px}.mast{grid-template-columns:1fr;gap:18px}.registry{border-left:0;border-top:1px solid var(--ink);padding:10px 0 0}.jobs{grid-template-columns:1fr 1fr}.job:nth-child(3n){border-right:1px solid var(--ink);margin-right:16px;padding-right:16px}.job:nth-child(2n){border-right:0;margin-right:0;padding-right:0}.job:nth-child(n+3){border-top:1px solid var(--ink)}.contact{grid-template-columns:1fr}.phone{align-items:start;flex-direction:column;gap:9px}.phone a{font-size:31px}}\n74: @media(max-width:540px){h1{font-size:52px}.jobs{display:block}.job,.job:nth-child(n),.job:nth-child(3n){border-right:0;border-top:1px solid var(--ink);margin:0;padding:16px 0;min-height:0}.job:first-child{border-top:0}.tag{right:0}.contact h2{font-size:26px}.command form{align-items:stretch;flex-wrap:wrap}.command input{flex-basis:100%}.footer{display:block;line-height:1.5}}\n75: @media(prefers-reduced-motion:reduce){*,*:before,*:after{animation:none!important;transition:none!important}.cursor{visibility:visible}.command.sent{transform:none}.job{opacity:1}}\n76: </style>\n77: </head>\n78: <body>\n79: <main class=\"shell\">\n80: <div class=\"edge left\" aria-hidden=\"true\"></div><div class=\"edge right\" aria-hidden=\"true\"></div>\n81: <section class=\"paper\" id=\"paper\">\n82: <div class=\"paper-inner\">\n83: <header class=\"mast\">\n84: <div><p class=\"kicker\">NORTHSTAR / SHOE & KEY / SERVICE DECK</p><h1>修鞋。配钥匙。<br>不让它停。</h1><p class=\"lede\">旧物送到柜台，故障写进单里。我们按到店顺序处理，不猜，不拖，把能继续用的东西交还给你。</p></div>\n85: <div class=\"registry\"><strong>OPEN</strong><span>受理窗口<br>09:00—19:00<br>周一至周六</span></div>\n86: </header>\n87: <div class=\"subhead\"><b>/// 当前检修单 / 05 件登记</b><span>ROLL 001—005</span></div>\n88: <section class=\"jobs\" aria-label=\"服务项目\">\n89: <article class=\"job\"><div class=\"job-id\"><span>001—<span class=\"hand\">7</span>4</span><span>SHOE</span></div><img class=\"photo\" src=\"images/占位-1.jpg\" width=\"320\" height=\"78\" alt=\"皮鞋修复示意图\"><h2>皮鞋补底</h2><p>磨穿的底，先看受力点。补底、换跟、收边，按脚下实际磨损处理。</p><div class=\"job-meta\"><span>FROM ¥ 48</span><span>约 1—2 日</span></div><div class=\"tag\">挂 00174</div></article>\n90: <article class=\"job\"><div class=\"job-id\"><span>002—<span class=\"hand\">3</span>1</span><span>ZIP</span></div><img class=\"photo\" src=\"images/占位-2.jpg\" width=\"320\" height=\"78\" alt=\"拉链更换示意图\"><h2>拉链更换</h2><p>卡住、脱齿、拉头断。带来原件，能配就配，不能配就整条换。</p><div class=\"job-meta\"><span>FROM ¥ 35</span><span>约 1 日</span></div><div class=\"tag\">挂 00231</div></article>\n91: <article class=\"job\"><div class=\"job-id\"><span>003—<span class=\"hand\">9</span>8</span><span>KEY</span></div><img class=\"photo\" src=\"images/占位-3.jpg\" width=\"320\" height=\"78\" alt=\"钥匙复制示意图\"><h2>钥匙复制</h2><p>带原钥匙来。普通门钥匙现场配，特殊齿形先测再报，不拿猜的给你。</p><div class=\"job-meta\"><span>FROM ¥ 12</span><span>约 10 分钟</span></div><div class=\"tag\">挂 00398</div></article>\n92: <article class=\"job\"><div class=\"job-id\"><span>004—<span class=\"hand\">5</span>6</span><span>BAG</span></div><img class=\"photo\" src=\"images/占位-4.jpg\" width=\"320\" height=\"78\" alt=\"包具加固示意图\"><div class=\"text-photo\" aria-label=\"包具维修文字块\"><span>HANDLE / STITCH<br>检视缝线与承重点</span><i>+</i></div><h2>包具加固</h2><p>肩带、提手、开线位置单独看。先固定，再补线，别让小裂口继续跑。</p><div class=\"job-meta\"><span>FROM ¥ 30</span><span>约 2—3 日</span></div><div class=\"tag\">挂 00456</div></article>\n93: <article class=\"job\"><div class=\"job-id\"><span>005—<span class=\"hand\">2</span>0</span><span>BOOT</span></div><img class=\"photo\" src=\"images/占位-5.jpg\" width=\"320\" height=\"78\" alt=\"靴子保养示意图\"><h2>靴面保养</h2><p>清洁、补色、上油分开做。颜色要稳，边缘要收，不用亮得失去原样。</p><div class=\"job-meta\"><span>FROM ¥ 45</span><span>约 2 日</span></div><div class=\"tag\">挂 00520</div></article>\n94: </section>\n95: <section class=\"contact\"><div><h2>把时间挂上来。</h2><p>电话预约即可。说清楚要修什么，我们留出工位。到店报编号，少等一轮。</p></div><div class=\"phone\"><a href=\"tel:021-5550-1978\">021—5550—1978</a><small>PHONE / 预约主线</small></div></section>\n96: <section class=\"command\"><form id=\"command-form\"><label for=\"command\">C:\\&gt; 预约时间</label><input id=\"command\" name=\"command\" autocomplete=\"off\" placeholder=\"输入日期与大致时段\"><button type=\"submit\">提交</button></form><p class=\"output\" id=\"output\" aria-live=\"polite\"></p></section>\n97: <footer class=\"footer\"><span>北端修鞋铺 / 南桥路 18 号</span><span>记录完 <span class=\"cursor\"></span></span></footer>\n98: </div>\n99: </section>\n100: </main>\n101: <script>\n102: const paper=document.getElementById('paper');\n103: const form=document.getElementById('command-form');\n104: const input=document.getElementById('command');\n105: const output=document.getElementById('output');\n106: paper.classList.add('loaded');\n107: form.addEventListener('submit',function(event){\n108:  event.preventDefault();\n109:  const value=input.value.trim();\n110:  output.textContent=value?'[已登记] '+value+' / 请拨 021—5550—1978 确认':'[等待输入] 请写日期与大致时段';\n111:  form.parentElement.classList.remove('return');\n112:  form.parentElement.classList.add('sent');\n113:  window.setTimeout(function(){form.parentElement.classList.add('return');},300);\n114: });\n115: </script>\n116: </body>\n117: </html>\n\n(End of file - total 117 lines)\n</content>"
