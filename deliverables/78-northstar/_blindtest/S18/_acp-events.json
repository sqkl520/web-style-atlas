          "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>北端修鞋铺 // 维修登记台</title>\n<style>\n@font-face{font-family:GlowSansSC;src:local(\"Glow Sans SC\");}\n:root{--phos:#2FA84F;--bay:#0A0D0A;--paper:#C8C4AE;--tag:#6E6350;--deep:#278F43;--ink:#111111;--rule:1px;}\n*{box-sizing:border-box;border-radius:0!important;}\nhtml{background:var(--bay);color:var(--ink);font-family:GlowSansSC,\"Songti SC\",Georgia,\"Times New Roman\",serif;font-size:16px;}\nbody{margin:0;background:var(--bay);min-width:320px;}\n.shell{width:100%;min-height:100vh;position:relative;overflow:hidden;background:var(--bay);}\n.edge{position:fixed;z-index:4;top:0;bottom:0;width:12%;background:var(--bay);pointer-events:none;}\n.edge.left{left:0;border-right:2px solid var(--phos);}\n.edge.right{right:0;border-left:2px solid var(--phos);}\n.edge:before{content:\"\";position:absolute;top:12px;bottom:0;left:calc(50% - 3px);width:3px;background:repeating-linear-gradient(to bottom,var(--phos) 0 3px,var(--bay) 3px 12px);}\n.edge.right:before{left:auto;right:calc(50% - 3px);}\n.edge:after{content:\"\";position:absolute;top:0;bottom:0;width:1px;background:var(--deep);}\n.edge.left:after{right:7px}.edge.right:after{left:7px}\n.paper{position:relative;width:66%;margin-left:12%;background:var(--paper);min-height:100vh;padding:42px 30px 64px 40px;transform:translateY(0);}\n.paper:before,.paper:after{content:\"\";position:absolute;left:0;right:0;height:1px;background:var(--tag);}\n.paper:before{top:26px}.paper:after{bottom:30px}\n.paper-inner{max-width:960px;margin:0 auto;}\n.mast{display:grid;grid-template-columns:1fr 152px;gap:28px;border-bottom:2px solid var(--ink);padding:0 0 22px;position:relative;}\n.kicker{font-family:VT323,\"Courier New\",monospace;font-size:18px;letter-spacing:.08em;margin:0 0 10px;}\nh1{font-size:clamp(50px,7.3vw,76px);line-height:.92;margin:0;letter-spacing:-.06em;font-weight:700;}\n.lede{max-width:490px;margin:18px 0 0;line-height:1.55;}\n.registry{border-left:1px solid var(--ink);padding-left:14px;align-self:end;font-family:VT323,\"Courier New\",monospace;font-variant-numeric:tabular-nums;}\n.registry strong{display:block;font-size:38px;line-height:1;color:var(--deep);}\n.registry span{display:block;margin-top:8px;font-size:15px;line-height:1.2;}\n.subhead{display:flex;justify-content:space-between;align-items:baseline;border-bottom:1px solid var(--ink);padding:10px 0 8px;font-family:VT323,\"Courier New\",monospace;font-size:17px;}\n.subhead b{font-family:GlowSansSC,\"Songti SC\",Georgia,\"Times New Roman\",serif;font-weight:400;}\n.jobs{display:grid;grid-template-columns:1.1fr .78fr 1.22fr;gap:0;border-bottom:1px solid var(--ink);}\n.job{position:relative;border-right:1px solid var(--ink);min-height:238px;padding:18px 16px 20px 0;margin-right:16px;display:flex;flex-direction:column;}\n.job:nth-child(3n){border-right:0;margin-right:0;padding-right:0;}\n.job:nth-child(n+4){min-height:218px;border-top:1px solid var(--ink);padding-top:18px;}\n.job-id{font-family:VT323,\"Courier New\",monospace;font-size:21px;letter-spacing:.04em;margin-bottom:9px;display:flex;justify-content:space-between;}\n.job-id .hand{font-family:\"Comic Sans MS\",\"Segoe Print\",cursive;font-weight:400;transform:rotate(-3deg);display:inline-block;}\n.job h2{font-size:23px;line-height:1.1;margin:0 0 9px;}\n.job p{line-height:1.45;margin:0 0 14px;max-width:33ch;}\n.job-meta{margin-top:auto;border-top:1px solid var(--tag);padding-top:9px;font-family:VT323,\"Courier New\",monospace;font-size:16px;display:flex;justify-content:space-between;gap:8px;}\n.photo{width:100%;height:78px;object-fit:cover;display:block;border:1px solid var(--ink);margin:0 0 12px;background:var(--paper);}\n.text-photo{height:78px;border:1px solid var(--ink);padding:12px;font-family:VT323,\"Courier New\",monospace;font-size:17px;line-height:1.05;margin-bottom:12px;display:flex;align-items:center;justify-content:space-between;background:var(--paper);}\n.text-photo i{font-style:normal;font-size:32px;color:var(--deep);}\n.tag{position:absolute;right:-17px;top:18px;background:var(--tag);color:var(--paper);padding:7px 8px 8px;border:1px solid var(--ink);font-family:VT323,\"Courier New\",monospace;font-size:15px;line-height:1;transform-origin:top center;}\n.tag:before{content:\"\";position:absolute;top:-15px;left:50%;width:1px;height:15px;background:var(--ink);}\n.job:hover .tag{animation:sway 240ms ease-out both;}\n@keyframes sway{0%{transform:rotate(0)}35%{transform:rotate(6deg)}70%{transform:rotate(-2deg)}100%{transform:rotate(0)}}\n.contact{display:grid;grid-template-columns:1.2fr .8fr;gap:22px;padding:20px 0 0;}\n.contact h2{font-size:30px;margin:0 0 6px;line-height:1;}\n.contact p{margin:0;line-height:1.45;}\n.phone{display:flex;align-items:end;justify-content:space-between;border-left:4px solid var(--phos);padding:0 0 0 14px;}\n.phone a{font-family:VT323,\"Courier New\",monospace;color:var(--deep);text-decoration:none;font-size:34px;line-height:1;white-space:nowrap;}\n.phone small{font-family:VT323,\"Courier New\",monospace;font-size:15px;}\n.command{margin-top:22px;border-top:2px solid var(--ink);padding-top:12px;font-family:VT323,\"Courier New\",monospace;}\n.command form{display:flex;align-items:center;gap:8px;}\n.command label{font-size:19px;white-space:nowrap;}\n.command input{flex:1;background:var(--paper);border:0;border-bottom:1px solid var(--ink);font:19px VT323,\"Courier New\",monospace;color:var(--ink);padding:5px 4px;outline:0;min-width:0;}\n.command button{background:var(--phos);color:var(--bay);border:1px solid var(--ink);font:18px VT323,\"Courier New\",monospace;padding:6px 13px;cursor:pointer;}\n.command button:focus-visible{outline:2px solid var(--ink);outline-offset:2px;}\n.output{min-height:22px;margin:8px 0 0;color:var(--deep);}\n.footer{font-family:VT323,\"Courier New\",monospace;border-top:1px solid var(--ink);margin-top:20px;padding-top:9px;display:flex;justify-content:space-between;gap:10px;font-size:15px;}\n.cursor{display:inline-block;width:8px;height:14px;background:var(--deep);vertical-align:-2px;animation:blink 530ms steps(1,end) infinite;}\n@keyframes blink{50%{visibility:hidden}}\n.paper.loaded .edge{animation:holes 160ms steps(2,end) both;}\n.job{animation:drop 40ms steps(1,end) both;}\n.job:nth-child(1){animation-delay:160ms}.job:nth-child(2){animation-delay:200ms}.job:nth-child(3){animation-delay:240ms}.job:nth-child(4){animation-delay:280ms}.job:nth-child(5){animation-delay:320ms}\n@keyframes drop{from{opacity:0;transform:translateY(-8px)}to{opacity:1;transform:translateY(0)}}\n@keyframes holes{from{opacity:0}to{opacity:1}}\n.command.sent{border-left:1px solid var(--phos);padding-left:3px;transform:translateX(3px);transition:none;}\n.command.return{transform:translateX(0);transition:transform 300ms steps(1,end);}\n@media(max-width:800px){.edge{width:6%;}.paper{width:88%;margin-left:6%;padding:30px 18px 50px 22px}.mast{grid-template-columns:1fr;gap:18px}.registry{border-left:0;border-top:1px solid var(--ink);padding:10px 0 0}.jobs{grid-template-columns:1fr 1fr}.job:nth-child(3n){border-right:1px solid var(--ink);margin-right:16px;padding-right:16px}.job:nth-child(2n){border-right:0;margin-right:0;padding-right:0}.job:nth-child(n+3){border-top:1px solid var(--ink)}.contact{grid-template-columns:1fr}.phone{align-items:start;flex-direction:column;gap:9px}.phone a{font-size:31px}}\n@media(max-width:540px){h1{font-size:52px}.jobs{display:block}.job,.job:nth-child(n),.job:nth-child(3n){border-right:0;border-top:1px solid var(--ink);margin:0;padding:16px 0;min-height:0}.job:first-child{border-top:0}.tag{right:0}.contact h2{font-size:26px}.command form{align-items:stretch;flex-wrap:wrap}.command input{flex-basis:100%}.footer{display:block;line-height:1.5}}\n@media(prefers-reduced-motion:reduce){*,*:before,*:after{animation:none!important;transition:none!important}.cursor{visibility:visible}.command.sent{transform:none}.job{opacity:1}}\n</style>\n</head>\n<body>\n<main class=\"shell\">\n<div class=\"edge left\" aria-hidden=\"true\"></div><div class=\"edge right\" aria-hidden=\"true\"></div>\n<section class=\"paper\" id=\"paper\">\n<div class=\"paper-inner\">\n<header class=\"mast\">\n<div><p class=\"kicker\">NORTHSTAR / SHOE & KEY / SERVICE DECK</p><h1>修鞋。配钥匙。<br>不让它停。</h1><p class=\"lede\">旧物送到柜台，故障写进单里。我们按到店顺序处理，不猜，不拖，把能继续用的东西交还给你。</p></div>\n<div class=\"registry\"><strong>OPEN</strong><span>受理窗口<br>09:00—19:00<br>周一至周六</span></div>\n</header>\n<div class=\"subhead\"><b>/// 当前检修单 / 05 件登记</b><span>ROLL 001—005</span></div>\n<section class=\"jobs\" aria-label=\"服务项目\">\n<article class=\"job\"><div class=\"job-id\"><span>001—<span class=\"hand\">7</span>4</span><span>SHOE</span></div><img class=\"photo\" src=\"images/占位-1.jpg\" width=\"320\" height=\"78\" alt=\"皮鞋修复示意图\"><h2>皮鞋补底</h2><p>磨穿的底，先看受力点。补底、换跟、收边，按脚下实际磨损处理。</p><div class=\"job-meta\"><span>FROM ¥ 48</span><span>约 1—2 日</span></div><div class=\"tag\">挂 00174</div></article>\n<article class=\"job\"><div class=\"job-id\"><span>002—<span class=\"hand\">3</span>1</span><span>ZIP</span></div><img class=\"photo\" src=\"images/占位-2.jpg\" width=\"320\" height=\"78\" alt=\"拉链更换示意图\"><h2>拉链更换</h2><p>卡住、脱齿、拉头断。带来原件，能配就配，不能配就整条换。</p><div class=\"job-meta\"><span>FROM ¥ 35</span><span>约 1 日</span></div><div class=\"tag\">挂 00231</div></article>\n<article class=\"job\"><div class=\"job-id\"><span>003—<span class=\"hand\">9</span>8</span><span>KEY</span></div><img class=\"photo\" src=\"images/占位-3.jpg\" width=\"320\" height=\"78\" alt=\"钥匙复制示意图\"><h2>钥匙复制</h2><p>带原钥匙来。普通门钥匙现场配，特殊齿形先测再报，不拿猜的给你。</p><div class=\"job-meta\"><span>FROM ¥ 12</span><span>约 10 分钟</span></div><div class=\"tag\">挂 00398</div></article>\n<article class=\"job\"><div class=\"job-id\"><span>004—<span class=\"hand\">5</span>6</span><span>BAG</span></div><div class=\"text-photo\" aria-label=\"包具维修文字块\"><span>HANDLE / STITCH<br>检视缝线与承重点</span><i>+</i></div><h2>包具加固</h2><p>肩带、提手、开线位置单独看。先固定，再补线，别让小裂口继续跑。</p><div class=\"job-meta\"><span>FROM ¥ 30</span><span>约 2—3 日</span></div><div class=\"tag\">挂 00456</div></article>\n<article class=\"job\"><div class=\"job-id\"><span>005—<span class=\"hand\">2</span>0</span><span>BOOT</span></div><img class=\"photo\" src=\"images/占位-5.jpg\" width=\"320\" height=\"78\" alt=\"靴子保养示意图\"><h2>靴面保养</h2><p>清洁、补色、上油分开做。颜色要稳，边缘要收，不用亮得失去原样。</p><div class=\"job-meta\"><span>FROM ¥ 45</span><span>约 2 日</span></div><div class=\"tag\">挂 00520</div></article>\n</section>\n<section class=\"contact\"><div><h2>把时间挂上来。</h2><p>电话预约即可。说清楚要修什么，我们留出工位。到店报编号，少等一轮。</p></div><div class=\"phone\"><a href=\"tel:021-5550-1978\">021—5550—1978</a><small>PHONE / 预约主线</small></div></section>\n<section class=\"command\"><form id=\"command-form\"><label for=\"command\">C:\\&gt; 预约时间</label><input id=\"command\" name=\"command\" autocomplete=\"off\" placeholder=\"输入日期与大致时段\"><button type=\"submit\">提交</button></form><p class=\"output\" id=\"output\" aria-live=\"polite\"></p></section>\n<footer class=\"footer\"><span>北端修鞋铺 / 南桥路 18 号</span><span>记录完 <span class=\"cursor\"></span></span></footer>\n</div>\n</section>\n</main>\n<script>\nconst paper=document.getElementById('paper');\nconst form=document.getElementById('command-form');\nconst input=document.getElementById('command');\nconst output=document.getElementById('output');\npaper.classList.add('loaded');\nform.addEventListener('submit',function(event){\n event.preventDefault();\n const value=input.value.trim();\n output.textContent=value?'[已登记] '+value+' / 请拨 021—5550—1978 确认':'[等待输入] 请写日期与大致时段';\n form.parentElement.classList.remove('return');\n form.parentElement.classList.add('sent');\n window.setTimeout(function(){form.parentElement.classList.add('return');},300);\n});\n</script>\n</body>\n</html>\n"
        }
      }
    }
