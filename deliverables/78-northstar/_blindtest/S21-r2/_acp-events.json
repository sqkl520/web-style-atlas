        "content": {
          "type": "text",
          "text": " <!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>联锁释放簿｜修鞋与配钥匙</title>\n  <style>\n    @import url(\"https://fonts.googleapis.com/css2?family=Antonio:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500;600&display=swap\");\n\n    :root {\n      --ink: #3E3A34;\n      --paper: #E4DCC9;\n      --amber: #924307;\n      --fibre: #6E6A5E;\n      --white: #FFFFFF;\n      --line: 1px;\n      --strong-line: 2px;\n      --mono: \"IBM Plex Mono\", monospace;\n      --title: Antonio, \"WenJin Mincho\", Georgia, \"Songti SC\", serif;\n      --body: \"WenJin Mincho\", Georgia, \"Songti SC\", STSong, serif;\n    }\n\n    * {\n      box-sizing: border-box;\n      border-radius: 0;\n    }\n\n    html {\n      scroll-behavior: auto;\n      background: var(--paper);\n    }\n\n    body {\n      margin: 0;\n      min-width: 320px;\n      color: var(--ink);\n      background: var(--paper);\n      font-family: var(--body);\n      font-size: 16px;\n      line-height: 1.45;\n      cursor: text;\n    }\n\n    body::before {\n      content: \"\";\n      position: fixed;\n      inset: 0;\n      pointer-events: none;\n      border: var(--line) solid var(--ink);\n      z-index: 20;\n    }\n\n    .sheet {\n      position: relative;\n      max-width: 1560px;\n      margin: 0 auto;\n      padding: 36px 42px 48px;\n      overflow: hidden;\n    }\n\n    .sheet::after {\n      content: \"\";\n      position: fixed;\n      width: 1px;\n      height: 18px;\n      left: 18px;\n      top: 50%;\n      background: var(--ink);\n      animation: caret 1200ms steps(1) infinite;\n      pointer-events: none;\n    }\n\n    @keyframes caret {\n      0%, 48% { opacity: 1; }\n      49%, 100% { opacity: 0; }\n    }\n\n    .topline {\n      display: flex;\n      justify-content: space-between;\n      align-items: flex-start;\n      gap: 24px;\n      border-bottom: var(--strong-line) solid var(--ink);\n      padding-bottom: 14px;\n      margin-bottom: 28px;\n    }\n\n    .masthead {\n      display: flex;\n      align-items: baseline;\n      gap: 18px;\n      flex-wrap: wrap;\n    }\n\n    .kicker,\n    .micro,\n    .mono,\n    .service-code,\n    .service-price,\n    .bar-id,\n    .stamp,\n    .phone-label {\n      font-family: var(--mono);\n      font-variant-numeric: tabular-nums;\n    }\n\n    .kicker {\n      font-size: 11px;\n      letter-spacing: .13em;\n      text-transform: uppercase;\n    }\n\n    .record {\n      font-family: var(--mono);\n      font-size: 11px;\n      letter-spacing: .08em;\n      text-align: right;\n      white-space: nowrap;\n    }\n\n    .hero {\n      display: grid;\n      grid-template-columns: minmax(0, 1.58fr) minmax(260px, .82fr);\n      gap: 34px;\n      align-items: end;\n      margin-bottom: 32px;\n    }\n\n    h1 {\n      margin: 0;\n      max-width: 900px;\n      font-family: var(--title);\n      font-size: clamp(58px, 8.3vw, 86px);\n      font-weight: 500;\n      letter-spacing: -.045em;\n      line-height: .92;\n    }\n\n    .hero-note {\n      border-left: var(--strong-line) solid var(--amber);\n      padding: 5px 0 5px 18px;\n      max-width: 360px;\n    }\n\n    .hero-note p {\n      margin: 0;\n      font-size: 18px;\n      line-height: 1.28;\n    }\n\n    .hero-note .micro {\n      display: block;\n      margin-top: 16px;\n      color: var(--amber);\n      font-size: 11px;\n      letter-spacing: .08em;\n    }\n\n    .time-rule {\n      display: grid;\n      grid-template-columns: repeat(12, 1fr);\n      gap: 0;\n      border-top: var(--line) solid var(--ink);\n      border-bottom: var(--line) solid var(--ink);\n      margin-bottom: 28px;\n    }\n\n    .time-rule span {\n      min-height: 25px;\n      padding: 5px 8px 4px;\n      border-right: var(--line) solid var(--ink);\n      font-family: var(--mono);\n      font-size: 10px;\n      letter-spacing: .05em;\n      text-align: center;\n    }\n\n    .time-rule span:first-child {\n      border-left: var(--line) solid var(--ink);\n    }\n\n    .ledger {\n      display: grid;\n      grid-template-columns: minmax(0, 1.08fr) minmax(0, .92fr);\n      gap: 26px;\n      align-items: start;\n    }\n\n    .column {\n      min-width: 0;\n    }\n\n    .column-heading {\n      display: flex;\n      align-items: baseline;\n      justify-content: space-between;\n      gap: 16px;\n      padding: 9px 12px 8px;\n      border: var(--line) solid var(--ink);\n      border-bottom: var(--strong-line) solid var(--ink);\n      margin-bottom: 14px;\n    }\n\n    .column-heading h2 {\n      margin: 0;\n      font-family: var(--title);\n      font-size: 25px;\n      font-weight: 500;\n      line-height: 1;\n    }\n\n    .column-heading span {\n      color: var(--fibre);\n      font-family: var(--mono);\n      font-size: 10px;\n      letter-spacing: .07em;\n      white-space: nowrap;\n    }\n\n    .services {\n      display: grid;\n      gap: 10px;\n    }\n\n    .service {\n      display: grid;\n      grid-template-columns: 72px minmax(0, 1fr) 94px;\n      min-height: 150px;\n      border: var(--line) solid var(--ink);\n      position: relative;\n      overflow: hidden;\n      background: var(--paper);\n      box-shadow: inset 0 0 0 1px var(--paper);\n    }\n\n    .service:nth-child(2) {\n      grid-template-columns: 58px minmax(0, 1fr) 122px;\n      min-height: 170px;\n    }\n\n    .service:nth-child(3) {\n      grid-template-columns: 88px minmax(0, 1fr) 82px;\n      min-height: 138px;\n    }\n\n    .service:nth-child(4) {\n      grid-template-columns: 64px minmax(0, 1fr) 108px;\n      min-height: 160px;\n    }\n\n    .service:nth-child(5) {\n      grid-template-columns: 78px minmax(0, 1fr) 96px;\n      min-height: 145px;\n    }\n\n    .service-code {\n      padding: 12px 9px;\n      border-right: var(--line) solid var(--ink);\n      font-size: 13px;\n      letter-spacing: .04em;\n      writing-mode: vertical-rl;\n      text-orientation: mixed;\n    }\n\n    .service-body {\n      padding: 13px 16px 15px;\n    }\n\n    .service-body h3 {\n      margin: 0 0 8px;\n      font-family: var(--title);\n      font-size: 25px;\n      font-weight: 500;\n      line-height: 1;\n    }\n\n    .service-body p {\n      margin: 0;\n      max-width: 36em;\n      font-size: 15px;\n      line-height: 1.48;\n    }\n\n    .service-side {\n      display: flex;\n      flex-direction: column;\n      justify-content: space-between;\n      align-items: flex-end;\n      padding: 12px 11px;\n      border-left: var(--line) solid var(--ink);\n      text-align: right;\n    }\n\n    .service-price {\n      font-size: 13px;\n      color: var(--amber);\n      white-space: nowrap;\n    }\n\n    .service-note {\n      font-family: var(--mono);\n      font-size: 10px;\n      line-height: 1.35;\n      color: var(--fibre);\n    }\n\n    .image-grid {\n      display: grid;\n      grid-template-columns: 1.15fr .85fr;\n      gap: 10px;\n      margin-top: 14px;\n    }\n\n    .image-slot,\n    .text-slot {\n      border: var(--line) solid var(--ink);\n      min-height: 166px;\n      background: var(--paper);\n      overflow: hidden;\n    }\n\n    .image-slot:nth-child(2) {\n      min-height: 205px;\n    }\n\n    .image-slot:nth-child(3) {\n      min-height: 135px;\n    }\n\n    .image-slot img {\n      display: block;\n      width: 100%;\n      height: 100%;\n      min-height: inherit;\n      object-fit: cover;\n      background: var(--paper);\n      border: 0;\n    }\n\n    .text-slot {\n      display: flex;\n      flex-direction: column;\n      justify-content: space-between;\n      padding: 15px;\n    }\n\n    .text-slot strong {\n      font-family: var(--title);\n      font-size: 24px;\n      font-weight: 500;\n      line-height: 1;\n    }\n\n    .text-slot p {\n      margin: 0;\n      font-size: 14px;\n      line-height: 1.45;\n    }\n\n    .text-slot .stamp {\n      color: var(--amber);\n      font-size: 11px;\n      letter-spacing: .06em;\n    }\n\n    .release-panel {\n      margin-top: 14px;\n      border: var(--line) solid var(--ink);\n      padding: 16px 16px 18px;\n    }\n\n    .release-header {\n      display: flex;\n      justify-content: space-between;\n      align-items: baseline;\n      gap: 12px;\n      padding-bottom: 13px;\n      border-bottom: var(--line) solid var(--ink);\n    }\n\n    .release-header h2 {\n      margin: 0;\n      font-family: var(--title);\n      font-size: 25px;\n      font-weight: 500;\n      line-height: 1;\n    }\n\n    .release-header span {\n      font-family: var(--mono);\n      color: var(--fibre);\n      font-size: 10px;\n      letter-spacing: .08em;\n    }\n\n    .lock-path {\n      display: flex;\n      flex-direction: column;\n      gap: 1px;\n      padding: 18px 0 8px;\n      counter-reset: lock;\n    }\n\n    .lock-bar {\n      --cut: 45deg;\n      position: relative;\n      display: grid;\n      grid-template-columns: 58px minmax(0, 1fr) 80px;\n      align-items: center;\n      width: calc(100% - var(--drift, 0px));\n      min-height: 32px;\n      padding: 0 10px 0 0;\n      color: var(--ink);\n      background: var(--ink);\n      clip-path: polygon(0 0, calc(100% - 13px) 0, 100% 50%, calc(100% - 13px) 100%, 0 100%);\n      box-shadow: inset 0 0 0 1px var(--ink);\n      transform-origin: left center;\n      transform: translateX(0);\n    }\n\n    .lock-bar::before {\n      content: \"\";\n      position: absolute;\n      inset: 1px 2px 1px 1px;\n      background: var(--paper);\n      clip-path: polygon(0 0, calc(100% - 13px) 0, 100% 50%, calc(100% - 13px) 100%, 0 100%);\n      z-index: 0;\n    }\n\n    .lock-bar::after {\n      content: \"\";\n      position: absolute;\n      width: 1.5px;\n      height: 1.5px;\n      right: calc(15px - var(--drift, 0px));\n      bottom: calc(4px - var(--drift, 0px));\n      background: var(--ink);\n      z-index: 2;\n    }\n\n    .lock-bar > * {\n      position: relative;\n      z-index: 1;\n    }\n\n    .lock-bar[data-angle=\"30\"] {\n      --cut: 30deg;\n      clip-path: polygon(0 0, calc(100% - 13px) 0, 100% 50%, calc(100% - 13px) 100%, 0 100%);\n    }\n\n    .lock-bar[data-angle=\"45\"] {\n      --cut: 45deg;\n    }\n\n    .lock-bar[data-angle=\"60\"] {\n      --cut: 60deg;\n      clip-path: polygon(0 0, calc(100% - 13px) 0, 100% 50%, calc(100% - 13px) 100%, 0 100%);\n    }\n\n    .bar-id {\n      padding-left: 11px;\n      font-size: 11px;\n      letter-spacing: .04em;\n    }\n\n    .bar-text {\n      padding-left: 13px;\n      font-size: 14px;\n      line-height: 1;\n      border-left: var(--line) solid var(--ink);\n      white-space: nowrap;\n      overflow: hidden;\n      text-overflow: ellipsis;\n    }\n\n    .bar-angle {\n      font-family: var(--mono);\n      font-size: 10px;\n      text-align: right;\n      letter-spacing: .04em;\n    }\n\n    .lock-bar[data-conflict=\"true\"] {\n      cursor: crosshair;\n    }\n\n    .lock-bar.is-active,\n    .lock-bar.is-conflict {\n      outline: var(--line) solid var(--amber);\n      outline-offset: -1px;\n    }\n\n    .lock-bar.is-ready {\n      animation: seat 70ms steps(1) forwards;\n    }\n\n    @keyframes seat {\n      from { transform: translateX(9px); }\n      to { transform: translateX(0); }\n    }\n\n    .release-foot {\n      display: flex;\n      justify-content: space-between;\n      gap: 20px;\n      border-top: var(--line) solid var(--ink);\n      padding-top: 12px;\n      margin-top: 9px;\n      font-family: var(--mono);\n      font-size: 10px;\n      line-height: 1.4;\n    }\n\n    .release-foot strong {\n      color: var(--amber);\n      font-weight: 500;\n    }\n\n    .cta {\n      display: grid;\n      grid-template-columns: minmax(0, 1fr) auto;\n      gap: 24px;\n      align-items: center;\n      margin-top: 28px;\n      padding: 17px 19px;\n      border: var(--strong-line) solid var(--ink);\n      box-shadow: inset 0 0 0 1px var(--paper);\n    }\n\n    .cta-copy h2 {\n      margin: 0 0 5px;\n      font-family: var(--title);\n      font-size: 29px;\n      font-weight: 500;\n      line-height: 1;\n    }\n\n    .cta-copy p {\n      margin: 0;\n      font-size: 14px;\n    }\n\n    .phone {\n      display: inline-flex;\n      flex-direction: column;\n      align-items: flex-end;\n      min-width: 230px;\n      padding: 10px 14px 9px;\n      color: var(--white);\n      background: var(--amber);\n      border: var(--line) solid var(--ink);\n      text-decoration: none;\n      box-shadow: inset 0 0 0 1px var(--amber);\n    }\n\n    .phone-label {\n      color: var(--white);\n      font-size: 10px;\n      letter-spacing: .09em;\n    }\n\n    .phone-number {\n      font-family: var(--mono);\n      font-size: 25px;\n      line-height: 1.05;\n      letter-spacing: .02em;\n    }\n\n    footer {\n      display: flex;\n      justify-content: space-between;\n      gap: 18px;\n      margin-top: 22px;\n      padding-top: 12px;\n      border-top: var(--line) solid var(--ink);\n      color: var(--fibre);\n      font-family: var(--mono);\n      font-size: 10px;\n      letter-spacing: .04em;\n    }\n\n    .number-plate {\n      display: inline-block;\n      min-width: 38px;\n      padding: 5px 7px;\n      border: var(--line) solid var(--ink);\n      box-shadow: inset 0 2px 0 var(--fibre), inset 0 -2px 0 var(--paper);\n      font-family: var(--mono);\n      font-size: 12px;\n      text-align: center;\n      cursor: pointer;\n      user-select: none;\n      transform-style: preserve-3d;\n    }\n\n    .number-plate.flip {\n      animation: flip 140ms steps(1);\n    }\n\n    @keyframes flip {\n      0% { transform: rotateY(0); }\n      50% { transform: rotateY(90deg); }\n      100% { transform: rotateY(0); }\n    }\n\n    @media (max-width: 900px) {\n      .sheet {\n        padding: 25px 24px 36px;\n      }\n\n      .hero,\n      .ledger {\n        grid-template-columns: 1fr;\n      }\n\n      .hero-note {\n        max-width: none;\n      }\n\n      .image-grid {\n        grid-template-columns: 1fr 1fr;\n      }\n    }\n\n    @media (max-width: 620px) {\n      .sheet {\n        padding: 20px 16px 30px;\n      }\n\n      .topline,\n      footer {\n        align-items: flex-start;\n        flex-direction: column;\n      }\n\n      .record {\n        text-align: left;\n      }\n\n      h1 {\n        font-size: clamp(54px, 17vw, 76px);\n      }\n\n      .time-rule {\n        grid-template-columns: repeat(6, 1fr);\n      }\n\n      .time-rule span:nth-child(n + 7) {\n        display: none;\n      }\n\n      .service,\n      .service:nth-child(n) {\n        grid-template-columns: 48px minmax(0, 1fr);\n        min-height: 0;\n      }\n\n      .service-side {\n        grid-column: 2;\n        flex-direction: row;\n        align-items: baseline;\n        border-left: 0;\n        border-top: var(--line) solid var(--ink);\n        padding: 8px 12px;\n        text-align: left;\n      }\n\n      .service-code {\n        grid-row: 1 / span 2;\n        padding-left: 7px;\n        padding-right: 7px;\n      }\n\n      .service-body {\n        padding: 13px 12px;\n      }\n\n      .service-body h3 {\n        font-size: 22px;\n      }\n\n      .image-grid {\n        grid-template-columns: 1fr;\n      }\n\n      .image-slot,\n      .image-slot:nth-child(n),\n      .text-slot {\n        min-height: 190px;\n      }\n\n      .lock-bar {\n        grid-template-columns: 48px minmax(0, 1fr) 62px;\n      }\n\n      .bar-text {\n        padding-left: 8px;\n        font-size: 12px;\n      }\n\n      .cta {\n        grid-template-columns: 1fr;\n      }\n\n      .phone {\n        align-items: flex-start;\n        width: 100%;\n        min-width: 0;\n      }\n    }\n\n    @media (prefers-reduced-motion: reduce) {\n      html {\n        scroll-behavior: auto;\n      }\n\n      *,\n      *::before,\n      *::after {\n        animation-duration: 0.01ms !important;\n        animation-iteration-count: 1 !important;\n        transition-duration: 0.01ms !important;\n      }\n\n      .sheet::after {\n        animation: none;\n      }\n\n      .lock-bar {\n        transform: none;\n      }\n    }\n  </style>\n</head>\n<body>\n  <main class=\"sheet\">\n    <header class=\"topline\">\n      <div class=\"masthead\">\n        <span class=\"kicker\">值班台 / 释放簿</span>\n        <span class=\"kicker\">鞋履 · 钥匙 · 小件修复</span>\n      </div>\n      <div class=\"record\">记录号 S21-KEY / 现场接单<br>营业时间 09:00—19:00</div>\n    </header>\n\n    <section class=\"hero\" aria-labelledby=\"page-title\">\n      <div>\n        <h1 id=\"page-title\">先解除<br>再交件。</h1>\n      </div>\n      <div class=\"hero-note\">\n        <p>每一件东西都有它的锁别。把需求说清，时间就能放行。</p>\n        <span class=\"micro\">不接模糊指令。先电话确认。</span>\n      </div>\n    </section>\n\n    <div class=\"time-rule\" aria-label=\"营业时间刻线\">\n      <span>09</span>\n      <span>10</span>\n      <span>11</span>\n      <span>12</span>\n      <span>13</span>\n      <span>14</span>\n      <span>15</span>\n      <span>16</span>\n      <span>17</span>\n      <span>18</span>\n      <span>19</span>\n      <span>关</span>\n    </div>\n\n    <section class=\"ledger\" aria-label=\"修鞋与配钥匙服务台\">\n      <div class=\"column\">\n        <div class=\"column-heading\">\n          <h2>左栏 / 受理项目</h2>\n          <span>条目 05</span>\n        </div>\n\n        <div class=\"services\">\n          <article class=\"service\">\n            <div class=\"service-code\">01 / 鞋底</div>\n            <div class=\"service-body\">\n              <h3>鞋底更换</h3>\n              <p>旧底先拆，鞋面再检。适合磨穿、开胶、踩空的日常鞋。</p>\n            </div>\n            <div class=\"service-side\">\n              <span class=\"service-price\">￥80 起</span>\n              <span class=\"service-note\">依鞋型<br>现场判定</span>\n            </div>\n          </article>\n\n          <article class=\"service\">\n            <div class=\"service-code\">02 / 鞋跟</div>\n            <div class=\"service-body\">\n              <h3>鞋跟修复</h3>\n              <p>高跟、皮鞋、工作鞋均可。先固定受力点，再处理外层磨损。</p>\n            </div>\n            <div class=\"service-side\">\n              <span class=\"service-price\">￥35 起</span>\n              <span class=\"service-note\">当日可取<br>需先看实物</span>\n            </div>\n          </article>\n\n          <article class=\"service\">\n            <div class=\"service-code\">03 / 拉链</div>\n            <div class=\"service-body\">\n              <h3>拉链与缝线</h3>\n              <p>不硬拽。拉头、齿口、开线位置分开处理，避免二次损伤。</p>\n            </div>\n            <div class=\"service-side\">\n              <span class=\"service-price\">￥25 起</span>\n              <span class=\"service-note\">小件优先<br>可预约</span>\n            </div>\n          </article>\n\n          <article class=\"service\">\n            <div class=\"service-code\">04 / 配钥</div>\n            <div class=\"service-body\">\n              <h3>普通钥匙复制</h3>\n              <p>带原钥匙来。锁芯磨损、齿形不清的，先试配再决定是否放行。</p>\n            </div>\n            <div class=\"service-side\">\n              <span class=\"service-price\">￥10 起</span>\n              <span class=\"service-note\">普通民用<br>现场确认</span>\n            </div>\n          </article>\n\n          <article class=\"service\">\n            <div class=\"service-code\">05 / 门禁</div>\n            <div class=\"service-body\">\n              <h3>门禁扣复制</h3>\n              <p>携原扣到台。不同系统读写方式不同，电话里先确认型号与数量。</p>\n            </div>\n            <div class=\"service-side\">\n              <span class=\"service-price\">￥30 起</span>\n              <span class=\"service-note\">需留号<br>不接猜测</span>\n            </div>\n          </article>\n        </div>\n      </div>\n\n      <div class=\"column\">\n        <div class=\"column-heading\">\n          <h2>右栏 / 留痕与释放</h2>\n          <span>锁闭路径 14 格</span>\n        </div>\n\n        <div class=\"image-grid\" aria-label=\"现场图片位\">\n          <figure class=\"image-slot\">\n            <img src=\"images/占位-1.jpg\" width=\"640\" height=\"420\" alt=\"修鞋工具与工作台\">\n          </figure>\n          <figure class=\"image-slot\">\n            <img src=\"images/占位-2.jpg\" width=\"480\" height=\"560\" alt=\"鞋底修复细节\">\n          </figure>\n          <figure class=\"image-slot\">\n            <img src=\"images/占位-3.jpg\" width=\"640\" height=\"360\" alt=\"钥匙复制台\">\n          </figure>\n          <figure class=\"image-slot\">\n            <img src=\"images/占位-4.jpg\" width=\"480\" height=\"360\" alt=\"皮革与缝线细节\">\n          </figure>\n          <figure class=\"image-slot\">\n            <img src=\"images/占位-5.jpg\" width=\"640\" height=\"420\" alt=\"钥匙坯与编号牌\">\n          </figure>\n          <div class=\"text-slot\">\n            <span class=\"stamp\">现场规则 / 05</span>\n            <strong>先看实物，<br>再报时间。</strong>\n            <p>电话预约只锁定到店时刻，不替代现场判定。</p>\n          </div>\n        </div>\n\n        <section class=\"release-panel\" id=\"release-path\">\n          <div class=\"release-header\">\n            <h2>释放路径</h2>\n            <span>扣接顺序 / 01—14</span>\n          </div>\n\n          <div class=\"lock-path\">\n            <div class=\"lock-bar\" data-angle=\"30\" data-group=\"a\" style=\"--drift:0px\">\n              <span class=\"bar-id\">01</span><span class=\"bar-text\">报项目</span><span class=\"bar-angle\">30° / 01</span>\n            </div>\n            <div class=\"lock-bar\" data-angle=\"45\" data-group=\"b\" style=\"--drift:.25px\">\n              <span class=\"bar-id\">02</span><span class=\"bar-text\">报数量</span><span class=\"bar-angle\">45° / 02</span>\n            </div>\n            <div class=\"lock-bar\" data-angle=\"60\" data-group=\"c\" style=\"--drift:.5px\">\n              <span class=\"bar-id\">03</span><span class=\"bar-text\">报原件状态</span><span class=\"bar-angle\">60° / 03</span>\n            </div>\n            <div class=\"lock-bar\" data-angle=\"30\" data-group=\"a\" style=\"--drift:.75px\">\n              <span class=\"bar-id\">04</span><span class=\"bar-text\">确认是否带原件</span><span class=\"bar-angle\">30° / 04</span>\n            </div>\n            <div class=\"lock-bar\" data-angle=\"45\" data-group=\"b\" style=\"--drift:1px\">\n              <span class=\"bar-id\">05</span><span class=\"bar-text\">登记称呼</span><span class=\"bar-angle\">45° / 05</span>\n            </div>\n            <div class=\"lock-bar\" data-angle=\"60\" data-group=\"c\" style=\"--drift:1.25px\">\n              <span class=\"bar-id\">06</span><span class=\"bar-text\">锁定来店时刻</span><span class=\"bar-angle\">60° / 06</span>\n            </div>\n            <div class=\"lock-bar\" data-angle=\"30\" data-group=\"a\" style=\"--drift:1.5px\">\n              <span class=\"bar-id\">07</span><span class=\"bar-text\">到店复核</span><span class=\"bar-angle\">30° / 07</span>\n            </div>\n            <div class=\"lock-bar\" data-angle=\"45\" data-group=\"b\" style=\"--drift:1.75px\">\n              <span class=\"bar-id\">08</span><span class=\"bar-text\">确认报价</span><span class=\"bar-angle\">45° / 08</span>\n            </div>\n            <div class=\"lock-bar\" data-angle=\"60\" data-group=\"c\" style=\"--drift:2px\">\n              <span class=\"bar-id\">09</span><span class=\"bar-text\">确认工序</span><span class=\"bar-angle\">60° / 09</span>\n            </div>\n            <div class=\"lock-bar\" data-angle=\"30\" data-group=\"a\" style=\"--drift:2.25px\">\n              <span class=\"bar-id\">10</span><span class=\"bar-text\">开始处理</span><span class=\"bar-angle\">30° / 10</span>\n            </div>\n            <div class=\"lock-bar\" data-angle=\"45\" data-group=\"b\" style=\"--drift:2.5px\">\n              <span class=\"bar-id\">11</span><span class=\"bar-text\">中途不改件</span><span class=\"bar-angle\">45° / 11</span>\n            </div>\n            <div class=\"lock-bar\" data-angle=\"60\" data-group=\"c\" style=\"--drift:2.75px\">\n              <span class=\"bar-id\">12</span><span class=\"bar-text\">完成检视</span><span class=\"bar-angle\">60° / 12</span>\n            </div>\n            <div class=\"lock-bar\" data-angle=\"30\" data-group=\"a\" style=\"--drift:3px\">\n              <span class=\"bar-id\">13</span><span class=\"bar-text\">电话通知</span><span class=\"bar-angle\">30° / 13</span>\n            </div>\n            <div class=\"lock-bar\" data-angle=\"45\" data-group=\"b\" style=\"--drift:3.5px\">\n              <span class=\"bar-id\">14</span><span class=\"bar-text\">交件，路径关闭</span><span class=\"bar-angle\">45° / 14</span>\n            </div>\n          </div>\n\n          <div class=\"release-foot\">\n            <span><strong>互斥：</strong>同组条目不可同时改动。</span>\n            <span>切口 30° / 45° / 60°</span>\n          </div>\n        </section>\n      </div>\n    </section>\n\n    <section class=\"cta\" aria-label=\"电话预约\">\n      <div class=\"cta-copy\">\n        <h2>要预约，直接打电话。</h2>\n        <p>说清楚要修什么、几件、什么时候到。其余的，到台上处理。</p>\n      </div>\n      <a class=\"phone\" href=\"tel:02168091234\">\n        <span class=\"phone-label\">值班台 / 电话预约</span>\n        <span class=\"phone-number\">021 6809 1234</span>\n      </a>\n    </section>\n\n    <footer>\n      <span>联锁释放簿 / 鞋钥小店 / S21</span>\n      <span>无预约不承诺时刻 · 到店以实物为准</span>\n      <span class=\"number-plate\" role=\"button\" tabindex=\"0\" aria-label=\"翻转道岔号牌\">S21</span>\n    </footer>\n  </main>\n\n  <script>\n    (() => {\n      const path = document.querySelector(\"#release-path\");\n      const bars = [...document.querySelectorAll(\".lock-bar\")];\n      const reduced = window.matchMedia(\"(prefers-reduced-motion: reduce)\").matches;\n\n      const seatBars = () => {\n        bars.forEach((bar, index) => {\n          window.setTimeout(() => bar.classList.add(\"is-ready\"), index * 70);\n        });\n      };\n\n      if (reduced) {\n        bars.forEach(bar => bar.classList.add(\"is-ready\"));\n      } else if (\"IntersectionObserver\" in window) {\n        const observer = new IntersectionObserver((entries, instance) => {\n          if (entries.some(entry => entry.isIntersecting)) {\n            seatBars();\n            instance.disconnect();\n          }\n        }, { threshold: 0.2 });\n        observer.observe(path);\n      } else {\n        seatBars();\n      }\n\n      bars.forEach(bar => {\n        bar.addEventListener(\"mouseenter\", () => {\n          const group = bar.dataset.group;\n          bars.forEach(other => {\n            if (other.dataset.group === group) {\n              other.classList.add(other === bar ? \"is-active\" : \"is-conflict\");\n            }\n          });\n        });\n\n        bar.addEventListener(\"mouseleave\", () => {\n          bars.forEach(other => {\n            other.classList.remove(\"is-active\", \"is-conflict\");\n          });\n        });\n      });\n\n      const plate = document.querySelector(\".number-plate\");\n      const flipPlate = () => {\n        plate.classList.remove(\"flip\");\n        void plate.offsetWidth;\n        plate.classList.add(\"flip\");\n        plate.textContent = plate.textContent === \"S21\" ? \"L14\" : \"S21\";\n        window.setTimeout(() => {\n          plate.classList.remove(\"flip\");\n          plate.textContent = \"S21\";\n        }, 140);\n      };\n\n      plate.addEventListener(\"click\", flipPlate);\n      plate.addEventListener(\"keydown\", event => {\n        if (event.key === \"Enter\" || event.key === \" \") {\n          event.preventDefault();\n          flipPlate();\n        }\n      });\n    })();\n  </script>\n</body>\n</html>"
        }
      }
    }
  },
