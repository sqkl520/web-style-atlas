        "messageId": "2acdedf9-22b9-4575-aea3-777b6e2ab0a6",
        "content": {
          "type": "text",
          "text": " <!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>鞋底和钥匙，先把时间约好</title>\n  <style>\n    :root {\n      --graphite: #3A3F45;\n      --paper: #E7EBE9;\n      --press: #22282B;\n      --pencil: #7A7466;\n      --line: 0.8px;\n      --strong-line: 1.2px;\n      --heavy-line: 2px;\n      --serif-title: \"Newsreader\", \"Noto Serif SC\", Georgia, serif;\n      --serif-body: \"Noto Serif SC\", \"Newsreader\", Georgia, serif;\n      --mono: \"Reddit Mono\", monospace;\n    }\n\n    * {\n      box-sizing: border-box;\n      border-radius: 0 !important;\n    }\n\n    html {\n      background: var(--paper);\n      color: var(--graphite);\n      font-size: 16px;\n    }\n\n    body {\n      margin: 0;\n      min-width: 320px;\n      background: var(--paper);\n      color: var(--graphite);\n      font-family: var(--serif-body);\n      line-height: 1.45;\n      cursor: crosshair;\n    }\n\n    body::before,\n    body::after {\n      content: \"\";\n      position: fixed;\n      pointer-events: none;\n      z-index: 20;\n    }\n\n    body::before {\n      width: 24px;\n      height: 24px;\n      left: var(--cursor-x, -40px);\n      top: var(--cursor-y, -40px);\n      transform: translate(-50%, -50%);\n      border: 0.5px solid var(--pencil);\n    }\n\n    body::after {\n      width: 24px;\n      height: 0.5px;\n      left: var(--cursor-x, -40px);\n      top: var(--cursor-y, -40px);\n      transform: translate(-50%, -50%);\n      background: var(--pencil);\n      box-shadow: 0 -12px 0 -0.25px var(--pencil), 0 12px 0 -0.25px var(--pencil);\n    }\n\n    body.zone-cursor::before {\n      border-style: dashed;\n    }\n\n    a {\n      color: inherit;\n    }\n\n    .site-frame {\n      min-height: 100vh;\n      padding: 28px 40px 24px;\n      overflow: hidden;\n    }\n\n    .masthead {\n      display: grid;\n      grid-template-columns: repeat(12, minmax(0, 1fr));\n      gap: 16px;\n      align-items: start;\n      border-top: var(--heavy-line) solid var(--graphite);\n      padding-top: 12px;\n      margin-bottom: 24px;\n    }\n\n    .masthead-mark {\n      grid-column: 1 / span 2;\n      font-family: var(--mono);\n      font-size: 12px;\n      letter-spacing: 0.05em;\n      line-height: 1.2;\n    }\n\n    .masthead-note {\n      grid-column: 9 / -1;\n      border-left: var(--line) solid var(--pencil);\n      padding-left: 12px;\n      color: var(--pencil);\n      font-size: 13px;\n      line-height: 1.35;\n    }\n\n    .layout {\n      display: grid;\n      grid-template-columns: repeat(12, minmax(0, 1fr));\n      gap: 16px;\n      align-items: start;\n    }\n\n    .plan-wrap {\n      grid-column: 1 / span 8;\n      margin-left: -40px;\n      min-width: 0;\n    }\n\n    .plan-heading {\n      display: flex;\n      justify-content: space-between;\n      align-items: end;\n      padding: 0 0 11px 40px;\n      border-bottom: var(--line) solid var(--graphite);\n    }\n\n    .plan-heading h1 {\n      max-width: 780px;\n      margin: 0;\n      color: var(--press);\n      font-family: var(--serif-title);\n      font-size: clamp(52px, 7.2vw, 92px);\n      font-weight: 400;\n      letter-spacing: -0.055em;\n      line-height: 0.88;\n    }\n\n    .plan-heading .registration {\n      flex: 0 0 auto;\n      margin-left: 20px;\n      color: var(--pencil);\n      font-family: var(--mono);\n      font-size: 12px;\n      text-align: right;\n      white-space: nowrap;\n    }\n\n    .plan {\n      position: relative;\n      height: 650px;\n      margin-top: 14px;\n      background: var(--paper);\n      border-top: var(--strong-line) solid var(--graphite);\n      border-bottom: var(--strong-line) solid var(--graphite);\n      transform-origin: top left;\n      transition: transform 600ms cubic-bezier(0.25, 0.8, 0.35, 1);\n      isolation: isolate;\n    }\n\n    .plan.is-shrunk {\n      transform: scale(0.68);\n    }\n\n    .sheet {\n      position: absolute;\n      inset: 0;\n      pointer-events: none;\n      background: var(--paper);\n      animation: place-sheet 220ms linear both;\n    }\n\n    .sheet svg {\n      display: block;\n      width: 100%;\n      height: 100%;\n    }\n\n    .sheet--1934 {\n      z-index: 1;\n      animation-delay: 0ms;\n    }\n\n    .sheet--1936 {\n      z-index: 2;\n      transform: translate(3px, 1px);\n      animation-delay: 220ms;\n    }\n\n    .sheet--1938 {\n      z-index: 3;\n      transform: translate(7px, 3px);\n      opacity: 0.56;\n      animation-delay: 440ms;\n    }\n\n    .sheet path,\n    .sheet line,\n    .sheet polyline,\n    .sheet rect,\n    .sheet circle {\n      vector-effect: non-scaling-stroke;\n    }\n\n    .sheet--1934 path,\n    .sheet--1934 line,\n    .sheet--1934 polyline,\n    .sheet--1934 rect,\n    .sheet--1934 circle {\n      stroke: var(--graphite);\n    }\n\n    .sheet--1936 path,\n    .sheet--1936 line,\n    .sheet--1936 polyline,\n    .sheet--1936 rect,\n    .sheet--1936 circle {\n      stroke: var(--pencil);\n    }\n\n    .sheet--1938 path,\n    .sheet--1938 line,\n    .sheet--1938 polyline,\n    .sheet--1938 rect,\n    .sheet--1938 circle {\n      stroke: var(--press);\n    }\n\n    .map-grid {\n      position: absolute;\n      inset: 0;\n      z-index: 4;\n      pointer-events: none;\n      background-image:\n        linear-gradient(to right, var(--pencil) 0.5px, transparent 0.5px),\n        linear-gradient(to bottom, var(--pencil) 0.5px, transparent 0.5px);\n      background-size: 84px 84px;\n      opacity: 0.12;\n    }\n\n    .zone {\n      position: absolute;\n      z-index: 5;\n      display: flex;\n      flex-direction: column;\n      justify-content: space-between;\n      min-width: 88px;\n      padding: 10px;\n      border: var(--line) solid var(--pencil);\n      background: var(--paper);\n      color: var(--press);\n      cursor: pointer;\n      transition: border-width 140ms ease;\n    }\n\n    .zone:hover,\n    .zone:focus-visible {\n      border-width: 1.2px;\n      outline: none;\n    }\n\n    .zone::after {\n      content: attr(data-reg);\n      position: absolute;\n      right: 8px;\n      bottom: 8px;\n      color: var(--pencil);\n      font-family: var(--mono);\n      font-size: 10px;\n      letter-spacing: 0.02em;\n    }\n\n    .zone-id {\n      color: var(--pencil);\n      font-family: var(--mono);\n      font-size: 11px;\n      line-height: 1;\n    }\n\n    .zone-name {\n      margin-top: 20px;\n      font-family: var(--serif-title);\n      font-size: 21px;\n      line-height: 1;\n    }\n\n    .zone--01 { left: 7%; top: 9%; width: 29%; height: 24%; }\n    .zone--02 { left: 48%; top: 7%; width: 22%; height: 30%; }\n    .zone--03 { left: 17%; top: 45%; width: 34%; height: 29%; }\n    .zone--04 { left: 61%; top: 48%; width: 27%; height: 20%; }\n    .zone--05 { left: 4%; top: 80%; width: 41%; height: 13%; }\n\n    .plan-stamp {\n      position: absolute;\n      z-index: 6;\n      right: 18px;\n      top: 18px;\n      border: var(--line) solid var(--graphite);\n      padding: 7px 9px;\n      color: var(--graphite);\n      font-family: var(--mono);\n      font-size: 11px;\n      line-height: 1.2;\n      background: var(--paper);\n    }\n\n    .legend {\n      grid-column: 9 / -1;\n      height: 403px;\n      border-top: var(--heavy-line) solid var(--graphite);\n      border-bottom: var(--line) solid var(--graphite);\n      padding-top: 12px;\n    }\n\n    .legend-header {\n      display: flex;\n      justify-content: space-between;\n      align-items: baseline;\n      border-bottom: var(--line) solid var(--graphite);\n      padding-bottom: 10px;\n    }\n\n    .legend-header h2 {\n      margin: 0;\n      color: var(--press);\n      font-family: var(--serif-title);\n      font-size: 25px;\n      font-weight: 400;\n      line-height: 1;\n    }\n\n    .legend-header span {\n      color: var(--pencil);\n      font-family: var(--mono);\n      font-size: 11px;\n    }\n\n    .year-switch {\n      display: flex;\n      gap: 5px;\n      margin: 13px 0 17px;\n    }\n\n    .year-switch button {\n      appearance: none;\n      border: var(--line) solid var(--pencil);\n      padding: 5px 7px;\n      background: var(--paper);\n      color: var(--graphite);\n      font-family: var(--mono);\n      font-size: 11px;\n      cursor: pointer;\n    }\n\n    .year-switch button[aria-pressed=\"true\"] {\n      border-color: var(--press);\n      background: var(--press);\n      color: var(--paper);\n    }\n\n    .legend-list {\n      display: grid;\n      gap: 9px;\n      margin: 0;\n      padding: 0;\n      list-style: none;\n    }\n\n    .legend-item {\n      display: grid;\n      grid-template-columns: 34px 1fr auto;\n      gap: 9px;\n      align-items: center;\n      min-height: 38px;\n      border-bottom: var(--line) solid var(--pencil);\n      padding-bottom: 7px;\n      transition: border-width 160ms ease;\n    }\n\n    .legend-item.is-emphasized {\n      border-bottom-width: 2px;\n    }\n\n    .legend-line {\n      display: block;\n      height: 0;\n      border-top: var(--line) solid var(--graphite);\n    }\n\n    .legend-item:nth-child(2) .legend-line {\n      border-top-style: dashed;\n    }\n\n    .legend-item:nth-child(3) .legend-line {\n      border-top-style: dotted;\n    }\n\n    .legend-item:nth-child(4) .legend-line {\n      border-top-width: 1.2px;\n    }\n\n    .legend-item:nth-child(5) .legend-line {\n      border-top-style: dashed;\n      border-top-width: 1.2px;\n    }\n\n    .legend-copy strong {\n      display: block;\n      color: var(--press);\n      font-family: var(--serif-title);\n      font-size: 18px;\n      font-weight: 400;\n      line-height: 1.1;\n    }\n\n    .legend-copy small {\n      display: block;\n      margin-top: 3px;\n      color: var(--pencil);\n      font-size: 12px;\n      line-height: 1.15;\n    }\n\n    .legend-no {\n      color: var(--graphite);\n      font-family: var(--mono);\n      font-size: 12px;\n      font-variant-numeric: tabular-nums;\n      text-align: right;\n    }\n\n    .contact-block {\n      display: grid;\n      grid-template-columns: 1fr auto;\n      gap: 15px;\n      align-items: end;\n      margin-top: 27px;\n      border-top: var(--heavy-line) solid var(--graphite);\n      padding-top: 14px;\n    }\n\n    .contact-block p {\n      max-width: 260px;\n      margin: 0;\n      color: var(--graphite);\n      font-size: 15px;\n      line-height: 1.35;\n    }\n\n    .phone-link {\n      display: inline-block;\n      border: var(--heavy-line) solid var(--press);\n      padding: 13px 14px 11px;\n      background: var(--press);\n      color: var(--paper);\n      font-family: var(--mono);\n      font-size: 15px;\n      text-decoration: none;\n      white-space: nowrap;\n    }\n\n    .records {\n      grid-column: 1 / -1;\n      display: grid;\n      grid-template-columns: 1.25fr 0.8fr 1.4fr 0.9fr 1.15fr;\n      gap: 16px;\n      margin-top: 23px;\n      border-top: var(--heavy-line) solid var(--graphite);\n      padding-top: 15px;\n    }\n\n    .record {\n      display: flex;\n      flex-direction: column;\n      min-height: 245px;\n      border-right: var(--line) solid var(--pencil);\n      padding-right: 14px;\n    }\n\n    .record:last-child {\n      border-right: 0;\n    }\n\n    .record-image,\n    .record-blank {\n      display: block;\n      width: 100%;\n      height: 128px;\n      object-fit: cover;\n      border: var(--line) solid var(--pencil);\n      background: var(--paper);\n    }\n\n    .record-blank {\n      position: relative;\n      background:\n        linear-gradient(to right, var(--pencil) 0.5px, transparent 0.5px),\n        linear-gradient(to bottom, var(--pencil) 0.5px, transparent 0.5px);\n      background-size: 20px 20px;\n      opacity: 0.5;\n    }\n\n    .record-blank::after {\n      content: \"留白页 / 还没遇到的那双鞋\";\n      position: absolute;\n      left: 10px;\n      bottom: 9px;\n      color: var(--pencil);\n      font-size: 12px;\n    }\n\n    .record-meta {\n      display: flex;\n      justify-content: space-between;\n      margin-top: 10px;\n      color: var(--pencil);\n      font-family: var(--mono);\n      font-size: 11px;\n    }\n\n    .record h3 {\n      margin: 9px 0 4px;\n      color: var(--press);\n      font-family: var(--serif-title);\n      font-size: 24px;\n      font-weight: 400;\n      line-height: 1;\n    }\n\n    .record p {\n      margin: 0;\n      font-size: 14px;\n      line-height: 1.35;\n    }\n\n    .record:nth-child(2) {\n      padding-top: 22px;\n    }\n\n    .record:nth-child(3) {\n      padding-top: 7px;\n    }\n\n    .record:nth-child(4) {\n      padding-top: 35px;\n    }\n\n    .record:nth-child(5) {\n      padding-top: 14px;\n    }\n\n    .footer {\n      display: grid;\n      grid-template-columns: 1fr auto 1fr;\n      gap: 20px;\n      align-items: end;\n      margin-top: 25px;\n      border-top: var(--line) solid var(--graphite);\n      padding-top: 13px;\n      color: var(--pencil);\n      font-size: 12px;\n    }\n\n    .footer-note {\n      max-width: 360px;\n    }\n\n    .scale-wrap {\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      gap: 5px;\n      color: var(--graphite);\n      font-family: var(--mono);\n      font-size: 10px;\n    }\n\n    .scale {\n      display: flex;\n      align-items: end;\n      height: 24px;\n      border-bottom: var(--line) solid var(--graphite);\n    }\n\n    .scale-segment {\n      position: relative;\n      display: block;\n      width: 20px;\n      height: 12px;\n      border-left: var(--line) solid var(--graphite);\n    }\n\n    .scale-segment:nth-child(7) {\n      width: 19.5px;\n    }\n\n    .scale-segment:nth-child(13) {\n      width: 20.5px;\n    }\n\n    .scale-segment:last-child {\n      border-right: var(--line) solid var(--graphite);\n    }\n\n    .scale-segment:nth-child(even) {\n      height: 18px;\n    }\n\n    .footer-index {\n      justify-self: end;\n      font-family: var(--mono);\n      font-size: 11px;\n      text-align: right;\n    }\n\n    @keyframes place-sheet {\n      from { opacity: 0; }\n      to { opacity: 1; }\n    }\n\n    @media (max-width: 900px) {\n      .site-frame {\n        padding: 20px 22px 20px;\n      }\n\n      .masthead,\n      .layout {\n        grid-template-columns: repeat(6, minmax(0, 1fr));\n      }\n\n      .masthead-mark {\n        grid-column: 1 / span 2;\n      }\n\n      .masthead-note {\n        grid-column: 4 / -1;\n      }\n\n      .plan-wrap {\n        grid-column: 1 / -1;\n        margin-left: -22px;\n      }\n\n      .legend {\n        grid-column: 1 / -1;\n      }\n\n      .records {\n        grid-template-columns: repeat(3, 1fr);\n      }\n\n      .record:nth-child(4),\n      .record:nth-child(5) {\n        margin-top: 15px;\n      }\n\n      .footer {\n        grid-template-columns: 1fr 1fr;\n      }\n\n      .scale-wrap {\n        justify-self: end;\n      }\n\n      .footer-index {\n        grid-column: 1 / -1;\n        justify-self: start;\n      }\n    }\n\n    @media (max-width: 620px) {\n      body::before,\n      body::after {\n        display: none;\n      }\n\n      .site-frame {\n        padding: 16px 16px 18px;\n      }\n\n      .masthead {\n        display: flex;\n        justify-content: space-between;\n        gap: 14px;\n      }\n\n      .masthead-note {\n        max-width: 190px;\n      }\n\n      .plan-wrap {\n        margin-left: -16px;\n      }\n\n      .plan-heading {\n        padding-left: 16px;\n        padding-right: 16px;\n      }\n\n      .plan-heading h1 {\n        font-size: clamp(48px, 15vw, 72px);\n      }\n\n      .plan-heading .registration {\n        display: none;\n      }\n\n      .plan {\n        height: 560px;\n      }\n\n      .legend {\n        height: auto;\n        min-height: 403px;\n      }\n\n      .contact-block {\n        grid-template-columns: 1fr;\n      }\n\n      .phone-link {\n        justify-self: start;\n      }\n\n      .records {\n        grid-template-columns: 1fr;\n        gap: 20px;\n      }\n\n      .record,\n      .record:nth-child(2),\n      .record:nth-child(3),\n      .record:nth-child(4),\n      .record:nth-child(5) {\n        min-height: 0;\n        margin-top: 0;\n        border-right: 0;\n        border-bottom: var(--line) solid var(--pencil);\n        padding: 0 0 18px;\n      }\n\n      .record:last-child {\n        border-bottom: 0;\n      }\n\n      .record-image,\n      .record-blank {\n        height: auto;\n        aspect-ratio: 3 / 2;\n      }\n\n      .footer {\n        display: flex;\n        flex-direction: column;\n        align-items: start;\n      }\n\n      .scale-wrap,\n      .footer-index {\n        justify-self: start;\n      }\n    }\n\n    @media (prefers-reduced-motion: reduce) {\n      .sheet {\n        animation: none;\n      }\n\n      .plan {\n        transform: none !important;\n        transition: none;\n      }\n\n      .sheet--1934,\n      .sheet--1936,\n      .sheet--1938 {\n        opacity: 1;\n      }\n\n      .year-switch button,\n      .zone,\n      .legend-item {\n        transition: none;\n      }\n\n      .year-switch button {\n        transition: opacity 100ms linear;\n      }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"site-frame\">\n    <header class=\"masthead\">\n      <div class=\"masthead-mark\">NORTHSTAR / 05<br>鞋铺・钥匙台</div>\n      <div class=\"masthead-note\">我把每一双鞋、每一把钥匙都记在这张纸上。<br>你先打电话，剩下的交给我。</div>\n    </header>\n\n    <main class=\"layout\">\n      <section class=\"plan-wrap\" aria-labelledby=\"page-title\">\n        <div class=\"plan-heading\">\n          <h1 id=\"page-title\">鞋底和钥匙，<br>先把时间约好</h1>\n          <div class=\"registration\">登记簿 01—05<br>手工修订 / 2024</div>\n        </div>\n\n        <div class=\"plan\" id=\"plan\" aria-label=\"店内服务平面图\">\n          <div class=\"sheet sheet--1934\" aria-hidden=\"true\">\n            <svg viewBox=\"0 0 900 650\" preserveAspectRatio=\"none\">\n              <path d=\"M30 95H270V42H505V166H866M30 282H168V203H380V382H608V281H866M44 542H330V470H477V611M712 166V281M505 42V166M168 203V382\" fill=\"none\" stroke-width=\"0.8\"/>\n              <path d=\"M84 42V611M270 42V166M380 203V542M608 281V611M756 95V542\" fill=\"none\" stroke-width=\"0.5\"/>\n              <rect x=\"72\" y=\"65\" width=\"141\" height=\"90\" fill=\"none\" stroke-width=\"1.2\"/>\n              <rect x=\"530\" y=\"68\" width=\"156\" height=\"76\" fill=\"none\" stroke-width=\"0.8\"/>\n              <circle cx=\"444\" cy=\"274\" r=\"58\" fill=\"none\" stroke-width=\"0.8\"/>\n              <path d=\"M395 274h98M444 225v98M30 611h836\" fill=\"none\" stroke-width=\"0.5\"/>\n            </svg>\n          </div>\n\n          <div class=\"sheet sheet--1936\" aria-hidden=\"true\">\n            <svg viewBox=\"0 0 900 650\" preserveAspectRatio=\"none\">\n              <path d=\"M30 111H286V57H520V179H866M30 299H182V220H394V397H622V298H866M44 558H344V486H489V627M726 179V298M520 57V179M182 220V397\" fill=\"none\" stroke-width=\"0.8\"/>\n              <path d=\"M99 57V627M286 57V179M394 220V558M622 298V627M770 111V558\" fill=\"none\" stroke-width=\"0.5\"/>\n              <rect x=\"87\" y=\"79\" width=\"141\" height=\"90\" fill=\"none\" stroke-width=\"1.2\"/>\n              <rect x=\"545\" y=\"84\" width=\"156\" height=\"76\" fill=\"none\" stroke-width=\"0.8\"/>\n              <circle cx=\"458\" cy=\"290\" r=\"58\" fill=\"none\" stroke-width=\"0.8\"/>\n              <path d=\"M409 290h98M458 241v98M30 627h836\" fill=\"none\" stroke-width=\"0.5\"/>\n            </svg>\n          </div>\n\n          <div class=\"sheet sheet--1938\" aria-hidden=\"true\">\n            <svg viewBox=\"0 0 900 650\" preserveAspectRatio=\"none\">\n              <path d=\"M30 123H302V72H536V191H866M30 314H196V237H409V411H636V313H866M44 570H358V501H503V641M740 191V313M536 72V191M196 237V411\" fill=\"none\" stroke-width=\"0.8\"/>\n              <path d=\"M112 72V641M302 72V191M409 237V570M636 313V641M784 123V570\" fill=\"none\" stroke-width=\"0.5\"/>\n              <rect x=\"102\" y=\"94\" width=\"141\" height=\"90\" fill=\"none\" stroke-width=\"1.2\"/>\n              <rect x=\"560\" y=\"98\" width=\"156\" height=\"76\" fill=\"none\" stroke-width=\"0.8\"/>\n              <circle cx=\"472\" cy=\"305\" r=\"58\" fill=\"none\" stroke-width=\"0.8\"/>\n              <path d=\"M423 305h98M472 256v98M30 641h836\" fill=\"none\" stroke-width=\"0.5\"/>\n            </svg>\n          </div>\n\n          <div class=\"map-grid\" aria-hidden=\"true\"></div>\n\n          <div class=\"zone zone--01\" data-reg=\"REG-01\" data-legend=\"legend-01\" tabindex=\"0\" role=\"button\" aria-label=\"01 鞋底登记区\">\n            <span class=\"zone-id\">01 / 1934</span>\n            <span class=\"zone-name\">鞋底登记</span>\n          </div>\n          <div class=\"zone zone--02\" data-reg=\"REG-02\" data-legend=\"legend-02\" tabindex=\"0\" role=\"button\" aria-label=\"02 鞋面缝补区\">\n            <span class=\"zone-id\">02 / 1936</span>\n            <span class=\"zone-name\">鞋面缝补</span>\n          </div>\n          <div class=\"zone zone--03\" data-reg=\"REG-03\" data-legend=\"legend-03\" tabindex=\"0\" role=\"button\" aria-label=\"03 配钥匙区\">\n            <span class=\"zone-id\">03 / 1938</span>\n            <span class=\"zone-name\">配钥匙</span>\n          </div>\n          <div class=\"zone zone--04\" data-reg=\"REG-04\" data-legend=\"legend-04\" tabindex=\"0\" role=\"button\" aria-label=\"04 取件区\">\n            <span class=\"zone-id\">04 / 1936</span>\n            <span class=\"zone-name\">取件台</span>\n          </div>\n          <div class=\"zone zone--05\" data-reg=\"REG-05\" data-legend=\"legend-05\" tabindex=\"0\" role=\"button\" aria-label=\"05 等候区\">\n            <span class=\"zone-id\">05 / 1934</span>\n            <span class=\"zone-name\">门口等候</span>\n          </div>\n\n          <div class=\"plan-stamp\">三层纸已叠合<br>不同时代，同一间店</div>\n        </div>\n      </section>\n\n      <aside class=\"legend\" aria-labelledby=\"legend-title\">\n        <div class=\"legend-header\">\n          <h2 id=\"legend-title\">这张图怎么读</h2>\n          <span>线型 / 登记号</span>\n        </div>\n\n        <div class=\"year-switch\" aria-label=\"选择图纸年份\">\n          <button type=\"button\" data-year=\"1934\" aria-pressed=\"true\">1934</button>\n          <button type=\"button\" data-year=\"1936\" aria-pressed=\"false\">1936</button>\n          <button type=\"button\" data-year=\"1938\" aria-pressed=\"false\">1938</button>\n        </div>\n\n        <ol class=\"legend-list\">\n          <li class=\"legend-item\" id=\"legend-01\">\n            <span class=\"legend-line\"></span>\n            <span class=\"legend-copy\"><strong>鞋底登记</strong><small>先看磨损，再决定怎么补</small></span>\n            <span class=\"legend-no\">REG-01</span>\n          </li>\n          <li class=\"legend-item\" id=\"legend-02\">\n            <span class=\"legend-line\"></span>\n            <span class=\"legend-copy\"><strong>鞋面缝补</strong><small>线脚尽量沿着原来的走向</small></span>\n            <span class=\"legend-no\">REG-02</span>\n          </li>\n          <li class=\"legend-item\" id=\"legend-03\">\n            <span class=\"legend-line\"></span>\n            <span class=\"legend-copy\"><strong>配钥匙</strong><small>带上旧钥匙，省得猜齿口</small></span>\n            <span class=\"legend-no\">REG-03</span>\n          </li>\n          <li class=\"legend-item\" id=\"legend-04\">\n            <span class=\"legend-line\"></span>\n            <span class=\"legend-copy\"><strong>取件台</strong><small>做好了我会把它放在这里</small></span>\n            <span class=\"legend-no\">REG-04</span>\n          </li>\n          <li class=\"legend-item\" id=\"legend-05\">\n            <span class=\"legend-line\"></span>\n            <span class=\"legend-copy\"><strong>门口等候</strong><small>不用挤，到了就先坐一会儿</small></span>\n            <span class=\"legend-no\">REG-05</span>\n          </li>\n        </ol>\n\n        <div class=\"contact-block\">\n          <p>要修鞋或配钥匙，打电话告诉我你方便的时间。我会把台面空出来等你。</p>\n          <a class=\"phone-link\" href=\"tel:010-19361938\">010—1936—1938</a>\n        </div>\n      </aside>\n\n      <section class=\"records\" aria-label=\"五条服务登记\">\n        <article class=\"record\" id=\"record-01\">\n          <img class=\"record-image\" src=\"images/占位-1.jpg\" width=\"1200\" height=\"800\" alt=\"一双正在修补的旧皮鞋\">\n          <div class=\"record-meta\"><span>01 / REG-01</span><span>鞋底</span></div>\n          <h3>旧鞋底，别急着丢</h3>\n          <p>先把鞋底翻过来看一眼。能补的，我都尽量给它再走一段路。</p>\n        </article>\n\n        <article class=\"record\" id=\"record-02\">\n          <img class=\"record-image\" src=\"images/占位-2.jpg\" width=\"900\" height=\"1200\" alt=\"手工缝补鞋面的针线\">\n          <div class=\"record-meta\"><span>02 / REG-02</span><span>缝补</span></div>\n          <h3>线脚慢一点</h3>\n          <p>手工活不能催。线脚稳了，穿起来才不会硌脚。</p>\n        </article>\n\n        <article class=\"record\" id=\"record-03\">\n          <img class=\"record-image\" src=\"images/占位-3.jpg\" width=\"1200\" height=\"900\" alt=\"一排不同齿形的钥匙\">\n          <div class=\"record-meta\"><span>03 / REG-03</span><span>钥匙</span></div>\n          <h3>旧钥匙也认得门</h3>\n          <p>带着旧的来，我照着它配。每个齿口都要对得上。</p>\n        </article>\n\n        <article class=\"record\" id=\"record-04\">\n          <img class=\"record-image\" src=\"images/占位-4.jpg\" width=\"1000\" height=\"1000\" alt=\"修鞋店台面上的工具\">\n          <div class=\"record-meta\"><span>04 / REG-04</span><span>取件</span></div>\n          <h3>放在台边等你</h3>\n          <p>做好以后我会收好，不让灰落上去。你按约好的时间来拿。</p>\n        </article>\n\n        <article class=\"record\" id=\"record-05\">\n          <div class=\"record-blank\" aria-label=\"暂时留白的服务位置\"></div>\n          <div class=\"record-meta\"><span>05 / REG-05</span><span>等候</span></div>\n          <h3>坐一会儿也行</h3>\n          <p>如果早到了，门口有地方坐。我们不赶这一会儿。</p>\n        </article>\n      </section>\n    </main>\n\n    <footer class=\"footer\">\n      <div class=\"footer-note\">纸上的改动都算数。磨掉的铅笔痕，是这间小店留下来的时间。</div>\n      <div class=\"scale-wrap\">\n        <span>比例尺 1:200</span>\n        <div class=\"scale\" aria-label=\"手绘比例尺 1比200\">\n          <i class=\"scale-segment\"></i><i class=\"scale-segment\"></i><i class=\"scale-segment\"></i><i class=\"scale-segment\"></i>\n          <i class=\"scale-segment\"></i><i class=\"scale-segment\"></i><i class=\"scale-segment\"></i><i class=\"scale-segment\"></i>\n          <i class=\"scale-segment\"></i><i class=\"scale-segment\"></i><i class=\"scale-segment\"></i><i class=\"scale-segment\"></i>\n          <i class=\"scale-segment\"></i><i class=\"scale-segment\"></i>\n        </div>\n      </div>\n      <div class=\"footer-index\">登记簿 / 01—05<br>今天也开门</div>\n    </footer>\n  </div>\n\n  <script>\n    (function () {\n      const plan = document.getElementById(\"plan\");\n      const yearButtons = document.querySelectorAll(\"[data-year]\");\n      const zones = document.querySelectorAll(\".zone\");\n      const legendItems = document.querySelectorAll(\".legend-item\");\n      const reduceMotion = window.matchMedia(\"(prefers-reduced-motion: reduce)\");\n\n      function setYear(year) {\n        plan.dataset.view = year;\n        yearButtons.forEach(function (button) {\n          button.setAttribute(\"aria-pressed\", button.dataset.year === year ? \"true\" : \"false\");\n        });\n      }\n\n      yearButtons.forEach(function (button) {\n        button.addEventListener(\"click\", function () {\n          setYear(button.dataset.year);\n        });\n      });\n\n      function emphasize(zone) {\n        legendItems.forEach(function (item) {\n          item.classList.remove(\"is-emphasized\");\n        });\n        const target = document.getElementById(zone.dataset.legend);\n        if (target) {\n          target.classList.add(\"is-emphasized\");\n          window.setTimeout(function () {\n            target.classList.remove(\"is-emphasized\");\n          }, 160);\n        }\n      }\n\n      zones.forEach(function (zone) {\n        zone.addEventListener(\"mouseenter\", function () {\n          document.body.classList.add(\"zone-cursor\");\n        });\n\n        zone.addEventListener(\"mouseleave\", function () {\n          document.body.classList.remove(\"zone-cursor\");\n        });\n\n        zone.addEventListener(\"focus\", function () {\n          document.body.classList.add(\"zone-cursor\");\n        });\n\n        zone.addEventListener(\"blur\", function () {\n          document.body.classList.remove(\"zone-cursor\");\n        });\n\n        zone.addEventListener(\"click\", function () {\n          emphasize(zone);\n        });\n\n        zone.addEventListener(\"keydown\", function (event) {\n          if (event.key === \"Enter\" || event.key === \" \") {\n            event.preventDefault();\n            emphasize(zone);\n          }\n        });\n      });\n\n      if (!reduceMotion.matches) {\n        window.addEventListener(\"mousemove\", function (event) {\n          document.body.style.setProperty(\"--cursor-x\", event.clientX + \"px\");\n          document.body.style.setProperty(\"--cursor-y\", event.clientY + \"px\");\n        });\n\n        let ticking = false;\n        window.addEventListener(\"scroll\", function () {\n          if (!ticking) {\n            window.requestAnimationFrame(function () {\n              plan.classList.toggle(\"is-shrunk\", window.scrollY >= 200);\n              ticking = false;\n            });\n            ticking = true;\n          }\n        }, { passive: true });\n      }\n    }());\n  </script>\n</body>\n</html>"
        }
      }
    }
