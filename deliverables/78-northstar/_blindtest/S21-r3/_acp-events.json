        "content": {
          "type": "text",
          "text": " <!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>值班台｜修鞋配钥匙</title>\n<style>\n  :root {\n    --ink: #3E3A34;\n    --paper: #E4DCC9;\n    --amber: #924307;\n    --fibre: #6E6A5E;\n    --white: #FFFFFF;\n    --line: 1px;\n    --line-heavy: 2px;\n  }\n\n  * {\n    box-sizing: border-box;\n    border-radius: 0 !important;\n  }\n\n  html {\n    background: var(--paper);\n    scroll-behavior: auto;\n  }\n\n  body {\n    margin: 0;\n    background: var(--paper);\n    color: var(--ink);\n    font-family: \"WenJin Mincho\", Georgia, \"Songti SC\", STSong, serif;\n    font-size: 16px;\n    line-height: 1.45;\n    cursor: default;\n  }\n\n  body::before {\n    content: \"\";\n    position: fixed;\n    inset: 0;\n    pointer-events: none;\n    border: var(--line) solid var(--fibre);\n    z-index: 20;\n  }\n\n  a {\n    color: inherit;\n    text-decoration: none;\n  }\n\n  button,\n  a {\n    -webkit-tap-highlight-color: transparent;\n  }\n\n  .mono,\n  .index,\n  .time,\n  .price,\n  .plate,\n  .bar-no,\n  .ledger-number {\n    font-family: \"IBM Plex Mono\", \"Courier New\", monospace;\n    font-variant-numeric: tabular-nums;\n  }\n\n  .page {\n    width: min(1520px, calc(100% - 44px));\n    margin: 0 auto;\n    padding: 25px 0 34px;\n  }\n\n  .masthead {\n    display: grid;\n    grid-template-columns: 1.15fr .85fr;\n    border-bottom: var(--line-heavy) solid var(--ink);\n    padding-bottom: 18px;\n    gap: 30px;\n  }\n\n  .eyebrow {\n    display: flex;\n    align-items: center;\n    gap: 12px;\n    color: var(--amber);\n    font-size: 12px;\n    letter-spacing: .13em;\n    text-transform: uppercase;\n  }\n\n  .eyebrow::before {\n    content: \"\";\n    width: 38px;\n    height: var(--line);\n    background: var(--amber);\n  }\n\n  h1 {\n    margin: 15px 0 0;\n    font-family: Antonio, \"WenJin Mincho\", Georgia, \"Songti SC\", serif;\n    font-size: clamp(58px, 7.2vw, 86px);\n    font-weight: 400;\n    line-height: .94;\n    letter-spacing: -.045em;\n  }\n\n  .mast-note {\n    align-self: end;\n    border-left: var(--line) solid var(--fibre);\n    padding: 0 0 2px 18px;\n    max-width: 430px;\n    color: var(--fibre);\n  }\n\n  .mast-note strong {\n    display: block;\n    margin-bottom: 7px;\n    color: var(--ink);\n    font-weight: 400;\n  }\n\n  .docket {\n    display: grid;\n    grid-template-columns: 1.15fr .85fr;\n    gap: 30px;\n    margin-top: 17px;\n  }\n\n  .docket-left,\n  .docket-right {\n    min-width: 0;\n  }\n\n  .docket-left {\n    border-right: var(--line) solid var(--fibre);\n    padding-right: 30px;\n  }\n\n  .docket-right {\n    padding-left: 0;\n  }\n\n  .section-head {\n    display: flex;\n    align-items: baseline;\n    justify-content: space-between;\n    gap: 20px;\n    border-bottom: var(--line) solid var(--ink);\n    padding-bottom: 8px;\n  }\n\n  .section-head h2 {\n    margin: 0;\n    font-family: Antonio, \"WenJin Mincho\", Georgia, \"Songti SC\", serif;\n    font-size: 27px;\n    font-weight: 400;\n    letter-spacing: .015em;\n  }\n\n  .section-head span {\n    color: var(--fibre);\n    font-size: 12px;\n    letter-spacing: .08em;\n  }\n\n  .services {\n    display: grid;\n    grid-template-columns: 1.12fr .88fr;\n    gap: 0 24px;\n    margin-top: 12px;\n  }\n\n  .service {\n    position: relative;\n    display: grid;\n    grid-template-columns: 35px 1fr auto;\n    gap: 12px;\n    align-items: start;\n    min-height: 112px;\n    border-bottom: var(--line) solid var(--fibre);\n    padding: 15px 0 13px;\n  }\n\n  .service:nth-child(2) {\n    min-height: 138px;\n    padding-top: 28px;\n  }\n\n  .service:nth-child(3) {\n    min-height: 130px;\n  }\n\n  .service:nth-child(4) {\n    min-height: 104px;\n    padding-top: 22px;\n  }\n\n  .service:nth-child(5) {\n    grid-column: 1 / -1;\n    min-height: 96px;\n    grid-template-columns: 35px 1fr auto 1fr;\n    align-items: center;\n  }\n\n  .index {\n    color: var(--amber);\n    font-size: 14px;\n    padding-top: 2px;\n  }\n\n  .service h3 {\n    margin: 0 0 5px;\n    font-size: 22px;\n    font-weight: 400;\n    line-height: 1.1;\n  }\n\n  .service p {\n    margin: 0;\n    color: var(--fibre);\n    font-size: 14px;\n  }\n\n  .price {\n    align-self: start;\n    color: var(--ink);\n    font-size: 14px;\n    text-align: right;\n    white-space: nowrap;\n  }\n\n  .service-rule {\n    position: absolute;\n    left: 0;\n    bottom: -1px;\n    width: 30px;\n    height: 1px;\n    background: var(--amber);\n  }\n\n  .image-grid {\n    display: grid;\n    grid-template-columns: 1.1fr .9fr;\n    gap: 10px;\n    margin-top: 18px;\n  }\n\n  .image-card {\n    position: relative;\n    overflow: hidden;\n    border: var(--line) solid var(--ink);\n    background: var(--paper);\n  }\n\n  .image-card:nth-child(2) {\n    margin-top: 19px;\n  }\n\n  .image-card:nth-child(3) {\n    margin-top: -8px;\n  }\n\n  .image-card:nth-child(4) {\n    margin-top: 12px;\n  }\n\n  .image-card:nth-child(5) {\n    grid-column: 1 / -1;\n    display: grid;\n    grid-template-columns: .7fr 1.3fr;\n    min-height: 116px;\n  }\n\n  .image-card img {\n    display: block;\n    width: 100%;\n    height: auto;\n    aspect-ratio: 4 / 3;\n    object-fit: cover;\n    background: var(--paper);\n    filter: none;\n  }\n\n  .image-card:nth-child(5) img {\n    height: 100%;\n    aspect-ratio: 1.5 / 1;\n  }\n\n  .image-caption {\n    border-top: var(--line) solid var(--ink);\n    padding: 7px 9px;\n    color: var(--fibre);\n    font-size: 12px;\n  }\n\n  .image-card:nth-child(5) .image-caption {\n    display: flex;\n    align-items: center;\n    border-top: 0;\n    border-left: var(--line) solid var(--ink);\n  }\n\n  .release-panel {\n    position: relative;\n  }\n\n  .release-lead {\n    margin: 13px 0 18px;\n    max-width: 455px;\n    color: var(--fibre);\n    font-size: 15px;\n  }\n\n  .release-lead b {\n    color: var(--ink);\n    font-weight: 400;\n  }\n\n  .release-path {\n    position: relative;\n    border-top: var(--line) solid var(--ink);\n    border-bottom: var(--line) solid var(--ink);\n    padding: 18px 0 20px;\n    cursor: text;\n  }\n\n  .release-path::before,\n  .release-path::after {\n    content: \"\";\n    position: absolute;\n    top: 0;\n    bottom: 0;\n    width: 1px;\n    background: var(--fibre);\n  }\n\n  .release-path::before {\n    left: 25%;\n  }\n\n  .release-path::after {\n    right: 25%;\n  }\n\n  .bars {\n    position: relative;\n    z-index: 1;\n    display: grid;\n    gap: 1px;\n    width: 100%;\n  }\n\n  .bar {\n    position: relative;\n    display: grid;\n    grid-template-columns: 55px 1fr auto;\n    align-items: center;\n    width: 100%;\n    min-height: 27px;\n    border: var(--line) solid var(--ink);\n    background: var(--ink);\n    color: var(--paper);\n    padding: 0 9px 0 11px;\n    clip-path: polygon(0 0, 100% 0, calc(100% - 17px) 100%, 0 100%);\n    transform: translateX(0);\n    transition: transform 70ms steps(1), border-color 0ms steps(1);\n    will-change: transform;\n  }\n\n  .bar:nth-child(3n) {\n    clip-path: polygon(0 0, 100% 0, calc(100% - 25px) 100%, 0 100%);\n  }\n\n  .bar:nth-child(3n + 2) {\n    clip-path: polygon(0 0, 100% 0, calc(100% - 9px) 100%, 0 100%);\n  }\n\n  .bar-no {\n    color: var(--amber);\n    font-size: 11px;\n  }\n\n  .bar-label {\n    font-size: 13px;\n    letter-spacing: .05em;\n  }\n\n  .bar-angle {\n    color: var(--paper);\n    font-family: \"IBM Plex Mono\", \"Courier New\", monospace;\n    font-size: 11px;\n  }\n\n  .bar::after {\n    content: \"\";\n    position: absolute;\n    right: calc(8px + var(--drift));\n    bottom: 2px;\n    width: 1.5px;\n    height: 1.5px;\n    background: var(--paper);\n  }\n\n  .bar:nth-child(1) { --drift: 0px; }\n  .bar:nth-child(2) { --drift: .25px; }\n  .bar:nth-child(3) { --drift: .5px; }\n  .bar:nth-child(4) { --drift: .75px; }\n  .bar:nth-child(5) { --drift: 1px; }\n  .bar:nth-child(6) { --drift: 1.25px; }\n  .bar:nth-child(7) { --drift: 1.5px; }\n  .bar:nth-child(8) { --drift: 1.75px; }\n  .bar:nth-child(9) { --drift: 2px; }\n  .bar:nth-child(10) { --drift: 2.25px; }\n  .bar:nth-child(11) { --drift: 2.5px; }\n  .bar:nth-child(12) { --drift: 2.75px; }\n  .bar:nth-child(13) { --drift: 3px; }\n  .bar:nth-child(14) { --drift: 3.5px; }\n\n  body.is-loading .bar {\n    transform: translateX(-105%);\n  }\n\n  body.is-loading.ready .bar {\n    transform: translateX(0);\n  }\n\n  .bar:hover,\n  .bar.is-related {\n    border-color: var(--amber);\n  }\n\n  .cut-key {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 7px;\n    margin-top: 14px;\n    color: var(--fibre);\n    font-family: \"IBM Plex Mono\", \"Courier New\", monospace;\n    font-size: 11px;\n  }\n\n  .cut-key span {\n    border-top: var(--line) solid var(--fibre);\n    padding-top: 5px;\n  }\n\n  .cut-key b {\n    color: var(--amber);\n    font-weight: 400;\n  }\n\n  .schedule {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 0;\n    margin-top: 23px;\n    border-top: var(--line-heavy) solid var(--ink);\n    border-bottom: var(--line) solid var(--ink);\n  }\n\n  .schedule-item {\n    display: grid;\n    grid-template-columns: 72px 1fr;\n    gap: 13px;\n    min-height: 71px;\n    border-bottom: var(--line) solid var(--fibre);\n    padding: 12px 10px 10px 0;\n  }\n\n  .schedule-item:nth-child(odd) {\n    border-right: var(--line) solid var(--fibre);\n    padding-right: 16px;\n  }\n\n  .schedule-item:nth-child(even) {\n    padding-left: 16px;\n  }\n\n  .schedule-item:nth-last-child(-n + 2) {\n    border-bottom: 0;\n  }\n\n  .time {\n    color: var(--amber);\n    font-size: 18px;\n  }\n\n  .schedule-item p {\n    margin: 0;\n    color: var(--fibre);\n    font-size: 13px;\n  }\n\n  .schedule-item strong {\n    display: block;\n    margin-bottom: 3px;\n    color: var(--ink);\n    font-size: 15px;\n    font-weight: 400;\n  }\n\n  .appointment {\n    display: grid;\n    grid-template-columns: 1fr auto;\n    align-items: center;\n    gap: 20px;\n    margin-top: 22px;\n    border: var(--line-heavy) solid var(--ink);\n    padding: 17px 18px;\n    box-shadow: inset 0 0 0 1px var(--paper);\n  }\n\n  .appointment h2 {\n    margin: 0 0 4px;\n    font-family: Antonio, \"WenJin Mincho\", Georgia, \"Songti SC\", serif;\n    font-size: 29px;\n    font-weight: 400;\n  }\n\n  .appointment p {\n    margin: 0;\n    color: var(--fibre);\n    font-size: 14px;\n  }\n\n  .call-button {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    min-width: 143px;\n    min-height: 49px;\n    border: var(--line) solid var(--amber);\n    background: var(--amber);\n    color: var(--white);\n    font-size: 15px;\n    letter-spacing: .06em;\n    transition: background 140ms steps(1), color 140ms steps(1);\n  }\n\n  .call-button:hover,\n  .call-button:focus-visible {\n    background: var(--ink);\n    color: var(--paper);\n    outline: none;\n  }\n\n  .plate {\n    position: relative;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    width: 61px;\n    height: 37px;\n    border: var(--line) solid var(--ink);\n    background: var(--paper);\n    box-shadow: inset 2px 2px 0 0 var(--fibre);\n    color: var(--ink);\n    cursor: pointer;\n    font-size: 13px;\n    perspective: 300px;\n  }\n\n  .plate span {\n    display: block;\n    transition: transform 140ms steps(1);\n  }\n\n  .plate.is-flipped span {\n    transform: rotateX(180deg);\n  }\n\n  .plate::before {\n    content: \"道岔\";\n    position: absolute;\n    top: -18px;\n    left: 0;\n    color: var(--fibre);\n    font-family: \"WenJin Mincho\", Georgia, \"Songti SC\", serif;\n    font-size: 11px;\n  }\n\n  .footer {\n    display: grid;\n    grid-template-columns: 1fr auto 1fr;\n    gap: 20px;\n    align-items: end;\n    border-top: var(--line-heavy) solid var(--ink);\n    margin-top: 28px;\n    padding-top: 11px;\n    color: var(--fibre);\n    font-size: 12px;\n  }\n\n  .footer-center {\n    color: var(--amber);\n    text-align: center;\n  }\n\n  .footer-right {\n    text-align: right;\n  }\n\n  @media (max-width: 900px) {\n    .masthead,\n    .docket {\n      grid-template-columns: 1fr;\n    }\n\n    .mast-note {\n      border-left: 0;\n      border-top: var(--line) solid var(--fibre);\n      padding: 12px 0 0;\n      max-width: none;\n    }\n\n    .docket-left {\n      border-right: 0;\n      border-bottom: var(--line-heavy) solid var(--ink);\n      padding: 0 0 25px;\n    }\n\n    .docket-right {\n      padding-top: 25px;\n    }\n  }\n\n  @media (max-width: 620px) {\n    .page {\n      width: min(100% - 28px, 520px);\n      padding-top: 18px;\n    }\n\n    h1 {\n      font-size: clamp(53px, 16vw, 76px);\n    }\n\n    .services,\n    .image-grid,\n    .schedule {\n      grid-template-columns: 1fr;\n    }\n\n    .service,\n    .service:nth-child(2),\n    .service:nth-child(3),\n    .service:nth-child(4),\n    .service:nth-child(5) {\n      grid-column: auto;\n      min-height: 0;\n      padding: 15px 0;\n    }\n\n    .service:nth-child(5) {\n      grid-template-columns: 35px 1fr auto;\n    }\n\n    .image-card:nth-child(n) {\n      margin-top: 0;\n    }\n\n    .image-card:nth-child(5) {\n      display: block;\n      min-height: 0;\n    }\n\n    .image-card:nth-child(5) img {\n      height: auto;\n    }\n\n    .image-card:nth-child(5) .image-caption {\n      border-top: var(--line) solid var(--ink);\n      border-left: 0;\n    }\n\n    .schedule-item,\n    .schedule-item:nth-child(odd),\n    .schedule-item:nth-child(even) {\n      border-right: 0;\n      border-bottom: var(--line) solid var(--fibre);\n      padding: 12px 0 10px;\n    }\n\n    .schedule-item:last-child {\n      border-bottom: 0;\n    }\n\n    .appointment {\n      grid-template-columns: 1fr;\n    }\n\n    .call-button {\n      width: 100%;\n    }\n\n    .footer {\n      grid-template-columns: 1fr 1fr;\n    }\n\n    .footer-center {\n      text-align: left;\n    }\n\n    .footer-right {\n      grid-column: 1 / -1;\n      text-align: left;\n    }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    html {\n      scroll-behavior: auto;\n    }\n\n    body.is-loading .bar,\n    body.is-loading.ready .bar {\n      transform: translateX(0);\n      transition: none;\n    }\n\n    .bar,\n    .plate span,\n    .call-button {\n      transition: none;\n    }\n  }\n</style>\n</head>\n<body>\n  <main class=\"page\">\n    <header class=\"masthead\">\n      <div>\n        <div class=\"eyebrow\">值班台 / RELEASE DESK / 07—24</div>\n        <h1>修鞋<br>配钥匙</h1>\n      </div>\n      <div class=\"mast-note\">\n        <strong>先登记，再放行。</strong>\n        每一项活都有自己的锁别。鞋面、鞋底、钥匙胚，按顺序交到台面上。电话确认后，才算入班。\n      </div>\n    </header>\n\n    <section class=\"docket\" aria-label=\"服务登记簿\">\n      <div class=\"docket-left\">\n        <div class=\"section-head\">\n          <h2>工作项 / WORK ITEMS</h2>\n          <span class=\"mono\">簿号 014—A</span>\n        </div>\n\n        <div class=\"services\">\n          <article class=\"service\" data-item=\"01\">\n            <div class=\"index\">01</div>\n            <div>\n              <h3>配钥匙</h3>\n              <p>民用门钥匙、信箱钥匙。带原钥匙来，现场校齿。</p>\n            </div>\n            <div class=\"price\">¥15起</div>\n            <i class=\"service-rule\"></i>\n          </article>\n\n          <article class=\"service\" data-item=\"02\">\n            <div class=\"index\">02</div>\n            <div>\n              <h3>鞋底更换</h3>\n              <p>磨穿、开胶、进水。先看底材，再定胶合或缝合。</p>\n            </div>\n            <div class=\"price\">¥40起</div>\n            <i class=\"service-rule\"></i>\n          </article>\n\n          <article class=\"service\" data-item=\"03\">\n            <div class=\"index\">03</div>\n            <div>\n              <h3>拉链维修</h3>\n              <p>换头、换齿、换整条。旧件不拆，先报工时。</p>\n            </div>\n            <div class=\"price\">¥20起</div>\n            <i class=\"service-rule\"></i>\n          </article>\n\n          <article class=\"service\" data-item=\"04\">\n            <div class=\"index\">04</div>\n            <div>\n              <h3>皮面修补</h3>\n              <p>裂口、刮伤、脱皮。按面积留痕，不用遮盖式处理。</p>\n            </div>\n            <div class=\"price\">¥30起</div>\n            <i class=\"service-rule\"></i>\n          </article>\n\n          <article class=\"service\" data-item=\"05\">\n            <div class=\"index\">05</div>\n            <div>\n              <h3>现场取件</h3>\n              <p>东西多、鞋底硬、钥匙不能离手，电话里先说清楚。</p>\n            </div>\n            <div class=\"price\">另议</div>\n            <i class=\"service-rule\"></i>\n          </article>\n        </div>\n\n        <div class=\"image-grid\" aria-label=\"作业图片位\">\n          <figure class=\"image-card\">\n            <img src=\"images/占位-1.jpg\" width=\"640\" height=\"480\" alt=\"配钥匙作业位\">\n            <figcaption class=\"image-caption\">钥匙胚 / 校齿台</figcaption>\n          </figure>\n          <figure class=\"image-card\">\n            <img src=\"images/占位-2.jpg\" width=\"480\" height=\"640\" alt=\"鞋底维修作业位\">\n            <figcaption class=\"image-caption\">鞋底 / 胶合位</figcaption>\n          </figure>\n          <figure class=\"image-card\">\n            <img src=\"images/占位-3.jpg\" width=\"640\" height=\"480\" alt=\"拉链维修作业位\">\n            <figcaption class=\"image-caption\">拉链 / 备件格</figcaption>\n          </figure>\n          <figure class=\"image-card\">\n            <img src=\"images/占位-4.jpg\" width=\"480\" height=\"640\" alt=\"皮面修补作业位\">\n            <figcaption class=\"image-caption\">皮面 / 修补台</figcaption>\n          </figure>\n          <figure class=\"image-card\">\n            <img src=\"images/占位-5.jpg\" width=\"720\" height=\"480\" alt=\"工具与取件登记位\">\n            <figcaption class=\"image-caption\">第五项没有图片。这里留给取件地址、鞋况和钥匙数量，电话里逐项确认。</figcaption>\n          </figure>\n        </div>\n      </div>\n\n      <div class=\"docket-right\">\n        <section class=\"release-panel\">\n          <div class=\"section-head\">\n            <h2>释放路径 / RELEASE PATH</h2>\n            <span class=\"mono\">14 LOCKS / NO. 01—14</span>\n          </div>\n\n          <p class=\"release-lead\">\n            <b>锁闭条按顺序扣接。</b> 先确认内容，再给时刻。切口是先后关系，缝隙是互斥关系，不做重复登记。\n          </p>\n\n          <div class=\"release-path\" id=\"releasePath\" aria-label=\"锁闭释放路径\">\n            <div class=\"bars\">\n              <div class=\"bar\" data-lock=\"01\" data-mutex=\"03 08\">\n                <span class=\"bar-no\">01</span><span class=\"bar-label\">受理记录</span><span class=\"bar-angle\">30°</span>\n              </div>\n              <div class=\"bar\" data-lock=\"02\" data-mutex=\"05 09\">\n                <span class=\"bar-no\">02</span><span class=\"bar-label\">物件初检</span><span class=\"bar-angle\">45°</span>\n              </div>\n              <div class=\"bar\" data-lock=\"03\" data-mutex=\"01 07\">\n                <span class=\"bar-no\">03</span><span class=\"bar-label\">服务确认</span><span class=\"bar-angle\">60°</span>\n              </div>\n              <div class=\"bar\" data-lock=\"04\" data-mutex=\"06 10\">\n                <span class=\"bar-no\">04</span><span class=\"bar-label\">材料核对</span><span class=\"bar-angle\">30°</span>\n              </div>\n              <div class=\"bar\" data-lock=\"05\" data-mutex=\"02 11\">\n                <span class=\"bar-no\">05</span><span class=\"bar-label\">报价登记</span><span class=\"bar-angle\">45°</span>\n              </div>\n              <div class=\"bar\" data-lock=\"06\" data-mutex=\"04 12\">\n                <span class=\"bar-no\">06</span><span class=\"bar-label\">工时排班</span><span class=\"bar-angle\">60°</span>\n              </div>\n              <div class=\"bar\" data-lock=\"07\" data-mutex=\"03 13\">\n                <span class=\"bar-no\">07</span><span class=\"bar-label\">鞋面放行</span><span class=\"bar-angle\">30°</span>\n              </div>\n              <div class=\"bar\" data-lock=\"08\" data-mutex=\"01 14\">\n                <span class=\"bar-no\">08</span><span class=\"bar-label\">钥匙胚放行</span><span class=\"bar-angle\">45°</span>\n              </div>\n              <div class=\"bar\" data-lock=\"09\" data-mutex=\"02 12\">\n                <span class=\"bar-no\">09</span><span class=\"bar-label\">旧件留存</span><span class=\"bar-angle\">60°</span>\n              </div>\n              <div class=\"bar\" data-lock=\"10\" data-mutex=\"04 13\">\n                <span class=\"bar-no\">10</span><span class=\"bar-label\">取件方式</span><span class=\"bar-angle\">30°</span>\n              </div>\n              <div class=\"bar\" data-lock=\"11\" data-mutex=\"05 14\">\n                <span class=\"bar-no\">11</span><span class=\"bar-label\">交付时刻</span><span class=\"bar-angle\">45°</span>\n              </div>\n              <div class=\"bar\" data-lock=\"12\" data-mutex=\"06 09\">\n                <span class=\"bar-no\">12</span><span class=\"bar-label\">尾款记录</span><span class=\"bar-angle\">60°</span>\n              </div>\n              <div class=\"bar\" data-lock=\"13\" data-mutex=\"07 10\">\n                <span class=\"bar-no\">13</span><span class=\"bar-label\">客户签收</span><span class=\"bar-angle\">30°</span>\n              </div>\n              <div class=\"bar\" data-lock=\"14\" data-mutex=\"08 11\">\n                <span class=\"bar-no\">14</span><span class=\"bar-label\">本次释放</span><span class=\"bar-angle\">45°</span>\n              </div>\n            </div>\n          </div>\n\n          <div class=\"cut-key\" aria-label=\"切口角度说明\">\n            <span><b>30°</b> 先行 / 05 对</span>\n            <span><b>45°</b> 中段 / 05 对</span>\n            <span><b>60°</b> 收束 / 04 对</span>\n          </div>\n        </section>\n\n        <section class=\"schedule\" aria-label=\"可预约时刻\">\n          <div class=\"schedule-item\">\n            <div class=\"time\">09:00</div>\n            <div><strong>开台</strong><p>配钥匙、简单换头。</p></div>\n          </div>\n          <div class=\"schedule-item\">\n            <div class=\"time\">11:30</div>\n            <div><strong>收件</strong><p>鞋底与皮面项目。</p></div>\n          </div>\n          <div class=\"schedule-item\">\n            <div class=\"time\">14:00</div>\n            <div><strong>工序</strong><p>集中维修，不接急改。</p></div>\n          </div>\n          <div class=\"schedule-item\">\n            <div class=\"time\">18:30</div>\n            <div><strong>交付</strong><p>按登记号取件。</p></div>\n          </div>\n        </section>\n\n        <div class=\"appointment\">\n          <div>\n            <h2>约一个时刻</h2>\n            <p>打电话，报服务项和到店时间。其余由值班台登记。</p>\n          </div>\n          <a class=\"call-button\" href=\"tel:13800000000\">拨号 138 0000 0000</a>\n        </div>\n\n        <div style=\"margin-top:24px; display:flex; justify-content:space-between; align-items:end; border-bottom:1px solid #6E6A5E; padding-bottom:9px;\">\n          <div style=\"color:#6E6A5E; font-size:12px;\">道岔号牌点击后显示锁别号</div>\n          <button class=\"plate\" type=\"button\" aria-label=\"切换道岔号牌\"><span>07—24</span></button>\n        </div>\n      </div>\n    </section>\n\n    <footer class=\"footer\">\n      <div>开放时间：09:00—19:00 / 周一至周六</div>\n      <div class=\"footer-center mono\">簿号 014—A / 台位 02</div>\n      <div class=\"footer-right\">电话预约优先。无预约，不保证当日放行。</div>\n    </footer>\n  </main>\n\n<script>\n  (function () {\n    var body = document.body;\n    var path = document.getElementById(\"releasePath\");\n    var bars = Array.prototype.slice.call(document.querySelectorAll(\".bar\"));\n    var reduced = window.matchMedia(\"(prefers-reduced-motion: reduce)\").matches;\n\n    if (!reduced) {\n      body.classList.add(\"is-loading\");\n      window.requestAnimationFrame(function () {\n        window.requestAnimationFrame(function () {\n          body.classList.add(\"ready\");\n        });\n      });\n    }\n\n    if (\"IntersectionObserver\" in window && !reduced) {\n      var observer = new IntersectionObserver(function (entries) {\n        entries.forEach(function (entry) {\n          if (!entry.isIntersecting) return;\n          bars.forEach(function (bar, index) {\n            bar.style.transitionDelay = (index * 70) + \"ms\";\n          });\n          observer.disconnect();\n        });\n      }, { threshold: 0.2 });\n\n      observer.observe(path);\n    }\n\n    bars.forEach(function (bar) {\n      var mutex = bar.getAttribute(\"data-mutex\").split(\" \");\n      bar.addEventListener(\"mouseenter\", function () {\n        mutex.forEach(function (lockNo) {\n          var related = document.querySelector('[data-lock=\"' + lockNo + '\"]');\n          if (related) related.classList.add(\"is-related\");\n        });\n      });\n      bar.addEventListener(\"mouseleave\", function () {\n        mutex.forEach(function (lockNo) {\n          var related = document.querySelector('[data-lock=\"' + lockNo + '\"]');\n          if (related) related.classList.remove(\"is-related\");\n        });\n      });\n    });\n\n    var plate = document.querySelector(\".plate\");\n    var plateText = plate.querySelector(\"span\");\n    var original = plateText.textContent;\n\n    plate.addEventListener(\"click\", function () {\n      plate.classList.add(\"is-flipped\");\n      plateText.textContent = \"锁别 07\";\n      window.setTimeout(function () {\n        plate.classList.remove(\"is-flipped\");\n        window.setTimeout(function () {\n          plateText.textContent = original;\n        }, 140);\n      }, 140);\n    });\n  }());\n</script>\n</body>\n</html>"
        }
