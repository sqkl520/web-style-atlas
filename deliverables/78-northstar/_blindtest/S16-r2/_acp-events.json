        "messageId": "77542891-1e7e-4c6e-b2a5-f4a2dfb673a2",
        "content": {
          "type": "text",
          "text": " <!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>斜坡修鞋 · 配钥匙</title>\n  <style>\n    @import url('https://fonts.googleapis.com/css2?family=Archivo+Black&family=Fragment+Mono&family=Noto+Serif+SC:wght@400;700;900&display=swap');\n\n    :root {\n      --red: #C52C0F;\n      --paper: #F7EBCF;\n      --ink: #1A1A1A;\n      --pressed: #8E2A18;\n      --ink-2: #5C5C55;\n      --line: 3px;\n      --slope: -12deg;\n      --ease-accel: cubic-bezier(0.5, 0, 1, 1);\n    }\n\n    * {\n      box-sizing: border-box;\n    }\n\n    html {\n      background: var(--paper);\n      scroll-behavior: auto;\n    }\n\n    body {\n      margin: 0;\n      min-width: 320px;\n      background: var(--paper);\n      color: var(--ink);\n      font-family: \"Noto Serif SC\", Georgia, \"Songti SC\", serif;\n      overflow-x: hidden;\n      cursor: crosshair;\n    }\n\n    body::before {\n      content: \"\";\n      position: fixed;\n      inset: 0;\n      pointer-events: none;\n      border: 13px solid var(--ink);\n      z-index: 20;\n    }\n\n    a,\n    button {\n      color: inherit;\n      font: inherit;\n    }\n\n    button {\n      border: 0;\n      border-radius: 0;\n      cursor: pointer;\n    }\n\n    .page {\n      position: relative;\n      min-height: 100vh;\n      padding: 30px 4vw 70px;\n      isolation: isolate;\n    }\n\n    .masthead {\n      position: relative;\n      z-index: 4;\n      display: grid;\n      grid-template-columns: 1fr auto;\n      gap: 30px;\n      align-items: start;\n      border-bottom: 6px solid var(--ink);\n      padding: 12px 0 20px;\n    }\n\n    .masthead-latin {\n      font-family: \"Archivo Black\", \"LXGW Marker Gothic\", sans-serif;\n      font-size: clamp(16px, 2vw, 26px);\n      letter-spacing: 0.05em;\n      line-height: 0.95;\n      text-transform: uppercase;\n    }\n\n    .shop-mark {\n      display: inline-flex;\n      align-items: center;\n      gap: 10px;\n      margin-top: 10px;\n      font-size: 13px;\n      letter-spacing: 0.12em;\n      font-weight: 700;\n    }\n\n    .shop-mark::before {\n      content: \"\";\n      width: 13px;\n      height: 13px;\n      background: var(--red);\n      border-radius: 50%;\n      box-shadow: 5px 5px 0 var(--pressed);\n    }\n\n    .phone-link {\n      display: inline-block;\n      background: var(--red);\n      color: var(--paper);\n      padding: 13px 18px;\n      border: 3px solid var(--ink);\n      box-shadow: 6px 6px 0 var(--pressed);\n      text-decoration: none;\n      font-weight: 900;\n      line-height: 1;\n      transition: transform 180ms ease, box-shadow 180ms ease;\n    }\n\n    .phone-link:hover,\n    .phone-link:focus-visible {\n      transform: translate(4px, 4px);\n      box-shadow: 2px 2px 0 var(--pressed);\n      outline: none;\n    }\n\n    .hero {\n      position: relative;\n      min-height: calc(100vh - 160px);\n      padding-top: 26px;\n    }\n\n    .hero-intro {\n      position: relative;\n      z-index: 3;\n      max-width: 760px;\n      padding-left: 1vw;\n    }\n\n    .eyebrow {\n      margin: 0 0 8px;\n      color: var(--red);\n      font-family: \"Fragment Mono\", monospace;\n      font-size: 12px;\n      letter-spacing: 0.06em;\n    }\n\n    h1 {\n      max-width: 850px;\n      margin: 0;\n      font-size: clamp(54px, 8.8vw, 88px);\n      line-height: 0.95;\n      letter-spacing: 0.02em;\n      font-weight: 900;\n    }\n\n    .intro-copy {\n      max-width: 490px;\n      margin: 18px 0 0;\n      font-size: 20px;\n      line-height: 0.95;\n      font-weight: 700;\n    }\n\n    .progress {\n      position: absolute;\n      top: 10px;\n      right: 0;\n      width: min(30vw, 330px);\n      height: 42px;\n      border-top: 3px solid var(--ink);\n      border-bottom: 3px solid var(--ink);\n      transform: rotate(var(--slope));\n      transform-origin: right center;\n      font-family: \"Fragment Mono\", monospace;\n      font-size: 11px;\n    }\n\n    .progress::before,\n    .progress::after {\n      content: \"\";\n      position: absolute;\n      top: -3px;\n      width: 3px;\n      height: 42px;\n      background: var(--ink);\n    }\n\n    .progress::before {\n      left: 25%;\n      box-shadow: 82px 0 var(--ink), 164px 0 var(--ink), 246px 0 var(--ink);\n    }\n\n    .progress::after {\n      left: 0;\n      background: var(--red);\n      transform: translateX(var(--pointer, 0));\n      transition: transform 140ms steps(1, end);\n    }\n\n    .progress-label {\n      position: absolute;\n      right: 0;\n      top: 8px;\n      color: var(--red);\n    }\n\n    .slant-stage {\n      position: relative;\n      z-index: 2;\n      min-height: 600px;\n      margin-top: 24px;\n      padding: 12px 0 40px;\n    }\n\n    .slant-track {\n      position: relative;\n      width: 100%;\n      min-height: 600px;\n      transform: rotate(var(--slope));\n      transform-origin: 12% 0;\n    }\n\n    .word-block {\n      --x: 0px;\n      --w: 46vw;\n      --delay: 0ms;\n      position: absolute;\n      left: calc(2vw + var(--x));\n      width: var(--w);\n      min-height: 126px;\n      padding: 14px 18px 16px;\n      background: var(--paper);\n      border: 3px solid var(--ink);\n      box-shadow: 10px 10px 0 var(--pressed);\n      overflow: visible;\n      transform: translateY(0);\n      transition: box-shadow 180ms ease, transform 240ms var(--ease-accel);\n      animation: press-in 110ms steps(1, end) var(--delay) both;\n    }\n\n    .word-block::before,\n    .word-block::after {\n      content: \"\";\n      position: absolute;\n      left: 42px;\n      bottom: -13px;\n      width: 2px;\n      height: 2px;\n      background: var(--ink);\n    }\n\n    .word-block::after {\n      left: 43px;\n    }\n\n    .word-block:hover,\n    .word-block:focus-within {\n      box-shadow: 14px 14px 0 var(--pressed);\n    }\n\n    .word-block:hover::before,\n    .word-block:hover::after {\n      box-shadow: 18px 0 0 var(--red), 36px 0 0 var(--red);\n    }\n\n    .block-1 {\n      --x: 0px;\n      --w: 68vw;\n      top: 0;\n      --delay: 0ms;\n    }\n\n    .block-2 {\n      --x: 24px;\n      --w: 46vw;\n      top: 120px;\n      --delay: 110ms;\n    }\n\n    .block-3 {\n      --x: 48px;\n      --w: 57vw;\n      top: 240px;\n      --delay: 220ms;\n    }\n\n    .block-4 {\n      --x: 72px;\n      --w: 36vw;\n      top: 360px;\n      --delay: 330ms;\n    }\n\n    .block-5 {\n      --x: 96px;\n      --w: 61vw;\n      top: 480px;\n      --delay: 440ms;\n    }\n\n    .block-number {\n      display: block;\n      margin-bottom: 3px;\n      color: var(--red);\n      font-family: \"Fragment Mono\", monospace;\n      font-size: 12px;\n      line-height: 1;\n      text-align: right;\n      font-variant-numeric: tabular-nums;\n    }\n\n    .block-title {\n      display: block;\n      font-size: clamp(34px, 5vw, 62px);\n      line-height: 0.95;\n      letter-spacing: 0.02em;\n      font-weight: 900;\n    }\n\n    .block-note {\n      display: block;\n      max-width: 540px;\n      margin-top: 8px;\n      font-size: 16px;\n      line-height: 0.95;\n      font-weight: 700;\n    }\n\n    .block-image {\n      display: block;\n      width: 100%;\n      height: auto;\n      margin-top: 13px;\n      border: 3px solid var(--ink);\n      filter: drop-shadow(5px 5px 0 var(--pressed));\n      object-fit: cover;\n    }\n\n    .block-1 .block-image {\n      max-width: 370px;\n      aspect-ratio: 7 / 3;\n    }\n\n    .block-2 .block-image {\n      max-width: 250px;\n      aspect-ratio: 4 / 3;\n    }\n\n    .block-3 .block-image {\n      max-width: 320px;\n      aspect-ratio: 16 / 9;\n    }\n\n    .block-4 .block-image {\n      max-width: 210px;\n      aspect-ratio: 4 / 3;\n    }\n\n    .block-5 .block-image {\n      max-width: 290px;\n      aspect-ratio: 3 / 2;\n    }\n\n    .block-action {\n      display: inline-block;\n      margin-top: 14px;\n      padding: 10px 14px;\n      background: var(--ink);\n      color: var(--paper);\n      text-decoration: none;\n      border: 3px solid var(--ink);\n      font-size: 16px;\n      line-height: 1;\n      transition: background 180ms ease, color 180ms ease;\n    }\n\n    .block-action:hover,\n    .block-action:focus-visible {\n      background: var(--red);\n      outline: none;\n    }\n\n    .footer {\n      position: relative;\n      z-index: 4;\n      display: flex;\n      justify-content: space-between;\n      align-items: end;\n      gap: 20px;\n      margin-top: 34px;\n      padding-top: 20px;\n      border-top: 6px solid var(--ink);\n    }\n\n    .footer p {\n      margin: 0;\n      max-width: 470px;\n      font-size: 16px;\n      line-height: 0.95;\n      font-weight: 700;\n    }\n\n    .footer .latin {\n      font-family: \"Archivo Black\", \"LXGW Marker Gothic\", sans-serif;\n      font-size: 20px;\n      line-height: 0.95;\n      text-align: right;\n    }\n\n    .speed-line {\n      position: fixed;\n      left: 0;\n      width: 0;\n      height: 3px;\n      background: var(--red);\n      pointer-events: none;\n      opacity: 0;\n      transition: width 180ms var(--ease-accel), opacity 180ms ease;\n      z-index: 10;\n    }\n\n    .speed-line.one { top: 34%; }\n    .speed-line.two { top: 48%; }\n    .speed-line.three { top: 62%; }\n\n    body.is-scrolling .speed-line {\n      opacity: 1;\n    }\n\n    body.is-scrolling .speed-line.one { width: 17vw; }\n    body.is-scrolling .speed-line.two { width: 28vw; }\n    body.is-scrolling .speed-line.three { width: 11vw; }\n\n    @keyframes press-in {\n      0% {\n        opacity: 0;\n        transform: translateY(-18px);\n      }\n      100% {\n        opacity: 1;\n        transform: translateY(0);\n      }\n    }\n\n    @media (max-width: 700px) {\n      body::before {\n        border-width: 6px;\n      }\n\n      .page {\n        padding: 20px 20px 50px;\n      }\n\n      .masthead {\n        grid-template-columns: 1fr;\n        gap: 18px;\n      }\n\n      .phone-link {\n        justify-self: start;\n      }\n\n      .hero {\n        min-height: auto;\n      }\n\n      .progress {\n        position: relative;\n        top: auto;\n        right: auto;\n        width: 70vw;\n        margin: 28px 0 18px 25vw;\n      }\n\n      .slant-stage {\n        min-height: auto;\n        margin-top: 6px;\n        padding-bottom: 0;\n      }\n\n      .slant-track {\n        min-height: auto;\n        transform: none;\n      }\n\n      .word-block,\n      .block-1,\n      .block-2,\n      .block-3,\n      .block-4,\n      .block-5 {\n        position: relative;\n        top: auto;\n        left: auto;\n        width: 100%;\n        min-height: 0;\n        margin: 0 0 24px;\n        transform: rotate(var(--slope));\n        transform-origin: left top;\n      }\n\n      .word-block {\n        margin-left: 10px;\n        width: calc(100% - 20px);\n      }\n\n      .block-2,\n      .block-3,\n      .block-4,\n      .block-5 {\n        margin-left: 34px;\n      }\n\n      .block-title {\n        font-size: clamp(34px, 12vw, 54px);\n      }\n\n      .footer {\n        display: block;\n        margin-top: 35px;\n      }\n\n      .footer .latin {\n        margin-top: 18px;\n        text-align: left;\n      }\n    }\n\n    @media (prefers-reduced-motion: reduce) {\n      html {\n        scroll-behavior: auto;\n      }\n\n      *,\n      *::before,\n      *::after {\n        animation-duration: 1ms !important;\n        animation-iteration-count: 1 !important;\n        transition-duration: 1ms !important;\n      }\n\n      body.is-scrolling .speed-line {\n        display: none;\n      }\n\n      .word-block {\n        transform: translateY(0);\n      }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"speed-line one\" aria-hidden=\"true\"></div>\n  <div class=\"speed-line two\" aria-hidden=\"true\"></div>\n  <div class=\"speed-line three\" aria-hidden=\"true\"></div>\n\n  <div class=\"page\">\n    <header class=\"masthead\">\n      <div>\n        <div class=\"masthead-latin\">SOLE / KEY / STREET</div>\n        <div class=\"shop-mark\">街角修鞋 · 配钥匙 · 不绕弯</div>\n      </div>\n      <a class=\"phone-link\" href=\"tel:13800138000\" aria-label=\"电话预约 13800138000\">打电话，约时间</a>\n    </header>\n\n    <main class=\"hero\">\n      <div class=\"hero-intro\">\n        <p class=\"eyebrow\">S16 / NORTH STREET / OPEN NOW</p>\n        <h1>鞋底要跑，钥匙要响。</h1>\n        <p class=\"intro-copy\">旧鞋别扔，旧锁别慌。带到街口，我们把它们修回能继续冲的样子。</p>\n      </div>\n\n      <div class=\"progress\" aria-label=\"服务进度尺\">\n        <span class=\"progress-label\">01—05 / 现在排到你</span>\n      </div>\n\n      <section class=\"slant-stage\" aria-label=\"店铺服务\">\n        <div class=\"slant-track\">\n          <article class=\"word-block block-1\" data-index=\"01\" tabindex=\"0\">\n            <span class=\"block-number\">01</span>\n            <span class=\"block-title\">补鞋</span>\n            <span class=\"block-note\">鞋底裂了？别让它替你退休。</span>\n            <img class=\"block-image\" src=\"images/占位-1.jpg\" width=\"370\" height=\"159\" alt=\"修鞋工具与鞋底\">\n          </article>\n\n          <article class=\"word-block block-2\" data-index=\"02\" tabindex=\"0\">\n            <span class=\"block-number\">02</span>\n            <span class=\"block-title\">配钥匙</span>\n            <span class=\"block-note\">一把旧钥匙，现场给你复制出下一把。</span>\n            <img class=\"block-image\" src=\"images/占位-2.jpg\" width=\"250\" height=\"188\" alt=\"钥匙胚与配钥匙机器\">\n          </article>\n\n          <article class=\"word-block block-3\" data-index=\"03\" tabindex=\"0\">\n            <span class=\"block-number\">03</span>\n            <span class=\"block-title\">换底</span>\n            <span class=\"block-note\">抓地力回来，脚步就不用收着。</span>\n            <img class=\"block-image\" src=\"images/占位-3.jpg\" width=\"320\" height=\"180\" alt=\"正在更换鞋底的鞋子\">\n          </article>\n\n          <article class=\"word-block block-4\" data-index=\"04\" tabindex=\"0\">\n            <span class=\"block-number\">04</span>\n            <span class=\"block-title\">修拉链</span>\n            <span class=\"block-note\">卡住的不是生活，是这一颗小齿。</span>\n            <img class=\"block-image\" src=\"images/占位-4.jpg\" width=\"210\" height=\"158\" alt=\"拉链修理细节\">\n          </article>\n\n          <article class=\"word-block block-5\" data-index=\"05\" tabindex=\"0\">\n            <span class=\"block-number\">05</span>\n            <span class=\"block-title\">电话预约</span>\n            <span class=\"block-note\">你说时间，我们把工具先摆上台。</span>\n            <img class=\"block-image\" src=\"images/占位-5.jpg\" width=\"290\" height=\"193\" alt=\"店铺工作台与电话\">\n            <a class=\"block-action\" href=\"tel:13800138000\">现在打 138 0013 8000</a>\n          </article>\n        </div>\n      </section>\n    </main>\n\n    <footer class=\"footer\">\n      <p>不收漂亮话，只收需要修好的东西。周一至周六，09:00—19:00。</p>\n      <div class=\"latin\">KEEP<br>MOVING.</div>\n    </footer>\n  </div>\n\n  <script>\n    (() => {\n      const blocks = [...document.querySelectorAll(\".word-block\")];\n      const progress = document.querySelector(\".progress\");\n      let scrollTimer;\n\n      window.addEventListener(\"scroll\", () => {\n        document.body.classList.add(\"is-scrolling\");\n        clearTimeout(scrollTimer);\n        scrollTimer = setTimeout(() => {\n          document.body.classList.remove(\"is-scrolling\");\n        }, 180);\n      }, { passive: true });\n\n      blocks.forEach((block, index) => {\n        block.addEventListener(\"click\", () => {\n          block.style.transform = \"translateX(-12px)\";\n          progress.style.setProperty(\"--pointer\", `${index * 25}%`);\n          window.setTimeout(() => {\n            block.style.transform = \"\";\n          }, 240);\n        });\n      });\n    })();\n  </script>\n</body>\n</html>"
        }
      }
