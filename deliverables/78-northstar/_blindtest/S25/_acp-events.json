        "messageId": "a715f5c7-e9cc-4f3f-829b-44133cac1b28",
        "content": {
          "type": "text",
          "text": " <!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>老周鞋钥匙铺｜手工目录</title>\n<style>\n:root{\n  --spot-a:#914A27;\n  --paper:#E8E4DE;\n  --ink:#1E1A16;\n  --spot-b:#2E6B5E;\n  --paper-deep:#DFDAD2;\n  --paper-white:#FFFFFF;\n  --derived:#181C0D;\n  --spine:72px;\n}\n*{box-sizing:border-box}\nhtml{background:var(--paper);color:var(--ink);scroll-behavior:smooth}\nbody{\n  margin:0;\n  background:var(--paper);\n  color:var(--ink);\n  font-family:\"Noto Serif SC\",\"Songti SC\",Georgia,serif;\n  font-size:16px;\n  line-height:1.55;\n  cursor:none;\n}\nbody:before{\n  content:\"\";\n  position:fixed;\n  inset:0;\n  pointer-events:none;\n  background:var(--paper);\n  z-index:-2;\n}\nh1,h2,h3,p,ul{margin:0}\nh1,h2,h3,.display,.index-mark,.label{\n  font-family:Besley,\"Noto Serif SC\",Georgia,serif;\n  font-weight:400;\n}\na{color:inherit;text-decoration:none}\nbutton{font:inherit}\n.page{\n  width:min(1440px,100%);\n  margin:auto;\n  position:relative;\n  padding:32px 4vw 56px;\n}\n.spine{\n  position:fixed;\n  z-index:10;\n  top:0;\n  bottom:0;\n  left:calc(30% + var(--spine) / 2);\n  width:var(--spine);\n  pointer-events:none;\n}\n.spine-line{\n  position:absolute;\n  top:0;\n  bottom:0;\n  left:calc(50% + 12px);\n  width:1.2px;\n  background:var(--spot-a);\n  transform:rotate(.14deg);\n  transform-origin:center;\n}\n.spine-line:after{\n  content:\"\";\n  position:absolute;\n  top:calc(50% - 112px);\n  left:0;\n  width:3px;\n  height:84px;\n  background:var(--spot-a);\n  transform:skewY(2deg);\n}\n.holes{\n  position:absolute;\n  inset:0 0 0 calc(50% + 12px);\n  display:flex;\n  flex-direction:column;\n  justify-content:space-around;\n  padding:42px 0;\n}\n.hole{\n  width:1.6px;\n  height:1.6px;\n  margin-left:-.2px;\n  background:var(--ink);\n  display:block;\n  transition:background 120ms ease;\n}\n.hole.active{background:var(--paper-white)}\n.thread{\n  position:absolute;\n  top:0;\n  bottom:0;\n  left:calc(50% + 10.8px);\n  width:1.2px;\n  border-left:1.2px solid var(--spot-b);\n  transform:rotate(-.18deg);\n}\n.cursor{\n  position:fixed;\n  z-index:50;\n  width:22px;\n  height:22px;\n  pointer-events:none;\n  transform:translate(-2px,-2px);\n}\n.cursor:before,.cursor:after{\n  content:\"\";\n  position:absolute;\n  background:var(--spot-a);\n}\n.cursor:before{width:1.2px;height:22px;left:10px;top:0;transform:rotate(38deg)}\n.cursor:after{width:1.2px;height:22px;left:10px;top:0;transform:rotate(-38deg)}\n.layout{\n  display:grid;\n  grid-template-columns:3fr 7fr;\n  column-gap:var(--spine);\n  align-items:start;\n}\n.left{\n  min-width:0;\n  position:relative;\n  z-index:2;\n}\n.right{\n  min-width:0;\n  position:relative;\n  z-index:1;\n  transform-origin:top center;\n}\n.kicker{\n  color:var(--spot-b);\n  letter-spacing:.08em;\n  font-size:13px;\n  border-bottom:1.2px solid var(--spot-b);\n  padding-bottom:8px;\n  margin-bottom:34px;\n}\n.display{\n  font-size:clamp(48px,6.2vw,68px);\n  line-height:1.02;\n  letter-spacing:-.06em;\n  margin-left:0;\n  max-width:5em;\n}\n.display em{\n  color:var(--spot-a);\n  font-style:normal;\n  display:block;\n  margin-left:24px;\n}\n.intro{\n  margin-top:34px;\n  margin-left:12px;\n  max-width:23em;\n  font-size:17px;\n}\n.intro strong{\n  color:var(--spot-b);\n  font-weight:400;\n}\n.contents{\n  margin-top:70px;\n  border-top:2px solid var(--ink);\n}\n.contents a{\n  display:block;\n  padding:12px 0 12px var(--indent,0);\n  border-bottom:1px solid var(--ink);\n  position:relative;\n  transition:padding-left 120ms ease;\n}\n.contents a:after{\n  content:\"····\";\n  position:absolute;\n  right:0;\n  top:11px;\n  letter-spacing:5px;\n  color:var(--spot-a);\n  transition:letter-spacing 120ms ease, right 120ms ease;\n}\n.contents a:hover:after{letter-spacing:7px;right:1px}\n.contents a:nth-child(1){--indent:0}\n.contents a:nth-child(2){--indent:12px}\n.contents a:nth-child(3){--indent:24px}\n.contents a:nth-child(4){--indent:12px}\n.contents a:nth-child(5){--indent:24px}\n.contents small{display:block;color:var(--spot-b);font-size:12px;line-height:1.2}\n.contents span{display:block;padding-right:50px}\n.issue{\n  margin-top:40px;\n  display:flex;\n  justify-content:space-between;\n  gap:12px;\n  border-top:1.2px solid var(--ink);\n  padding-top:12px;\n  font-size:12px;\n}\n.issue b{font-weight:400;color:var(--spot-a)}\n.cta{\n  display:inline-block;\n  margin-top:28px;\n  padding:13px 18px 12px;\n  border:2px solid var(--spot-a);\n  color:var(--spot-a);\n  background:var(--paper);\n  transition:background 120ms ease,color 120ms ease;\n}\n.cta:hover{background:var(--spot-a);color:var(--paper-white)}\n.section-head{\n  display:grid;\n  grid-template-columns:1.1fr 1.9fr;\n  gap:24px;\n  border-bottom:2px solid var(--ink);\n  padding-bottom:18px;\n  margin-bottom:28px;\n}\n.section-head h2{font-size:34px;line-height:1.08}\n.section-head p{max-width:29em;margin-left:24px}\n.entry{\n  display:grid;\n  grid-template-columns:1.05fr 1.65fr;\n  gap:28px;\n  border-bottom:1.2px solid var(--ink);\n  padding:0 0 28px;\n  margin-bottom:28px;\n  position:relative;\n}\n.entry:nth-of-type(2){grid-template-columns:1.55fr 1fr}\n.entry:nth-of-type(3){grid-template-columns:1fr 1.35fr}\n.entry:nth-of-type(4){grid-template-columns:1.3fr 1fr}\n.entry:nth-of-type(5){grid-template-columns:1fr 1.55fr}\n.entry figure{\n  margin:0;\n  background:var(--paper-deep);\n  border:1.2px solid var(--ink);\n  padding:8px;\n  position:relative;\n}\n.entry figure:before{\n  content:\"\";\n  position:absolute;\n  top:8px;\n  left:8px;\n  right:-7px;\n  bottom:-7px;\n  border:1px solid var(--spot-b);\n  pointer-events:none;\n  mix-blend-mode:multiply;\n}\n.entry img{\n  display:block;\n  width:100%;\n  height:auto;\n  aspect-ratio:var(--ratio);\n  object-fit:cover;\n  border:0;\n  background:var(--paper-white);\n  filter:sepia(.12) saturate(.7);\n}\n.entry figcaption{\n  font-size:11px;\n  color:var(--spot-b);\n  padding-top:6px;\n}\n.entry-copy{padding-top:3px}\n.entry-number{\n  color:var(--spot-a);\n  font-size:13px;\n  letter-spacing:.12em;\n  margin-bottom:12px;\n}\n.entry h3{\n  font-size:29px;\n  line-height:1.12;\n  margin-bottom:12px;\n}\n.entry p{max-width:31em}\n.entry-meta{\n  display:flex;\n  justify-content:space-between;\n  gap:18px;\n  margin-top:18px;\n  padding-top:9px;\n  border-top:1px solid var(--spot-b);\n  color:var(--spot-b);\n  font-size:12px;\n}\n.overprint{\n  position:absolute;\n  width:68px;\n  height:68px;\n  right:14%;\n  top:26px;\n  border:3px solid var(--spot-a);\n  mix-blend-mode:multiply;\n  pointer-events:none;\n}\n.overprint:after{\n  content:\"\";\n  position:absolute;\n  inset:8px -7px -7px 8px;\n  border:3px solid var(--spot-b);\n  mix-blend-mode:multiply;\n}\n.overprint:hover{filter:brightness(.96);transition:filter 150ms ease}\n.footer{\n  margin-top:20px;\n  padding-top:14px;\n  border-top:2px solid var(--ink);\n  display:flex;\n  justify-content:space-between;\n  font-size:12px;\n  color:var(--spot-b);\n}\n@media (max-width:800px){\n  body{cursor:auto}\n  .cursor{display:none}\n  .page{padding:22px 20px 42px}\n  .spine{position:absolute;left:auto;right:24px;top:0;bottom:0;width:18px}\n  .spine-line{left:12px}\n  .thread{left:10.8px}\n  .holes{inset:0 auto 0 12px;width:2px}\n  .layout{display:block}\n  .left{padding-right:30px}\n  .right{margin-top:54px}\n  .display{font-size:clamp(48px,15vw,68px)}\n  .contents{margin-top:44px}\n  .section-head{grid-template-columns:1fr;gap:12px}\n  .section-head p{margin-left:12px}\n  .entry,.entry:nth-of-type(n){grid-template-columns:1fr;gap:18px}\n  .entry figure{max-width:calc(100% - 12px)}\n  .overprint{right:10%;top:18px}\n}\n@media (prefers-reduced-motion:reduce){\n  html{scroll-behavior:auto}\n  *,*:before,*:after{transition-duration:120ms!important;animation-duration:120ms!important}\n  .right{transform:none!important}\n}\n</style>\n</head>\n<body>\n<div class=\"cursor\" aria-hidden=\"true\"></div>\n\n<div class=\"spine\" aria-hidden=\"true\">\n  <div class=\"spine-line\"></div>\n  <div class=\"thread\"></div>\n  <div class=\"holes\">\n    <i class=\"hole\"></i><i class=\"hole\"></i><i class=\"hole\"></i><i class=\"hole\"></i>\n    <i class=\"hole\"></i><i class=\"hole\"></i><i class=\"hole\"></i><i class=\"hole\"></i>\n    <i class=\"hole\"></i><i class=\"hole\"></i><i class=\"hole\"></i><i class=\"hole\"></i>\n    <i class=\"hole\"></i><i class=\"hole\"></i><i class=\"hole\"></i><i class=\"hole\"></i>\n    <i class=\"hole\"></i><i class=\"hole\"></i><i class=\"hole\"></i><i class=\"hole\"></i>\n    <i class=\"hole\"></i><i class=\"hole\"></i><i class=\"hole\"></i><i class=\"hole\"></i>\n  </div>\n</div>\n\n<main class=\"page\">\n  <div class=\"layout\">\n    <aside class=\"left\">\n      <div class=\"kicker\">NORTHSTAR · 鞋与钥匙 · 01—05</div>\n      <h1 class=\"display\">把旧日子<br><em>再穿一遍</em></h1>\n      <p class=\"intro\">我们在街角做修补。鞋跟、拉链、钥匙，都是日子留下的小问题。<strong>拿来吧，慢慢看。</strong></p>\n\n      <nav class=\"contents\" aria-label=\"目录\">\n        <a href=\"#entry-01\"><small>01 / 鞋底</small><span>走得久的鞋，也值得一双新脚</span></a>\n        <a href=\"#entry-02\"><small>02 / 钥匙</small><span>给门配一把，给心留一把</span></a>\n        <a href=\"#entry-03\"><small>03 / 拉链</small><span>卡住的地方，不一定要换掉</span></a>\n        <a href=\"#entry-04\"><small>04 / 鞋面</small><span>皮面上的小伤，交给手工</span></a>\n        <a href=\"#entry-05\"><small>05 / 见面</small><span>打电话，约一个不赶的时间</span></a>\n      </nav>\n\n      <div class=\"issue\"><span>小店目录 · 2024</span><b>页码 005</b></div>\n      <a class=\"cta\" href=\"tel:010-58260127\">打电话约时间　→</a>\n    </aside>\n\n    <section class=\"right\" aria-label=\"服务目录\">\n      <header class=\"section-head\">\n        <h2>修补目录<br>给熟悉的东西</h2>\n        <p>这里没有流水线。每一件东西到了柜台，我们先看它还能陪你多久，再决定怎么动手。价格和时间，当面说清楚。</p>\n      </header>\n\n      <article class=\"entry\" id=\"entry-01\">\n        <figure style=\"--ratio:4 / 3\">\n          <img src=\"images/占位-1.jpg\" width=\"720\" height=\"540\" alt=\"一双磨旧的皮鞋放在木台上\">\n          <figcaption>图 01 · 鞋底与脚步</figcaption>\n        </figure>\n        <div class=\"entry-copy\">\n          <div class=\"entry-number\">01　SOLE / 鞋底</div>\n          <h3>旧鞋换底，<br>走路还是你的样子。</h3>\n          <p>先拆开，再判断能不能救。橡胶底、皮底、半掌，我们按你平常走的路来选，不把鞋修成陌生的样子。</p>\n          <div class=\"entry-meta\"><span>通常 1—3 天</span><span>到店看鞋报价</span></div>\n        </div>\n      </article>\n\n      <article class=\"entry\" id=\"entry-02\">\n        <div class=\"entry-copy\">\n          <div class=\"entry-number\">02　KEY / 钥匙</div>\n          <h3>一把新钥匙，<br>先替你试过门。</h3>\n          <p>普通门钥匙、信箱钥匙、老式铜钥匙都可以拿来。我们配好后会在机器上试转，再交到你手里。</p>\n          <div class=\"entry-meta\"><span>通常 5 分钟</span><span>常用胚有现货</span></div>\n        </div>\n        <figure style=\"--ratio:3 / 4\">\n          <img src=\"images/占位-2.jpg\" width=\"540\" height=\"720\" alt=\"一串钥匙和配钥匙工具\">\n          <figcaption>图 02 · 黄铜、钢与一点耐心</figcaption>\n        </figure>\n      </article>\n\n      <article class=\"entry\" id=\"entry-03\">\n        <figure style=\"--ratio:16 / 10\">\n          <img src=\"images/占位-3.jpg\" width=\"800\" height=\"500\" alt=\"皮包上的拉链细节\">\n          <figcaption>图 03 · 拉链齿一颗颗对齐</figcaption>\n        </figure>\n        <div class=\"entry-copy\">\n          <div class=\"entry-number\">03　ZIP / 拉链</div>\n          <h3>卡住的地方，<br>不用马上告别。</h3>\n          <p>拉链头、齿、底止，坏的地方不一样，修法也不一样。包、外套、鞋靴，带来让我们摸一摸。</p>\n          <div class=\"entry-meta\"><span>通常 30 分钟起</span><span>复杂情况需留店</span></div>\n        </div>\n      </article>\n\n      <article class=\"entry\" id=\"entry-04\">\n        <div class=\"entry-copy\">\n          <div class=\"entry-number\">04　LEATHER / 鞋面</div>\n          <h3>小伤口缝好，<br>旧皮面继续发亮。</h3>\n          <p>刮痕、开线、脱胶，我们尽量保留原来的颜色和手感。留下的痕迹不是难看，是它走过的路。</p>\n          <div class=\"entry-meta\"><span>通常 2—5 天</span><span>颜色需现场比对</span></div>\n        </div>\n        <figure style=\"--ratio:5 / 6\">\n          <img src=\"images/占位-4.jpg\" width=\"600\" height=\"720\" alt=\"手工缝补皮革的针线\">\n          <figcaption>图 04 · 针脚不必假装一样</figcaption>\n        </figure>\n      </article>\n\n      <article class=\"entry\" id=\"entry-05\">\n        <figure style=\"--ratio:3 / 2\">\n          <img src=\"images/占位-5.jpg\" width=\"750\" height=\"500\" alt=\"店门口的工作台和暖光\">\n          <figcaption>图 05 · 门口见，别在电话里猜</figcaption>\n        </figure>\n        <div class=\"entry-copy\">\n          <div class=\"entry-number\">05　MEET / 见面</div>\n          <h3>打个电话，<br>约一个不赶的时间。</h3>\n          <p>我们在老街北口，周一到周六都在。你说说是什么东西，我们先告诉你值不值得修，再为你留时间。</p>\n          <div class=\"entry-meta\"><span>010-58260127</span><span>老街北口 · 12 号</span></div>\n        </div>\n      </article>\n\n      <div class=\"overprint\" aria-hidden=\"true\"></div>\n      <footer class=\"footer\"><span>老周鞋钥匙铺 / 手工目录</span><span>01—05 · 纸上见</span></footer>\n    </section>\n  </div>\n</main>\n\n<script>\n(function(){\n  const cursor=document.querySelector('.cursor');\n  const right=document.querySelector('.right');\n  const holes=[...document.querySelectorAll('.hole')];\n  const reduce=window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n\n  window.addEventListener('mousemove',e=>{\n    cursor.style.left=e.clientX+'px';\n    cursor.style.top=e.clientY+'px';\n  });\n\n  if(!reduce){\n    let ticking=false;\n    window.addEventListener('scroll',()=>{\n      if(ticking)return;\n      ticking=true;\n      requestAnimationFrame(()=>{\n        const progress=Math.min(window.scrollY/900,1);\n        right.style.transform='scaleY('+(1-progress*.06)+')';\n        ticking=false;\n      });\n    },{passive:true});\n  }\n\n  document.querySelectorAll('.contents a').forEach((link,index)=>{\n    link.addEventListener('click',()=>{\n      holes[(index*4+3)%holes.length].classList.add('active');\n      setTimeout(()=>holes[(index*4+3)%holes.length].classList.remove('active'),520);\n    });\n  });\n\n  document.querySelectorAll('.entry').forEach((entry,index)=>{\n    entry.style.animation='entryIn 180ms ease '+(120+index*80)+'ms both';\n  });\n})();\n</script>\n<style>\n@keyframes entryIn{\n  from{opacity:0;transform:translateY(8px)}\n  to{opacity:1;transform:translateY(0)}\n}\n</style>\n</body>\n</html>"
        }
      }
    }
  },
