ion-delay: 200ms; }\n  .page.loaded .line-item:nth-child(5) { animation-delay: 260ms; }\n  .page.loaded .line-item:nth-child(6) { animation-delay: 320ms; }\n\n  .page.loaded .total {\n    animation: total-in 200ms steps(3, end) 560ms both;\n  }\n\n  .stub-torn .hero-stub,\n  .stub-torn .ledger-stub {\n    transform: translateX(6px);\n    transition: transform 160ms steps(2, end);\n  }\n\n  .stub-torn .perforation {\n    transform: translateX(6px);\n    transition: transform 160ms steps(2, end);\n  }\n\n  .stub-return .hero-stub,\n  .stub-return .ledger-stub,\n  .stub-return .perforation {\n    transform: translateX(0);\n    transition: transform 160ms steps(2, end);\n  }\n\n  @keyframes press-in {\n    from { opacity: 0; transform: translateY(12px); }\n    to { opacity: 1; transform: translateY(0); }\n  }\n\n  @keyframes total-in {\n    from { opacity: 0; transform: translateY(8px); }\n    to { opacity: 1; transform: translateY(0); }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .page.loaded .line-item,\n    .page.loaded .total {\n      animation: none;\n    }\n\n    .stub-torn .hero-stub,\n    .stub-torn .ledger-stub,\n    .stub-torn .perforation,\n    .stub-return .hero-stub,\n    .stub-return .ledger-stub,\n    .stub-return .perforation {\n      transform: none;\n      transition: opacity 100ms linear;\n    }\n  }\n\n  @media (max-width: 760px) {\n    body {\n      font-size: 16px;\n    }\n\n    .page {\n      padding: 18px 16px 24px;\n    }\n\n    .masthead,\n    .hero,\n    .ledger,\n    .footer {\n      grid-template-columns: 1fr;\n    }\n\n    .perforation {\n      display: none;\n    }\n\n    .masthead-stub,\n    .hero-stub,\n    .ledger-stub {\n      border-right: 0;\n      border-bottom: 0.8px solid var(--rule);\n      padding-right: 0;\n    }\n\n    .masthead-main,\n    .hero-main,\n    .ledger-main,\n    .footer-main {\n      padding-left: 0;\n    }\n\n    .hero {\n      min-height: 0;\n    }\n\n    .hero-stub {\n      padding-bottom: 28px;\n    }\n\n    .hero-main {\n      grid-template-columns: 1fr;\n      gap: 20px;\n    }\n\n    h1 {\n      max-width: none;\n      font-size: clamp(54px, 17vw, 78px);\n    }\n\n    .archive-strip {\n      grid-template-columns: 1fr 1fr;\n    }\n\n    .archive-strip img {\n      height: 76px;\n    }\n\n    .ledger-head,\n    .line-item {\n      grid-template-columns: 76px minmax(86px, 1fr) 72px;\n      column-gap: 8px;\n    }\n\n    .ledger-head span:nth-child(3),\n    .line-item .service {\n      display: none;\n    }\n\n    .line-item::after {\n      right: 84px;\n    }\n\n    .details {\n      grid-template-columns: 1fr;\n      gap: 18px;\n    }\n\n    .footer-main {\n      display: block;\n      padding-top: 10px;\n    }\n\n    .footer-main span,\n    .footer-main a {\n      display: block;\n      margin-bottom: 7px;\n    }\n  }\n</style>\n</head>\n<body>\n  <main class=\"page\" id=\"page\">\n    <header class=\"masthead\" aria-label=\"档案页眉\">\n      <div class=\"masthead-stub\">\n        <strong>REVENUE STAMP STUB</strong>\n        <span>北街修配所 · 预约对账联</span>\n      </div>\n      <div class=\"perforation\" aria-hidden=\"true\">\n        <i class=\"hole\"></i><i class=\"hole\"></i><i class=\"hole\"></i><i class=\"hole\"></i>\n        <i class=\"hole\"></i><i class=\"hole\"></i><i class=\"hole\"></i>\n        <i class=\"odd-hole\"></i>\n      </div>\n      <div class=\"masthead-main\">\n        <p>鞋履修复 / 配钥匙<br>来件登记与取件时刻</p>\n        <span class=\"issue-code\">NORTH-17 / 2024.06</span>\n      </div>\n    </header>\n\n    <section class=\"hero\" aria-labelledby=\"page-title\">\n      <div class=\"hero-stub\">\n        <p class=\"stub-label\">存根联 · 保留</p>\n        <h1 id=\"page-title\">修配<br>预约</h1>\n      </div>\n      <div class=\"perforation\" aria-hidden=\"true\">\n        <i class=\"hole\"></i><i class=\"hole\"></i><i class=\"hole\"></i><i class=\"hole\"></i>\n        <i class=\"hole\"></i><i class=\"hole\"></i><i class=\"hole\"></i><i class=\"hole\"></i>\n        