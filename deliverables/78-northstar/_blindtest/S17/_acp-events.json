<i class=\"hole\"></i>\n        <i class=\"hole\"></i><i class=\"hole\"></i><i class=\"hole\"></i><i class=\"hole\"></i>\n        <i class=\"hole\"></i><i class=\"hole\"></i><i class=\"hole\"></i><i class=\"hole\"></i>\n        <i class=\"hole\"></i><i class=\"hole\"></i>\n      </div>\n      <div class=\"ledger-main\">\n        <div class=\"ledger-head\">\n          <span>票号</span>\n          <span>来件</span>\n          <span>工序</span>\n          <span>预估</span>\n        </div>\n\n        <div class=\"line-item\" data-ticket=\"N-240601\" tabindex=\"0\">\n          <span class=\"date\">N-240601</span>\n          <span>黑色皮鞋</span>\n          <span class=\"service\">后跟换片</span>\n          <span class=\"amount\">¥ 48.00</span>\n        </div>\n        <div class=\"line-item\" data-ticket=\"N-240602\" tabindex=\"0\">\n          <span class=\"date\">N-240602</span>\n          <span>铜色钥匙</span>\n          <span class=\"service\">原样配制</span>\n          <span class=\"amount\">¥ 12.00</span>\n        </div>\n        <div class=\"line-item\" data-ticket=\"N-240603\" tabindex=\"0\">\n          <span class=\"date\">N-240603</span>\n          <span>棕色短靴</span>\n          <span class=\"service\">边油补色</span>\n          <span class=\"amount\">¥ 36.00</span>\n        </div>\n        <div class=\"line-item\" data-ticket=\"N-240604\" tabindex=\"0\">\n          <span class=\"date\">N-240604</span>\n          <span>门锁钥匙</span>\n          <span class=\"service\">双份复制</span>\n          <span class=\"amount\">¥ 16.00</span>\n        </div>\n        <div class=\"line-item\" data-ticket=\"N-240605\" tabindex=\"0\">\n          <span class=\"date\">N-240605</span>\n          <span>帆布鞋</span>\n          <span class=\"service\">鞋带孔加固</span>\n          <span class=\"amount\">¥ 28.00</span>\n        </div>\n\n        <div class=\"total\">\n          <span>登记合计</span>\n          <strong>¥ 140.00</strong>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"details\" aria-label=\"取件与