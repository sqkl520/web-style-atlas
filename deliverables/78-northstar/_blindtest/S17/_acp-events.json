olid var(--seal);\n    width: 35px;\n    height: 35px;\n    line-height: 32px;\n    text-align: center;\n  }\n\n  .hero-main {\n    padding: 30px 0 22px 28px;\n    display: grid;\n    grid-template-columns: 1.15fr .85fr;\n    gap: 32px;\n    align-items: end;\n  }\n\n  .hero-copy {\n    align-self: start;\n  }\n\n  .hero-copy h2 {\n    margin: 0 0 12px;\n    color: var(--ink);\n    font-size: 27px;\n    line-height: 1.25;\n    font-weight: 600;\n  }\n\n  .hero-copy p {\n    max-width: 34em;\n    margin: 0;\n  }\n\n  .hero-record {\n    align-self: end;\n    border-top: 1px solid var(--ink);\n    padding-top: 10px;\n    font-family: \"Sometype Mono\", monospace;\n    font-size: 13px;\n    line-height: 1.7;\n    font-variant-numeric: tabular-nums;\n  }\n\n  .hero-record div {\n    display: flex;\n    justify-content: space-between;\n    gap: 16px;\n  }\n\n  .hero-record span:last-child {\n    text-align: right;\n  }\n\n  .action {\n    display: inline-flex;\n    margin-top: 22px;\n    padding: 10px 16px;\n    border: 2px solid var(--seal);\n    background: var(--seal);\n    color: var(--paper);\n    cursor: pointer;\n    transition: background 120ms linear, color 120ms linear;\n  }\n\n  .action:hover,\n  .action:focus-visible {\n    background: var(--paper);\n    color: var(--seal);\n    outline: none;\n  }\n\n  .archive-strip {\n    display: grid;\n    grid-template-columns: 1.15fr .85fr 1.3fr .8fr;\n    gap: 10px;\n    padding: 14px 0;\n    border-bottom: 1px solid var(--rule);\n  }\n\n  .archive-strip figure {\n    margin: 0;\n    border: 1px solid var(--rule);\n    background: var(--stub);\n    overflow: hidden;\n  }\n\n  .archive-strip img {\n    display: block;\n    width: 100%;\n    height: 82px;\n    object-fit: cover;\n    border-bottom: 0.8px solid var(--rule);\n  }\n\n  figcaption {\n    padding: 6px 8px;\n    font-family: \"Sometype Mono\", monospace;\n    font-size: 11px;\n    line-height: 1.25;\n  }\n\n  .ledger {\n    display: grid;\n    grid-template-columns: 3fr 16px 9fr;\n    border-bottom: 1px solid var(--ink);\n  }\n\n  .ledger-stub {\n    padding: 18px 20px 18px 0;\n    background: var(--stub);\n    border-right: 0.8px solid var(--rule);\n  }\n\n  .ledger-stub h3,\n  .ledger-main h3 {\n    margin: 0 0 12px;\n    color: var(--ink);\n    font-size: 20px;\n    font-weight: 600;\n  }\n\n  .ledger-stub p {\n    margin: 0;\n    font-size: 14px;\n  }\n\n  .ledger-main {\n    padding: 18px 0 18px 28px;\n  }\n\n  .ledger-head,\n  .line-item {\n    display: grid;\n    grid-template-columns: 94px minmax(120px, 1.1fr) minmax(120px, 1fr) 88px;\n    align-items: center;\n    column-gap: 16px;\n  }\n\n  .ledger-head {\n    padding: 0 12px 8px;\n    border-bottom: 2px solid var(--ink);\n    color: var(--seal);\n    font-family: \"Sometype Mono\", monospace;\n    font-size: 12px;\n    font-variant-numeric: tabular-nums;\n  }\n\n  .line-item {\n    min-height: 42px;\n    padding: 7px 12px;\n    border-bottom: 0.5px solid var(--rule);\n    font-variant-numeric: tabular-nums;\n    transition: background 120ms linear;\n  }\n\n  .line-item:hover,\n  .line-item:focus-within {\n    background: var(--tone-hover);\n  }\n\n  .line-item::after {\n    content: attr(data-ticket);\n    position: absolute;\n    right: 110px;\n    color: var(--seal);\n    font-family: \"Sometype Mono\", monospace;\n    font-size: 11px;\n    opacity: 0;\n    transition: opacity 120ms linear;\n    pointer-events: none;\n  }\n\n  .line-item:hover::after,\n  .line-item:focus-within::after {\n    opacity: 1;\n  }\n\n  .line-item > * {\n    min-width: 0;\n  }\n\n  .line-item .date,\n  .line-item .amount,\n  .ledger-head span:first-child,\n  .ledger-head span:last-child {\n    font-family: \"Sometype Mono\", monospace;\n    font-size: 13px;\n  }\n\n  .amount,\n  .ledger-head span:last-child {\n    text-align: right;\n  }\n\n  .total {\n    display: grid;\n    grid-template-columns: 1fr 88px;\n    gap: 16px;\n    align-items: baseline;\n    padding: 14px 12px 0;\n 