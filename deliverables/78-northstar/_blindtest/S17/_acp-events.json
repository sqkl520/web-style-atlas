          "text": " <!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>北街修配所 · 存根联预约登记</title>\n<style>\n  @import url('https://fonts.googleapis.com/css2?family=Literata:wght@400;500;600;700&family=Noto+Serif+SC:wght@400;500;600;700&family=Sometype+Mono:wght@400;500;600&display=swap');\n\n  :root {\n    --ink: #5A2A50;\n    --paper: #E1D6BD;\n    --seal: #7A2E2E;\n    --stub: #C9BFA6;\n    --ink-deep: #3F1A38;\n    --rule: #B9A98C;\n    --tone-hover: #DFD6BF;\n    --tone-hold: #D6C9AC;\n  }\n\n  * {\n    box-sizing: border-box;\n  }\n\n  html {\n    background: var(--paper);\n    color: var(--ink-deep);\n    cursor: crosshair;\n  }\n\n  body {\n    margin: 0;\n    min-width: 320px;\n    background: var(--paper);\n    font-family: \"文津宋体\", \"WenJin Mincho SC\", \"Noto Serif SC\", \"Source Han Serif SC\", serif;\n    font-size: 17px;\n    line-height: 1.45;\n  }\n\n  a,\n  button {\n    color: inherit;\n    font: inherit;\n  }\n\n  a {\n    text-decoration: none;\n  }\n\n  .page {\n    width: min(1500px, 100%);\n    margin: 0 auto;\n    padding: 28px 34px 32px;\n  }\n\n  .masthead {\n    display: grid;\n    grid-template-columns: 3fr 16px 9fr;\n    gap: 0;\n    border-top: 2.4px solid var(--ink);\n    border-bottom: 1px solid var(--ink);\n    min-height: 88px;\n  }\n\n  .masthead-stub {\n    padding: 15px 22px 12px 0;\n    border-right: 0.8px solid var(--rule);\n  }\n\n  .masthead-stub strong {\n    display: block;\n    color: var(--seal);\n    font-family: \"Sometype Mono\", monospace;\n    font-size: 13px;\n    letter-spacing: .08em;\n    font-weight: 600;\n  }\n\n  .masthead-stub span {\n    display: block;\n    margin-top: 6px;\n    font-size: 14px;\n  }\n\n  .masthead-main {\n    padding: 15px 0 12px 28px;\n    display: flex;\n    justify-content: space-between;\n    align-items: end;\n    gap: 24px;\n  }\n\n  .masthead-main p {\n    margin: 0;\n    font-siz