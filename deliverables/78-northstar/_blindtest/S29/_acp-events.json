        "messageId": "ca055477-6e6c-4dd5-aa1d-f86d0b124fb9",
        "content": {
          "type": "text",
          "text": " <!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>S29 修鞋与配钥匙作业规程</title>\n<style>\n:root {\n  --amber: #644F02;\n  --paper: #D9D3C4;\n  --ink: #1A1A17;\n  --gray: #5A6068;\n  --bright: #E4B400;\n  --row: #E0DACB;\n  --wire: 1.2px;\n}\n* { box-sizing: border-box; }\nhtml { scroll-behavior: smooth; }\nbody {\n  margin: 0;\n  background: var(--paper);\n  color: var(--ink);\n  font-family: \"Noto Sans SC\";\n  font-size: 16px;\n  line-height: 1.55;\n  cursor: none;\n}\nbody::before {\n  content: \"\";\n  position: fixed;\n  z-index: 30;\n  top: 0;\n  left: 0;\n  width: 72px;\n  height: 100vh;\n  pointer-events: none;\n  background:\n    radial-gradient(circle at 26px 22px, var(--paper) 0 4px, var(--ink) 4.1px 5.6px, var(--paper) 5.7px 9px);\n  background-size: 72px 18px;\n  background-position: 0 4px;\n  border-right: 0.6px solid var(--gray);\n}\nbody::after {\n  content: \"\";\n  position: fixed;\n  z-index: 31;\n  top: 0;\n  left: 25px;\n  width: 1.2px;\n  height: 100vh;\n  pointer-events: none;\n  background: var(--gray);\n}\na { color: inherit; }\nbutton { font: inherit; }\n.page {\n  width: calc(100% - 72px);\n  margin-left: 72px;\n  overflow: hidden;\n}\n.mono,\n.number,\n.price,\n.part-no,\ntable,\n.spec-value {\n  font-family: \"Martian Mono\";\n  font-variant-numeric: tabular-nums;\n}\n.topline {\n  min-height: 34px;\n  padding: 8px 5vw;\n  border-bottom: 1px solid var(--ink);\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  color: var(--gray);\n  font-family: \"Martian Mono\";\n  font-size: 11px;\n  letter-spacing: .08em;\n}\n.hero {\n  min-height: 680px;\n  padding: 7vh 5vw 8vh;\n  display: grid;\n  grid-template-columns: minmax(0, 1.18fr) minmax(280px, .82fr);\n  gap: 7vw;\n  align-items: end;\n  border-bottom: 2px solid var(--ink);\n}\n.kicker {\n  margin-bottom: 22px;\n  color: var(--amber);\n  font-family: \"Martian Mono\";\n  font-size: 12px;\n  letter-spacing: .11em;\n}\nh1, h2, h3 {\n  margin: 0;\n  font-family: \"Saira Condensed\", \"Noto Sans SC\";\n  font-weight: 700;\n  letter-spacing: -.035em;\n  line-height: .93;\n}\nh1 {\n  max-width: 780px;\n  font-size: clamp(52px, 7.3vw, 75px);\n  text-transform: uppercase;\n}\n.hero-copy {\n  max-width: 620px;\n  margin-top: 28px;\n  color: var(--gray);\n}\n.hero-meta {\n  align-self: stretch;\n  border-left: 3px solid var(--amber);\n  padding: 18px 0 0 24px;\n  display: flex;\n  flex-direction: column;\n  justify-content: space-between;\n}\n.meta-label {\n  color: var(--gray);\n  font-family: \"Martian Mono\";\n  font-size: 11px;\n  letter-spacing: .08em;\n}\n.meta-value {\n  margin-top: 5px;\n  font-family: \"Martian Mono\";\n  font-size: clamp(28px, 4vw, 48px);\n  line-height: 1;\n}\n.call-button {\n  width: 100%;\n  min-height: 66px;\n  margin-top: 28px;\n  padding: 15px 18px;\n  border: 2px solid var(--ink);\n  background: var(--bright);\n  color: var(--ink);\n  text-decoration: none;\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  font-family: \"Martian Mono\";\n  font-size: 13px;\n  letter-spacing: .04em;\n  transition: background 100ms linear, color 100ms linear;\n}\n.call-button:hover { background: var(--amber); color: var(--paper); }\n.index {\n  position: sticky;\n  z-index: 10;\n  top: 0;\n  min-height: 48px;\n  padding: 0 5vw;\n  border-bottom: 1px solid var(--ink);\n  background: var(--paper);\n  display: flex;\n  align-items: stretch;\n  gap: 0;\n}\n.index a {\n  min-width: 110px;\n  padding: 14px 16px 11px;\n  border-right: 0.6px solid var(--gray);\n  color: var(--gray);\n  text-decoration: none;\n  font-family: \"Martian Mono\";\n  font-size: 11px;\n  transition: color 100ms linear, background 100ms linear;\n}\n.index a:first-child { border-left: 0.6px solid var(--gray); }\n.index a.active,\n.index a:hover { color: var(--ink); background: var(--row); }\n.chapter {\n  position: relative;\n  padding: 86px 5vw 96px;\n  border-bottom: 1px solid var(--ink);\n}\n.chapter-grid {\n  display: grid;\n  grid-template-columns: 48px minmax(0, 1fr);\n  gap: 24px;\n}\n.chapter-no {\n  padding-top: 5px;\n  color: var(--amber);\n  font-family: \"Martian Mono\";\n  font-size: 14px;\n  writing-mode: vertical-rl;\n  letter-spacing: .1em;\n}\n.chapter-head {\n  display: grid;\n  grid-template-columns: minmax(220px, .7fr) minmax(280px, 1fr);\n  gap: 7vw;\n  align-items: start;\n  margin-bottom: 54px;\n}\n.chapter h2 {\n  font-size: clamp(38px, 5vw, 62px);\n  text-transform: uppercase;\n}\n.chapter-lead {\n  max-width: 560px;\n  color: var(--gray);\n  border-left: 1px solid var(--amber);\n  padding-left: 18px;\n}\n.warning {\n  position: relative;\n  overflow: hidden;\n  margin: 0 0 50px;\n  padding: 18px 22px;\n  border: 2px solid var(--amber);\n  background-color: var(--bright);\n  display: flex;\n  gap: 20px;\n  align-items: flex-start;\n}\n.warning::before {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  pointer-events: none;\n  background: repeating-linear-gradient(45deg, var(--amber) 0 8px, var(--bright) 8px 16px);\n  opacity: .18;\n  mix-blend-mode: multiply;\n  transition: transform 160ms linear;\n}\n.warning:hover::before { transform: translate(8px, 8px); }\n.warning > * { position: relative; z-index: 1; }\n.warning-mark {\n  min-width: 36px;\n  height: 36px;\n  border: 2px solid var(--ink);\n  display: grid;\n  place-items: center;\n  font-family: \"Martian Mono\";\n  font-weight: 700;\n}\n.warning strong {\n  display: block;\n  margin-bottom: 4px;\n  font-family: \"Martian Mono\";\n  font-size: 12px;\n  letter-spacing: .08em;\n}\n.warning p { margin: 0; }\n.content-split {\n  display: grid;\n  grid-template-columns: minmax(0, .9fr) minmax(300px, 1.1fr);\n  gap: 6vw;\n  align-items: start;\n}\n.content-split.reverse { grid-template-columns: minmax(300px, 1.1fr) minmax(0, .9fr); }\n.image-frame {\n  margin: 0;\n  border: 1px solid var(--ink);\n  background: var(--row);\n}\n.image-frame img {\n  display: block;\n  width: 100%;\n  height: auto;\n  aspect-ratio: 4 / 3;\n  object-fit: cover;\n  filter: grayscale(1) sepia(.18) contrast(1.08);\n}\n.image-frame figcaption {\n  min-height: 38px;\n  padding: 8px 12px;\n  border-top: 1px solid var(--ink);\n  display: flex;\n  justify-content: space-between;\n  color: var(--gray);\n  font-family: \"Martian Mono\";\n  font-size: 10px;\n}\n.procedure {\n  display: grid;\n  gap: 0;\n  border-top: 1px solid var(--ink);\n}\n.procedure-item {\n  display: grid;\n  grid-template-columns: 42px 1fr;\n  gap: 16px;\n  padding: 17px 0;\n  border-bottom: 0.6px solid var(--gray);\n}\n.procedure-item .number { color: var(--amber); font-size: 12px; }\n.procedure-item strong { display: block; margin-bottom: 4px; }\n.procedure-item p { margin: 0; color: var(--gray); }\n.image-stack {\n  display: grid;\n  grid-template-columns: 1.15fr .85fr;\n  gap: 18px;\n  align-items: end;\n}\n.image-stack .image-frame:first-child { margin-top: 44px; }\n.image-stack .image-frame img { aspect-ratio: 3 / 4; }\n.image-stack .image-frame:last-child img { aspect-ratio: 1 / 1; }\n.diagram {\n  border: 1px solid var(--ink);\n  background: var(--paper);\n  padding: 16px;\n}\n.diagram svg {\n  display: block;\n  width: 100%;\n  height: auto;\n  min-height: 290px;\n}\n.diagram line,\n.diagram polyline,\n.diagram rect,\n.diagram circle {\n  fill: none;\n  stroke: var(--ink);\n  stroke-width: .6px;\n  vector-effect: non-scaling-stroke;\n  transition: stroke-width 120ms linear;\n}\n.diagram .axis { stroke: var(--gray); stroke-dasharray: 3 5; }\n.diagram text {\n  fill: var(--ink);\n  stroke: none;\n  font-family: \"Martian Mono\";\n  font-size: 11px;\n}\n.diagram .part { cursor: pointer; }\n.diagram .part:hover line,\n.diagram .part:hover polyline,\n.diagram .part:hover rect,\n.diagram .part:hover circle {\n  stroke-width: 1.2px;\n}\n.diagram-label {\n  display: flex;\n  justify-content: space-between;\n  border-top: 1px solid var(--ink);\n  padding-top: 10px;\n  color: var(--gray);\n  font-family: \"Martian Mono\";\n  font-size: 10px;\n}\n.spec-wrap {\n  margin: 18px -96px 0 0;\n  border-top: 2px solid var(--ink);\n  border-bottom: 1px solid var(--ink);\n}\n.spec-title {\n  padding: 12px 14px;\n  background: var(--amber);\n  color: var(--paper);\n  font-family: \"Martian Mono\";\n  font-size: 12px;\n  letter-spacing: .08em;\n}\ntable {\n  width: 100%;\n  border-collapse: collapse;\n  font-size: 12px;\n}\nth, td {\n  padding: 13px 14px;\n  border-bottom: 0.6px solid var(--gray);\n  text-align: left;\n  white-space: nowrap;\n}\nth {\n  color: var(--gray);\n  font-size: 10px;\n  font-weight: 400;\n}\ntd:not(:first-child), th:not(:first-child) { text-align: right; }\ntbody tr { transition: background 100ms linear; }\ntbody tr:hover, tbody tr.flash { background: var(--row); }\n.ghost-row td { height: 42px; color: var(--paper); }\n.price-block {\n  margin-top: 42px;\n  padding: 20px 0 0;\n  border-top: 1px solid var(--ink);\n  display: flex;\n  justify-content: space-between;\n  align-items: end;\n}\n.price-label { color: var(--gray); }\n.price { font-size: 28px; }\n.booking-grid {\n  display: grid;\n  grid-template-columns: 1.25fr .75fr;\n  gap: 7vw;\n  align-items: start;\n}\n.booking-note {\n  max-width: 630px;\n  color: var(--gray);\n  font-size: 18px;\n}\n.contact-box {\n  border: 2px solid var(--ink);\n  padding: 22px;\n}\n.contact-box dl {\n  margin: 0;\n  display: grid;\n  grid-template-columns: 1fr auto;\n  gap: 9px 18px;\n  font-family: \"Martian Mono\";\n  font-size: 12px;\n}\n.contact-box dt { color: var(--gray); }\n.contact-box dd { margin: 0; text-align: right; }\n.footer {\n  padding: 26px 5vw 38px;\n  display: flex;\n  justify-content: space-between;\n  gap: 24px;\n  color: var(--gray);\n  font-family: \"Martian Mono\";\n  font-size: 10px;\n}\n.cursor-wrench {\n  position: fixed;\n  z-index: 100;\n  width: 24px;\n  height: 24px;\n  pointer-events: none;\n  transform: translate(-4px, -4px) rotate(-38deg);\n}\n.cursor-wrench::before {\n  content: \"\";\n  position: absolute;\n  left: 10px;\n  top: 5px;\n  width: 4px;\n  height: 17px;\n  border: 1.2px solid var(--ink);\n  background: var(--bright);\n}\n.cursor-wrench::after {\n  content: \"\";\n  position: absolute;\n  left: 5px;\n  top: 1px;\n  width: 12px;\n  height: 12px;\n  border: 2px solid var(--ink);\n  background: var(--paper);\n  clip-path: polygon(0 0, 100% 0, 100% 35%, 65% 35%, 65% 100%, 35% 100%, 35% 35%, 0 35%);\n}\n.js-ready .chapter,\n.js-ready .hero-meta,\n.js-ready .warning,\n.js-ready .content-split,\n.js-ready .booking-grid {\n  opacity: 0;\n  transform: translateY(12px);\n}\n.js-ready .chapter.revealed,\n.js-ready .hero-meta.revealed,\n.js-ready .warning.revealed,\n.js-ready .content-split.revealed,\n.js-ready .booking-grid.revealed {\n  opacity: 1;\n  transform: translateY(0);\n  transition: opacity 240ms linear, transform 240ms linear;\n}\n@media (prefers-reduced-motion: reduce) {\n  html { scroll-behavior: auto; }\n  *, *::before, *::after {\n    animation-duration: 0.001ms !important;\n    animation-iteration-count: 1 !important;\n    transition-duration: 120ms !important;\n  }\n  .js-ready .chapter,\n  .js-ready .hero-meta,\n  .js-ready .warning,\n  .js-ready .content-split,\n  .js-ready .booking-grid {\n    opacity: 1;\n    transform: none;\n  }\n  .warning:hover::before { transform: none; }\n}\n@media (max-width: 850px) {\n  body::before, body::after { display: none; }\n  body { cursor: auto; }\n  .cursor-wrench { display: none; }\n  .page { width: 100%; margin-left: 0; }\n  .hero,\n  .chapter-head,\n  .content-split,\n  .content-split.reverse,\n  .booking-grid {\n    grid-template-columns: 1fr;\n  }\n  .hero { min-height: auto; gap: 48px; }\n  .hero-meta { min-height: 260px; }\n  .index { overflow-x: auto; }\n  .index a { min-width: 94px; }\n  .image-stack { grid-template-columns: 1fr 1fr; }\n  .spec-wrap { margin-right: -5vw; }\n}\n@media (max-width: 560px) {\n  .topline { padding: 8px 5vw; }\n  .topline span:last-child { display: none; }\n  .hero, .chapter { padding-left: 5vw; padding-right: 5vw; }\n  .chapter-grid { grid-template-columns: 1fr; gap: 20px; }\n  .chapter-no { writing-mode: horizontal-tb; }\n  .image-stack { grid-template-columns: 1fr; }\n  .image-stack .image-frame:first-child { margin-top: 0; }\n  .spec-wrap { margin-right: -5vw; overflow-x: auto; }\n  table { min-width: 620px; }\n  .footer { flex-direction: column; }\n}\n</style>\n</head>\n<body>\n<div class=\"cursor-wrench\" aria-hidden=\"true\"></div>\n\n<main class=\"page\">\n  <div class=\"topline\">\n    <span>S29 / 现场服务规程</span>\n    <span>REV. 04 · 1987 / 维修柜台版</span>\n  </div>\n\n  <header class=\"hero\" id=\"top\">\n    <div>\n      <div class=\"kicker\">01 / 接收与预约 · SERVICE INTAKE</div>\n      <h1>鞋底、钥匙、<br>按规程处理。</h1>\n      <p class=\"hero-copy\">\n        先确认故障，再安排时间。修鞋与配钥匙不是临时手艺，是一套可复核的柜台作业。\n        每一件交付物都挂在编号上，电话预约从这里开始。\n      </p>\n    </div>\n    <aside class=\"hero-meta\">\n      <div>\n        <div class=\"meta-label\">营业状态 / COUNTER STATUS</div>\n        <div class=\"meta-value\">OPEN / 09—18</div>\n      </div>\n      <div>\n        <div class=\"meta-label\">作业编号 / JOB CODE</div>\n        <div class=\"meta-value\">S29—023</div>\n        <a class=\"call-button\" href=\"tel:010-6487-2307\">\n          <span>电话预约</span>\n          <span>010—6487—2307 ↗</span>\n        </a>\n      </div>\n    </aside>\n  </header>\n\n  <nav class=\"index\" aria-label=\"章节索引\">\n    <a href=\"#ch01\" data-section=\"ch01\">01 接收</a>\n    <a href=\"#ch02\" data-section=\"ch02\">02 判断</a>\n    <a href=\"#ch03\" data-section=\"ch03\">03 修鞋</a>\n    <a href=\"#ch04\" data-section=\"ch04\">04 配钥匙</a>\n    <a href=\"#ch05\" data-section=\"ch05\">05 交付</a>\n  </nav>\n\n  <section class=\"chapter\" id=\"ch01\">\n    <div class=\"chapter-grid\">\n      <div class=\"chapter-no\">CH—01</div>\n      <div>\n        <div class=\"chapter-head\">\n          <h2>接收<br>登记</h2>\n          <p class=\"chapter-lead\">\n            来件先入册。鞋面材质、钥匙胚型、客户要求，全部写在同一张工作单上。\n            不凭印象开工，不把编号留在口头。\n          </p>\n        </div>\n        <div class=\"warning\">\n          <div class=\"warning-mark\">!</div>\n          <div>\n            <strong>警示 / WARNING 01</strong>\n            <p>未确认原件状态，不得承诺完成时间。电话预约只锁定时间段，不替代现场判断。</p>\n          </div>\n        </div>\n        <div class=\"content-split\">\n          <figure class=\"image-frame\">\n            <img src=\"images/占位-1.jpg\" width=\"1200\" height=\"900\" alt=\"柜台上的鞋件与登记单\">\n            <figcaption><span>图 01 / 接收台</span><span>REF—01</span></figcaption>\n          </figure>\n          <div class=\"procedure\">\n            <div class=\"procedure-item\">\n              <span class=\"number\">01</span>\n              <div><strong>说明要做什么</strong><p>鞋底脱胶、跟面磨损、钥匙复制或其他现场问题，使用客户原话记录。</p></div>\n            </div>\n            <div class=\"procedure-item\">\n              <span class=\"number\">02</span>\n              <div><strong>确认交付窗口</strong><p>常规项目按现场排程处理；复杂项目先检查，再回拨确认。</p></div>\n            </div>\n            <div class=\"procedure-item\">\n              <span class=\"number\">03</span>\n              <div><strong>挂上工作编号</strong><p>工作单、待修件、价格确认单使用同一串编号，不拆分。</p></div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"chapter\" id=\"ch02\">\n    <div class=\"chapter-grid\">\n      <div class=\"chapter-no\">CH—02</div>\n      <div>\n        <div class=\"chapter-head\">\n          <h2>现场<br>判断</h2>\n          <p class=\"chapter-lead\">\n            先找受力点，再决定工序。硬材料不靠猜，软材料不靠拉。\n            能当场确认的项目，当场给出范围；不能确认的项目，不给虚假数字。\n          </p>\n        </div>\n        <div class=\"content-split reverse\">\n          <div class=\"image-stack\">\n            <figure class=\"image-frame\">\n              <img src=\"images/占位-2.jpg\" width=\"900\" height=\"1200\" alt=\"鞋底磨损检查\">\n              <figcaption><span>图 02 / 鞋底检查</span><span>REF—07</span></figcaption>\n            </figure>\n            <figure class=\"image-frame\">\n              <img src=\"images/占位-3.jpg\" width=\"900\" height=\"900\" alt=\"钥匙胚型检查\">\n              <figcaption><span>图 03 / 胚型识别</span><span>REF—11</span></figcaption>\n            </figure>\n          </div>\n          <div>\n            <div class=\"procedure\">\n              <div class=\"procedure-item\"><span class=\"number\">04</span><div><strong>观察磨损边界</strong><p>边缘翘起、裂缝扩大、鞋跟偏磨，分别进入不同处理路径。</p></div></div>\n              <div class=\"procedure-item\"><span class=\"number\">05</span><div><strong>核对钥匙槽形</strong><p>只以原件和胚型表为依据。齿位不清时，先停止复制。</p></div></div>\n              <div class=\"procedure-item\"><span class=\"number\">06</span><div><strong>记录异常</strong><p>记录缺口、变形、旧胶残留与锁芯阻滞，交付时一并说明。</p></div></div>\n            </div>\n            <div class=\"price-block\">\n              <span class=\"price-label\">常规项目起价 / FROM</span>\n              <span class=\"price\">¥30.00</span>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"chapter\" id=\"ch03\">\n    <div class=\"chapter-grid\">\n      <div class=\"chapter-no\">CH—03</div>\n      <div>\n        <div class=\"chapter-head\">\n          <h2>修鞋<br>工序</h2>\n          <p class=\"chapter-lead\">\n            剥离、清洁、定位、压合。每一步都要让下一步有可见的基准。\n            胶水不是遮盖物，缝线不是装饰物，受力必须回到鞋底结构。\n          </p>\n        </div>\n        <div class=\"warning\">\n          <div class=\"warning-mark\">02</div>\n          <div>\n            <strong>警示 / WARNING 02</strong>\n            <p>鞋底潮湿或旧胶未清除时，禁止进入压合工序。表面平整不代表粘接合格。</p>\n          </div>\n        </div>\n        <div class=\"content-split\">\n          <div>\n            <div class=\"diagram\" aria-label=\"修鞋工序爆炸图\">\n              <svg viewBox=\"0 0 620 330\" role=\"img\">\n                <line class=\"axis\" x1=\"22\" y1=\"165\" x2=\"598\" y2=\"165\"></line>\n                <g class=\"part\" data-part=\"07\" tabindex=\"0\">\n                  <polyline points=\"58,140 140,140 166,165 140,190 58,190 82,165\"></polyline>\n                  <text x=\"64\" y=\"120\">07</text>\n                </g>\n                <g class=\"part\" data-part=\"08\" tabindex=\"0\">\n                  <line x1=\"188\" y1=\"115\" x2=\"188\" y2=\"215\"></line><line x1=\"204\" y1=\"115\" x2=\"204\" y2=\"215\"></line>\n                  <text x=\"184\" y=\"95\">08</text>\n                </g>\n                <g class=\"part\" data-part=\"09\" tabindex=\"0\">\n                  <rect x=\"232\" y=\"135\" width=\"78\" height=\"60\"></rect><line x1=\"248\" y1=\"135\" x2=\"248\" y2=\"195\"></line>\n                  <text x=\"258\" y=\"115\">09</text>\n                </g>\n                <g class=\"part\" data-part=\"10\" tabindex=\"0\">\n                  <polyline points=\"338,125 382,125 405,145 405,185 382,205 338,205\"></polyline>\n                  <text x=\"358\" y=\"105\">10</text>\n                </g>\n                <g class=\"part\" data-part=\"11\" tabindex=\"0\">\n                  <line x1=\"438\" y1=\"125\" x2=\"438\" y2=\"205\"></line><line x1=\"456\" y1=\"125\" x2=\"456\" y2=\"205\"></line><line x1=\"474\" y1=\"125\" x2=\"474\" y2=\"205\"></line>\n                  <text x=\"442\" y=\"105\">11</text>\n                </g>\n                <g class=\"part\" data-part=\"12\" tabindex=\"0\">\n                  <polyline points=\"510,140 570,140 592,165 570,190 510,190\"></polyline>\n                  <text x=\"530\" y=\"120\">12</text>\n                </g>\n              </svg>\n              <div class=\"diagram-label\"><span>爆炸图 / SOLE ASSEMBLY</span><span>编号 07—12</span></div>\n            </div>\n            <div class=\"spec-wrap\">\n              <div class=\"spec-title\">4.2 / 修鞋规格表 · 点击图中编号可定位</div>\n              <table>\n                <thead>\n                  <tr><th>零件编号</th><th>扭矩 N·m</th><th>间隙 mm</th><th>油品型号</th></tr>\n                </thead>\n                <tbody>\n                  <tr id=\"part-07\"><td>07 / 前掌底</td><td>—</td><td>0.8</td><td>—</td></tr>\n                  <tr id=\"part-08\"><td>08 / 压合片</td><td>2.4</td><td>0.6</td><td>GL—02</td></tr>\n                  <tr id=\"part-09\"><td>09 / 胶层</td><td>—</td><td>0.4</td><td>AD—17</td></tr>\n                  <tr id=\"part-10\"><td>10 / 鞋跟芯</td><td>3.1</td><td>1.2</td><td>GL—02</td></tr>\n                  <tr id=\"part-11\"><td>11 / 定位钉</td><td>1.8</td><td>0.5</td><td>—</td></tr>\n                  <tr id=\"part-12\"><td>12 / 后掌底</td><td>—</td><td>0.8</td><td>—</td></tr>\n                  <tr class=\"ghost-row\"><td>&nbsp;</td><td>&nbsp;</td><td>&nbsp;</td><td>&nbsp;</td></tr>\n                </tbody>\n              </table>\n            </div>\n          </div>\n          <div class=\"procedure\">\n            <div class=\"procedure-item\"><span class=\"number\">07</span><div><strong>剥离旧层</strong><p>保留鞋底原有边界，避免扩大清理范围。</p></div></div>\n            <div class=\"procedure-item\"><span class=\"number\">08</span><div><strong>清洁并晾置</strong><p>清除粉尘与旧胶，确认接触面干燥。</p></div></div>\n            <div class=\"procedure-item\"><span class=\"number\">09</span><div><strong>定位压合</strong><p>从中心向边缘施力，压合后保持静置。</p></div></div>\n            <div class=\"procedure-item\"><span class=\"number\">10</span><div><strong>边缘复核</strong><p>用手沿边缘检查，不接受可见空腔与翘边。</p></div></div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"chapter\" id=\"ch04\">\n    <div class=\"chapter-grid\">\n      <div class=\"chapter-no\">CH—04</div>\n      <div>\n        <div class=\"chapter-head\">\n          <h2>配钥匙<br>核对</h2>\n          <p class=\"chapter-lead\">\n            铣削前确认胚型，铣削后确认齿位。编号从图纸到规格表保持不变，\n            让每把钥匙都能回到它的原件。\n          </p>\n        </div>\n        <div class=\"content-split reverse\">\n          <figure class=\"image-frame\">\n            <img src=\"images/占位-4.jpg\" width=\"1200\" height=\"800\" alt=\"配钥匙设备与钥匙胚\">\n            <figcaption><span>图 04 / 铣削台</span><span>REF—19</span></figcaption>\n          </figure>\n          <div>\n            <div class=\"warning\">\n              <div class=\"warning-mark\">!</div>\n              <div>\n                <strong>警示 / WARNING 03</strong>\n                <p>原钥匙有裂纹、变形或齿位磨平时，不直接复制。先确认锁芯可用性。</p>\n              </div>\n            </div>\n            <div class=\"procedure\">\n              <div class=\"procedure-item\"><span class=\"number\">13</span><div><strong>确认胚型</strong><p>钥匙槽宽度、肩位与长度必须同时匹配。</p></div></div>\n              <div class=\"procedure-item\"><span class=\"number\">14</span><div><strong>夹具锁定</strong><p>原件与胚件肩位对齐，夹紧后再启动设备。</p></div></div>\n              <div class=\"procedure-item\"><span class=\"number\">15</span><div><strong>逐齿检查</strong><p>完成后按齿位顺序比对，不以外观相似作为合格依据。</p></div></div>\n            </div>\n          </div>\n        </div>\n        <div class=\"spec-wrap\">\n          <div class=\"spec-title\">4.2 / 配钥匙规格表 · 原件核对记录</div>\n          <table>\n            <thead>\n              <tr><th>零件编号</th><th>扭矩 N·m</th><th>间隙 mm</th><th>油品型号</th></tr>\n            </thead>\n            <tbody>\n              <tr id=\"part-19\"><td>19 / 胚件夹具</td><td>1.6</td><td>0.3</td><td>CL—01</td></tr>\n              <tr id=\"part-20\"><td>20 / 导向片</td><td>1.2</td><td>0.4</td><td>CL—01</td></tr>\n              <tr id=\"part-21\"><td>21 / 铣削刀</td><td>2.0</td><td>0.2</td><td>OL—05</td></tr>\n              <tr id=\"part-22\"><td>22 / 原件定位</td><td>—</td><td>0.5</td><td>—</td></tr>\n              <tr id=\"part-23\"><td>23 / 成品检验</td><td>—</td><td>0.6</td><td>—</td></tr>\n              <tr class=\"ghost-row\"><td>&nbsp;</td><td>&nbsp;</td><td>&nbsp;</td><td>&nbsp;</td></tr>\n            </tbody>\n          </table>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"chapter\" id=\"ch05\">\n    <div class=\"chapter-grid\">\n      <div class=\"chapter-no\">CH—05</div>\n      <div>\n        <div class=\"chapter-head\">\n          <h2>交付<br>回签</h2>\n          <p class=\"chapter-lead\">\n            交付时复述完成项目、价格和注意事项。客户确认后，编号才算闭合。\n            有疑问现在提出，不把返工留给下一次电话。\n          </p>\n        </div>\n        <div class=\"booking-grid\">\n          <div>\n            <figure class=\"image-frame\">\n              <img src=\"images/占位-5.jpg\" width=\"1200\" height=\"675\" alt=\"修复完成的鞋与配好的钥匙\">\n              <figcaption><span>图 05 / 交付检查</span><span>REF—23</span></figcaption>\n            </figure>\n            <p class=\"booking-note\">\n              需要预约？请直接电话说明项目。我们按现场顺序留出时间，\n              到店后先看原件，再给出可执行的处理方案。\n            </p>\n          </div>\n          <div class=\"contact-box\">\n            <dl>\n              <dt>电话 / TEL</dt><dd>010—6487—2307</dd>\n              <dt>营业 / HOURS</dt><dd>09:00—18:00</dd>\n              <dt>地址 / BAY</dt><dd>北门 04 号柜</dd>\n              <dt>回签 / CLOSE</dt><dd>S29—023</dd>\n            </dl>\n            <a class=\"call-button\" href=\"tel:010-6487-2307\">\n              <span>现在预约</span>\n              <span>CALL ↗</span>\n            </a>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <footer class=\"footer\">\n    <span>S29 / WIRE-BOUND SERVICE MANUAL</span>\n    <span>零件 07—23 · 章节 01—05 · 版本 04</span>\n  </footer>\n</main>\n\n<script>\n(function () {\n  document.documentElement.classList.add(\"js-ready\");\n\n  var cursor = document.querySelector(\".cursor-wrench\");\n  document.addEventListener(\"mousemove\", function (event) {\n    if (cursor) {\n      cursor.style.left = event.clientX + \"px\";\n      cursor.style.top = event.clientY + \"px\";\n    }\n  });\n\n  var revealTargets = document.querySelectorAll(\".hero-meta, .chapter, .warning, .content-split, .booking-grid\");\n  var revealIndex = 0;\n  revealTargets.forEach(function (item) {\n    setTimeout(function () {\n      item.classList.add(\"revealed\");\n    }, 160 + revealIndex++ * 240);\n  });\n\n  var links = document.querySelectorAll(\".index a\");\n  var sections = document.querySelectorAll(\".chapter\");\n  var observer = new IntersectionObserver(function (entries) {\n    entries.forEach(function (entry) {\n      if (entry.isIntersecting) {\n        links.forEach(function (link) {\n          link.classList.toggle(\"active\", link.dataset.section === entry.target.id);\n        });\n      }\n    });\n  }, { rootMargin: \"-35% 0px -55% 0px\" });\n  sections.forEach(function (section) { observer.observe(section); });\n\n  document.querySelectorAll(\".diagram .part\").forEach(function (part) {\n    function jump() {\n      var row = document.getElementById(\"part-\" + part.dataset.part);\n      if (!row) return;\n      row.scrollIntoView({ behavior: \"smooth\", block: \"center\" });\n      row.classList.remove(\"flash\");\n      void row.offsetWidth;\n      row.classList.add(\"flash\");\n      setTimeout(function () { row.classList.remove(\"flash\"); }, 520);\n    }\n    part.addEventListener(\"click\", jump);\n    part.addEventListener(\"keydown\", function (event) {\n      if (event.key === \"Enter\" || event.key === \" \") {\n        event.preventDefault();\n        jump();\n      }\n    });\n  });\n})();\n</script>\n</body>\n</html>"
        }
      }
    }
