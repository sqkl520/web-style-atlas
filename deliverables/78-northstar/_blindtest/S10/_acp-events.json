        "content": {
          "type": "text",
          "text": " <!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>北线修鞋配钥匙｜预约工作台</title>\n  <style>\n    :root {\n      --red: #D32029;\n      --paper: #F2EFE8;\n      --ink: #17171A;\n      --grey: #6E7076;\n      --grey-soft: #B6B4AE;\n      --line: 1.25px;\n      --line-mid: 1.5px;\n      --line-heavy: 2px;\n      --gap: 24px;\n      --baseline-shift: -6px;\n      --registration: 1.5px;\n    }\n\n    * {\n      box-sizing: border-box;\n    }\n\n    html {\n      background: var(--paper);\n      color: var(--ink);\n      font-family: \"IBM Plex Sans\", \"Noto Sans SC\", sans-serif;\n    }\n\n    body {\n      margin: 0;\n      min-width: 320px;\n      background: var(--paper);\n      color: var(--ink);\n      font-size: 15px;\n      line-height: 1.4;\n      cursor: default;\n    }\n\n    body::before,\n    body::after {\n      position: fixed;\n      z-index: 20;\n      width: 18px;\n      height: 18px;\n      content: \"\";\n      pointer-events: none;\n    }\n\n    body::before {\n      top: 18px;\n      left: 18px;\n      border-top: var(--line-mid) solid var(--red);\n      border-left: var(--line-mid) solid var(--red);\n    }\n\n    body::after {\n      right: 18px;\n      bottom: 18px;\n      width: 20px;\n      height: 20px;\n      border-right: var(--line-mid) solid var(--red);\n      border-bottom: var(--line-mid) solid var(--red);\n      transform: translate(2px, 0);\n    }\n\n    a {\n      color: inherit;\n      text-decoration: none;\n    }\n\n    button,\n    a {\n      -webkit-tap-highlight-color: transparent;\n    }\n\n    .page {\n      width: min(1440px, calc(100% - 64px));\n      margin: 0 auto;\n      padding: 32px 0 42px;\n    }\n\n    .topline {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      min-height: 30px;\n      border-bottom: var(--line-mid) solid var(--ink);\n      color: var(--grey);\n      font-family: \"IBM Plex Mono\", monospace;\n      font-size: 11px;\n      letter-spacing: .06em;\n      text-transform: uppercase;\n    }\n\n    .topline .mark {\n      color: var(--red);\n    }\n\n    .hero {\n      position: relative;\n      display: grid;\n      grid-template-columns: 6fr 7fr 9fr 8fr 5fr;\n      gap: var(--gap);\n      min-height: 280px;\n      padding: 36px 0 30px;\n      border-bottom: var(--line-heavy) solid var(--ink);\n    }\n\n    .hero-copy {\n      grid-column: 1 / span 3;\n      align-self: end;\n    }\n\n    .eyebrow {\n      margin: 0 0 12px;\n      color: var(--red);\n      font-family: \"IBM Plex Mono\", monospace;\n      font-size: 12px;\n      letter-spacing: .08em;\n      text-transform: uppercase;\n    }\n\n    h1,\n    h2,\n    h3,\n    p {\n      margin-top: 0;\n    }\n\n    h1 {\n      max-width: 820px;\n      margin-bottom: 16px;\n      font-family: \"Jost\", \"Noto Sans SC\", sans-serif;\n      font-size: clamp(54px, 7vw, 80px);\n      font-weight: 500;\n      letter-spacing: -.055em;\n      line-height: .95;\n      transform: translateY(var(--baseline-shift));\n    }\n\n    .hero-intro {\n      max-width: 530px;\n      margin: 0;\n      color: var(--grey);\n      font-size: 16px;\n    }\n\n    .hero-action {\n      grid-column: 5;\n      align-self: end;\n      border-left: var(--line-mid) solid var(--ink);\n      padding-left: 16px;\n    }\n\n    .hero-action strong {\n      display: block;\n      margin-bottom: 12px;\n      font-family: \"Jost\", \"Noto Sans SC\", sans-serif;\n      font-size: 19px;\n      font-weight: 500;\n      line-height: 1.15;\n    }\n\n    .phone-link {\n      display: inline-flex;\n      align-items: center;\n      justify-content: space-between;\n      width: 100%;\n      min-height: 48px;\n      padding: 0 12px;\n      border: var(--line-heavy) solid var(--red);\n      color: var(--red);\n      font-family: \"IBM Plex Mono\", monospace;\n      font-size: 14px;\n      font-variant-numeric: tabular-nums;\n      transition: background-color 120ms linear, color 120ms linear;\n    }\n\n    .phone-link:hover,\n    .phone-link:focus-visible {\n      background: var(--red);\n      color: var(--paper);\n      outline: 0;\n    }\n\n    .calibration {\n      display: grid;\n      grid-template-columns: repeat(3, 1fr);\n      gap: var(--gap);\n      padding: 12px 0;\n      border-bottom: var(--line-mid) solid var(--ink);\n      font-family: \"IBM Plex Mono\", monospace;\n      font-size: 11px;\n      font-variant-numeric: tabular-nums;\n    }\n\n    .calibration span {\n      display: flex;\n      justify-content: space-between;\n      gap: 8px;\n      border-left: var(--line-mid) solid var(--red);\n      padding-left: 8px;\n    }\n\n    .calibration b {\n      color: var(--red);\n      font-weight: 400;\n      white-space: nowrap;\n    }\n\n    .comparison {\n      position: relative;\n      display: grid;\n      grid-template-columns: 6fr 7fr 9fr 8fr 5fr;\n      gap: var(--gap);\n      padding: 28px 0 34px;\n    }\n\n    .comparison::before {\n      position: absolute;\n      top: 0;\n      bottom: 0;\n      left: calc(39.3% + 12px);\n      width: var(--line);\n      background: var(--red);\n      content: \"\";\n      pointer-events: none;\n    }\n\n    .section-label {\n      grid-column: 1;\n      align-self: start;\n      color: var(--grey);\n      font-family: \"IBM Plex Mono\", monospace;\n      font-size: 11px;\n      letter-spacing: .06em;\n      text-transform: uppercase;\n    }\n\n    .section-label strong {\n      display: block;\n      margin-top: 8px;\n      color: var(--ink);\n      font-family: \"Jost\", \"Noto Sans SC\", sans-serif;\n      font-size: 24px;\n      font-weight: 500;\n      letter-spacing: -.03em;\n      line-height: 1;\n    }\n\n    .plate-stage {\n      position: relative;\n      grid-column: 2 / span 4;\n      min-height: 170px;\n      border-top: var(--line-mid) solid var(--ink);\n      border-bottom: var(--line-mid) solid var(--ink);\n      overflow: visible;\n    }\n\n    .plate {\n      position: absolute;\n      inset: 16px 0 16px 0;\n      display: grid;\n      grid-template-columns: 6fr 7fr 9fr 8fr 5fr;\n      gap: var(--gap);\n      padding: 14px 16px;\n      border: var(--line-heavy) solid var(--ink);\n      background: var(--paper);\n    }\n\n    .plate-black {\n      z-index: 1;\n      background: var(--ink);\n      color: var(--paper);\n    }\n\n    .plate-red {\n      z-index: 2;\n      border-color: var(--red);\n      background: var(--red);\n      color: var(--paper);\n      transform: translate(var(--registration), var(--registration));\n    }\n\n    .js .plate-black {\n      animation: plate-black-in 100ms linear both;\n    }\n\n    .js .plate-red {\n      transform: translate(3px, 3px);\n      animation: plate-red-in 240ms cubic-bezier(.15,.85,.25,1) 100ms both;\n    }\n\n    .plate span {\n      align-self: end;\n      font-family: \"IBM Plex Mono\", monospace;\n      font-size: 11px;\n      font-variant-numeric: tabular-nums;\n      line-height: 1.2;\n    }\n\n    .plate span:nth-child(1) {\n      grid-column: 1;\n    }\n\n    .plate span:nth-child(2) {\n      grid-column: 3;\n    }\n\n    .plate span:nth-child(3) {\n      grid-column: 5;\n      text-align: right;\n    }\n\n    .plate-red span:nth-child(2) {\n      grid-column: 4;\n    }\n\n    .plate-red span:nth-child(3) {\n      grid-column: 5;\n    }\n\n    @keyframes plate-black-in {\n      from {\n        opacity: 0;\n        transform: translate(-2px, -2px);\n      }\n      to {\n        opacity: 1;\n        transform: translate(0, 0);\n      }\n    }\n\n    @keyframes plate-red-in {\n      from {\n        opacity: 0;\n        transform: translate(3px, 3px);\n      }\n      to {\n        opacity: 1;\n        transform: translate(var(--registration), var(--registration));\n      }\n    }\n\n    .data-zone {\n      position: relative;\n      display: grid;\n      grid-column: 1 / -1;\n      grid-template-columns: 6fr 7fr 9fr 8fr 5fr;\n      gap: var(--gap);\n      cursor: none;\n    }\n\n    .data-zone:focus-within {\n      outline: var(--line) solid var(--red);\n      outline-offset: 6px;\n    }\n\n    .data-heading {\n      grid-column: 1 / -1;\n      display: flex;\n      align-items: baseline;\n      justify-content: space-between;\n      gap: 20px;\n      padding: 0 0 10px;\n      border-bottom: var(--line-mid) solid var(--ink);\n    }\n\n    .data-heading h2 {\n      margin: 0;\n      font-family: \"Jost\", \"Noto Sans SC\", sans-serif;\n      font-size: 30px;\n      font-weight: 500;\n      letter-spacing: -.04em;\n      line-height: 1;\n    }\n\n    .data-heading p {\n      margin: 0;\n      color: var(--grey);\n      font-family: \"IBM Plex Mono\", monospace;\n      font-size: 11px;\n      font-variant-numeric: tabular-nums;\n      text-align: right;\n    }\n\n    .service-row {\n      position: relative;\n      display: grid;\n      grid-column: 1 / -1;\n      grid-template-columns: 6fr 7fr 9fr 8fr 5fr;\n      gap: var(--gap);\n      min-height: 106px;\n      padding: 14px 0;\n      border-bottom: var(--line) solid var(--grey-soft);\n      align-items: start;\n    }\n\n    .service-row:hover,\n    .service-row:focus-within {\n      border-bottom-color: var(--red);\n    }\n\n    .row-id {\n      color: var(--red);\n      font-family: \"IBM Plex Mono\", monospace;\n      font-size: 14px;\n      font-variant-numeric: tabular-nums;\n    }\n\n    .row-title {\n      margin: 0;\n      font-family: \"Jost\", \"Noto Sans SC\", sans-serif;\n      font-size: 21px;\n      font-weight: 500;\n      letter-spacing: -.03em;\n      line-height: 1.05;\n    }\n\n    .row-detail {\n      margin: 0;\n      color: var(--grey);\n      font-size: 13px;\n      line-height: 1.45;\n    }\n\n    .row-price {\n      align-self: end;\n      color: var(--ink);\n      font-family: \"IBM Plex Mono\", monospace;\n      font-size: 18px;\n      font-variant-numeric: tabular-nums;\n      text-align: right;\n    }\n\n    .row-price small {\n      display: block;\n      color: var(--grey);\n      font-family: \"IBM Plex Sans\", \"Noto Sans SC\", sans-serif;\n      font-size: 11px;\n      text-align: right;\n    }\n\n    .ruler {\n      position: absolute;\n      right: 0;\n      bottom: 13px;\n      width: 44px;\n      height: 12px;\n      border-top: var(--line-mid) solid var(--red);\n      transform: translateX(0);\n      transition: transform 160ms linear;\n    }\n\n    .ruler::after {\n      position: absolute;\n      top: -5px;\n      right: 0;\n      width: 6px;\n      height: 6px;\n      border-top: var(--line-mid) solid var(--red);\n      border-right: var(--line-mid) solid var(--red);\n      content: \"\";\n      transform: rotate(45deg);\n    }\n\n    .service-row:hover .ruler,\n    .service-row:focus-within .ruler {\n      transform: translateX(12px);\n    }\n\n    .custom-cursor {\n      position: fixed;\n      z-index: 30;\n      width: 12px;\n      height: 12px;\n      border-top: var(--line) solid var(--red);\n      border-left: var(--line) solid var(--red);\n      pointer-events: none;\n      opacity: 0;\n      transform: translate(10px, 10px);\n      transition: opacity 120ms linear;\n    }\n\n    .data-zone:hover ~ .custom-cursor,\n    .custom-cursor.is-visible {\n      opacity: 1;\n    }\n\n    .visuals {\n      display: grid;\n      grid-column: 1 / -1;\n      grid-template-columns: 6fr 7fr 9fr 8fr 5fr;\n      gap: var(--gap);\n      padding-top: 6px;\n    }\n\n    .visual-intro {\n      grid-column: 1;\n      align-self: start;\n      border-top: var(--line-heavy) solid var(--red);\n      padding-top: 10px;\n    }\n\n    .visual-intro p {\n      margin-bottom: 0;\n      color: var(--grey);\n      font-size: 13px;\n    }\n\n    .visual-grid {\n      grid-column: 2 / -1;\n      display: grid;\n      grid-template-columns: repeat(5, 1fr);\n      gap: var(--gap);\n    }\n\n    .visual-card {\n      min-width: 0;\n      border: var(--line-mid) solid var(--ink);\n      background: var(--paper);\n    }\n\n    .visual-card img {\n      display: block;\n      width: 100%;\n      height: auto;\n      aspect-ratio: 640 / 420;\n      object-fit: cover;\n      border-bottom: var(--line-mid) solid var(--ink);\n      background: var(--grey-soft);\n    }\n\n    .visual-card figcaption {\n      min-height: 42px;\n      padding: 8px;\n      font-family: \"IBM Plex Mono\", monospace;\n      font-size: 10px;\n      font-variant-numeric: tabular-nums;\n      line-height: 1.25;\n    }\n\n    .visual-card.empty {\n      display: flex;\n      min-height: 126px;\n      align-items: flex-end;\n      border-color: var(--red);\n      background: var(--red);\n      color: var(--paper);\n    }\n\n    .visual-card.empty figcaption {\n      width: 100%;\n      border-top: var(--line-mid) solid var(--paper);\n    }\n\n    .footer {\n      display: grid;\n      grid-template-columns: 6fr 7fr 9fr 8fr 5fr;\n      gap: var(--gap);\n      padding-top: 14px;\n      border-top: var(--line-heavy) solid var(--ink);\n      font-family: \"IBM Plex Mono\", monospace;\n      font-size: 11px;\n      font-variant-numeric: tabular-nums;\n    }\n\n    .footer .footer-code {\n      grid-column: 1;\n      color: var(--red);\n    }\n\n    .footer .footer-note {\n      grid-column: 3 / span 2;\n      color: var(--grey);\n    }\n\n    .footer .footer-page {\n      grid-column: 5;\n      color: var(--grey);\n      text-align: right;\n    }\n\n    @media (max-width: 900px) {\n      .page {\n        width: min(100% - 40px, 680px);\n      }\n\n      .hero,\n      .comparison,\n      .data-zone,\n      .visuals,\n      .footer {\n        grid-template-columns: 1fr;\n        gap: 18px;\n      }\n\n      .hero-copy,\n      .hero-action,\n      .section-label,\n      .plate-stage,\n      .data-heading,\n      .service-row,\n      .visual-intro,\n      .visual-grid,\n      .footer .footer-code,\n      .footer .footer-note,\n      .footer .footer-page {\n        grid-column: 1;\n      }\n\n      .hero {\n        min-height: auto;\n      }\n\n      .hero-action {\n        border-left: 0;\n        border-top: var(--line-mid) solid var(--ink);\n        padding: 14px 0 0;\n      }\n\n      .plate-stage {\n        min-height: 144px;\n      }\n\n      .plate {\n        grid-template-columns: repeat(5, 1fr);\n        gap: 10px;\n      }\n\n      .comparison::before {\n        left: 12px;\n        right: 12px;\n        top: 50%;\n        bottom: auto;\n        width: auto;\n        height: var(--line);\n      }\n\n      .service-row {\n        grid-template-columns: 44px 1fr auto;\n        gap: 12px;\n        min-height: 126px;\n      }\n\n      .row-detail {\n        grid-column: 2 / -1;\n      }\n\n      .row-price {\n        grid-column: 3;\n        grid-row: 1;\n      }\n\n      .visual-grid {\n        grid-template-columns: repeat(2, 1fr);\n      }\n\n      .footer .footer-note {\n        grid-row: 2;\n      }\n\n      .footer .footer-page {\n        grid-row: 3;\n        text-align: left;\n      }\n    }\n\n    @media (max-width: 520px) {\n      .page {\n        width: min(100% - 28px, 480px);\n        padding-top: 24px;\n      }\n\n      body::before {\n        top: 10px;\n        left: 10px;\n      }\n\n      body::after {\n        right: 10px;\n        bottom: 10px;\n      }\n\n      h1 {\n        font-size: clamp(48px, 16vw, 68px);\n      }\n\n      .calibration {\n        grid-template-columns: 1fr;\n        gap: 8px;\n      }\n\n      .plate {\n        inset: 12px 0;\n        padding: 10px;\n      }\n\n      .plate span {\n        font-size: 9px;\n      }\n\n      .visual-grid {\n        grid-template-columns: 1fr;\n      }\n    }\n\n    @media (prefers-reduced-motion: reduce) {\n      .js .plate-black,\n      .js .plate-red {\n        animation: none;\n      }\n\n      .js .plate-black {\n        transform: translate(0, 0);\n        opacity: 1;\n      }\n\n      .js .plate-red {\n        transform: translate(var(--registration), var(--registration));\n        opacity: 1;\n      }\n\n      .ruler,\n      .phone-link {\n        transition: opacity 120ms linear;\n      }\n\n      .service-row:hover .ruler,\n      .service-row:focus-within .ruler {\n        transform: none;\n      }\n    }\n  </style>\n</head>\n<body>\n  <main class=\"page\">\n    <div class=\"topline\">\n      <span>北线 / NORTH LINE</span>\n      <span class=\"mark\">修鞋 · 配钥匙 · 现场预约</span>\n      <span>工作台 01 / 2024</span>\n    </div>\n\n    <header class=\"hero\">\n      <div class=\"hero-copy\">\n        <p class=\"eyebrow\">LOCAL REPAIR UNIT / 01—05</p>\n        <h1>鞋底与钥匙，<br>按尺寸处理。</h1>\n        <p class=\"hero-intro\">不做复杂承诺。先确认问题，再给出可执行的时间。电话预约，现场处理，交付标准写在台面上。</p>\n      </div>\n\n      <div class=\"hero-action\">\n        <strong>预约一个到店时间</strong>\n        <a class=\"phone-link\" href=\"tel:010-6248-0317\" aria-label=\"拨打北线修鞋配钥匙电话\">\n          <span>010—6248—0317</span>\n          <span>→</span>\n        </a>\n      </div>\n    </header>\n\n    <section class=\"calibration\" aria-label=\"版式参数\">\n      <span>红版错位量 <b>1.5px</b></span>\n      <span>套准线宽 <b>1.25px</b></span>\n      <span>标题基线 <b>-6px</b></span>\n    </section>\n\n    <section class=\"comparison\" aria-label=\"服务工作台对撞页\">\n      <div class=\"section-label\">\n        SERVICE GRID\n        <strong>处理范围</strong>\n      </div>\n\n      <div class=\"plate-stage\" aria-hidden=\"true\">\n        <div class=\"plate plate-black\">\n          <span>黑版 / 基准</span>\n          <span>按问题拆分</span>\n          <span>05 项</span>\n        </div>\n        <div class=\"plate plate-red\">\n          <span>红版 / 校准</span>\n          <span>按尺寸落地</span>\n          <span>1.5px</span>\n        </div>\n      </div>\n\n      <div class=\"data-zone\" aria-label=\"五项服务数据\">\n        <div class=\"data-heading\">\n          <h2>服务，不按情绪报价。</h2>\n          <p>价格为常规区间 / 特殊材料到店确认</p>\n        </div>\n\n        <article class=\"service-row\" tabindex=\"0\" data-row=\"01\">\n          <div class=\"row-id\">01</div>\n          <h3 class=\"row-title\">鞋底更换</h3>\n          <p class=\"row-detail\">磨损至中底、开胶面积较大时处理。先拆检，再确定底材与工时。</p>\n          <div class=\"row-price\">¥80—180<small>常规范围</small></div>\n          <span class=\"ruler\" aria-hidden=\"true\"></span>\n        </article>\n\n        <article class=\"service-row\" tabindex=\"0\" data-row=\"02\">\n          <div class=\"row-id\">02</div>\n          <h3 class=\"row-title\">皮鞋补色</h3>\n          <p class=\"row-detail\">处理划痕、局部褪色与边缘色差。颜色按原鞋现场比对。</p>\n          <div class=\"row-price\">¥60—120<small>单只计价</small></div>\n          <span class=\"ruler\" aria-hidden=\"true\"></span>\n        </article>\n\n        <article class=\"service-row\" tabindex=\"0\" data-row=\"03\">\n          <div class=\"row-id\">03</div>\n          <h3 class=\"row-title\">拉链维修</h3>\n          <p class=\"row-detail\">更换拉头、下止或整条拉链。包具和靴筒需携带原件确认。</p>\n          <div class=\"row-price\">¥30—160<small>按部件计算</small></div>\n          <span class=\"ruler\" aria-hidden=\"true\"></span>\n        </article>\n\n        <article class=\"service-row\" tabindex=\"0\" data-row=\"04\">\n          <div class=\"row-id\">04</div>\n          <h3 class=\"row-title\">普通配钥匙</h3>\n          <p class=\"row-detail\">常见家门、抽屉、挂锁钥匙。原钥匙变形严重时，需要增加校正时间。</p>\n          <div class=\"row-price\">¥10—25<small>单把计价</small></div>\n          <span class=\"ruler\" aria-hidden=\"true\"></span>\n        </article>\n\n        <article class=\"service-row\" tabindex=\"0\" data-row=\"05\">\n          <div class=\"row-id\">05</div>\n          <h3 class=\"row-title\">门禁与磁卡</h3>\n          <p class=\"row-detail\">先判断卡型与权限。可复制范围以物业系统和原卡状态为准。</p>\n          <div class=\"row-price\">¥20—80<small>现场判断</small></div>\n          <span class=\"ruler\" aria-hidden=\"true\"></span>\n        </article>\n      </div>\n\n      <div class=\"visuals\">\n        <div class=\"visual-intro\">\n          <p>材料、刀口、针脚都留在现场。图像只说明处理对象，不替代到店判断。</p>\n        </div>\n\n        <div class=\"visual-grid\">\n          <figure class=\"visual-card\">\n            <img src=\"images/占位-1.jpg\" width=\"640\" height=\"420\" alt=\"鞋底维修工作台\">\n            <figcaption>01 / 鞋底截面</figcaption>\n          </figure>\n\n          <figure class=\"visual-card\">\n            <img src=\"images/占位-2.jpg\" width=\"640\" height=\"420\" alt=\"皮鞋补色工具\">\n            <figcaption>02 / 色差校准</figcaption>\n          </figure>\n\n          <figure class=\"visual-card\">\n            <img src=\"images/占位-3.jpg\" width=\"640\" height=\"420\" alt=\"拉链维修细节\">\n            <figcaption>03 / 拉链部件</figcaption>\n          </figure>\n\n          <figure class=\"visual-card\">\n            <img src=\"images/占位-4.jpg\" width=\"640\" height=\"420\" alt=\"钥匙复制机\">\n            <figcaption>04 / 钥匙齿形</figcaption>\n          </figure>\n\n          <figure class=\"visual-card\">\n            <img src=\"images/占位-5.jpg\" width=\"640\" height=\"420\" alt=\"门禁卡检测\">\n            <figcaption>05 / 卡片识别</figcaption>\n          </figure>\n\n          <figure class=\"visual-card empty\">\n            <figcaption>空位 / 留给现场确认</figcaption>\n          </figure>\n        </div>\n      </div>\n    </section>\n\n    <footer class=\"footer\">\n      <span class=\"footer-code\">NORTH LINE / 01—05</span>\n      <span class=\"footer-note\">周一至周六 09:30—19:00 / 周日电话确认</span>\n      <span class=\"footer-page\">PAGE 01 / 05</span>\n    </footer>\n  </main>\n\n  <div class=\"custom-cursor\" id=\"customCursor\" aria-hidden=\"true\"></div>\n\n  <script>\n    document.body.classList.add(\"js\");\n\n    window.setTimeout(function () {\n      document.body.classList.add(\"loaded\");\n    }, 20);\n\n    (function () {\n      var zone = document.querySelector(\".data-zone\");\n      var cursor = document.getElementById(\"customCursor\");\n\n      if (!zone || !cursor) return;\n\n      zone.addEventListener(\"mousemove\", function (event) {\n        cursor.style.left = event.clientX + \"px\";\n        cursor.style.top = event.clientY + \"px\";\n        cursor.classList.add(\"is-visible\");\n      });\n\n      zone.addEventListener(\"mouseenter\", function () {\n        cursor.classList.add(\"is-visible\");\n      });\n\n      zone.addEventListener(\"mouseleave\", function () {\n        cursor.classList.remove(\"is-visible\");\n      });\n    }());\n  </script>\n</body>\n</html>"
