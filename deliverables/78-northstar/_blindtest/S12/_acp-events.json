          "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>咔哒修鞋｜配钥匙</title>\n<style>\n@import url('https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@500;700;800&family=JetBrains+Mono:wght@400;700&display=swap');\n:root{--lime:#B5D626;--room:#1E2A2E;--magenta:#E23E57;--face:#F2E9D8;--room2:#26353A;--room3:#182226;--ink:#111111;--line:2px;}\n*{box-sizing:border-box;border-radius:0!important}\nhtml{background:var(--room);scroll-behavior:smooth}\nbody{margin:0;background:var(--room);color:var(--face);font-family:'Glow Sans SC','Noto Sans SC','Source Han Sans SC','PingFang SC',sans-serif;font-size:17px;line-height:1.35;overflow-x:hidden;cursor:none}\nbody:before{content:\"\";position:fixed;inset:0;pointer-events:none;background:repeating-linear-gradient(45deg,transparent 0 26px,rgba(181,214,38,.035) 26px 28px);z-index:0}\n.page{position:relative;z-index:1;max-width:1500px;margin:auto;padding:28px 44px 56px}\n.mast{display:flex;justify-content:space-between;align-items:center;border-bottom:var(--line) solid var(--lime);padding-bottom:18px;margin-bottom:28px;text-transform:uppercase;font-family:'JetBrains Mono',monospace;font-size:12px;letter-spacing:.08em}\n.logo{font-family:'Bricolage Grotesque','Glow Sans SC',sans-serif;font-weight:800;font-size:22px;color:var(--lime);letter-spacing:-.04em}\n.status{color:var(--face);text-align:right}\n.hero{display:grid;grid-template-columns:minmax(0,1.55fr) minmax(250px,.45fr);gap:44px;align-items:end;margin-bottom:44px}\n.kicker{color:var(--magenta);font-family:'JetBrains Mono',monospace;font-size:14px;margin:0 0 12px}\nh1{font-family:'Bricolage Grotesque','Glow Sans SC',sans-serif;font-size:clamp(62px,8.5vw,95px);line-height:.88;letter-spacing:-.075em;margin:0;color:var(--lime);max-width:850px}\n.hero-note{border-left:8px solid var(--lime);padding-left:18px;color:var(--face);font-size:20px;max-width:250px}\n.hero-note strong{display:block;color:var(--magenta);font-family:'JetBrains Mono',monospace;font-size:12px;margin-bottom:12px}\n.holes{display:grid;grid-template-columns:repeat(12,1fr);grid-template-rows:auto auto auto auto;gap:28px 12px;align-items:stretch}\n.hole{position:relative;background:var(--face);color:var(--ink);border:2px solid var(--lime);min-height:250px;overflow:hidden;opacity:0;transform:translateY(-40px);animation:drop 90ms steps(3) forwards}\n.hole:after{content:\"\";position:absolute;inset:0;pointer-events:none;border:1px solid var(--room3)}\n.hole:hover{background:var(--lime)}\n.hole:hover .stripe{background:repeating-linear-gradient(135deg,var(--magenta) 0 10px,var(--face) 10px 20px)}\n.hole:nth-child(1){grid-column:span 5;min-height:330px;animation-delay:90ms}\n.hole:nth-child(2){grid-column:span 4;min-height:330px;animation-delay:180ms}\n.hole:nth-child(3){grid-column:span 3;min-height:330px;animation-delay:270ms}\n.hole:nth-child(4){grid-column:2 / span 4;min-height:300px;animation-delay:360ms}\n.hole:nth-child(5){grid-column:6 / span 4;min-height:300px;animation-delay:450ms}\n.hole:nth-child(6){grid-column:10 / span 3;min-height:300px;animation-delay:540ms}\n.hole:nth-child(7){grid-column:5 / span 5;min-height:280px;animation-delay:630ms}\n.card-head{display:flex;justify-content:space-between;gap:12px;padding:14px 16px;border-bottom:2px solid var(--ink);font-family:'JetBrains Mono',monospace;font-size:13px;font-weight:700}\n.num{font-variant-numeric:tabular-nums;color:var(--magenta)}\n.content{padding:18px 16px;position:relative;z-index:2}\nh2{font-family:'Bricolage Grotesque','Glow Sans SC',sans-serif;font-size:clamp(30px,3vw,48px);line-height:.92;letter-spacing:-.06em;margin:0 0 14px}\n.content p{margin:0 0 18px;max-width:34ch}\n.price{font-family:'JetBrains Mono',monospace;font-size:22px;text-align:right;display:block;margin-top:auto;color:var(--room)}\n.stripe{position:absolute;right:-5px;bottom:-5px;width:42%;height:42%;border:2px solid var(--ink);background:repeating-linear-gradient(135deg,var(--lime) 0 10px,var(--face) 10px 20px);clip-path:polygon(42% 0,100% 0,100% 100%,0 100%,0 58%);transition:background 120ms steps(1)}\n.photo{width:100%;height:155px;object-fit:cover;display:block;border-bottom:2px solid var(--ink);filter:saturate(.8) contrast(1.1)}\n.tall .photo{height:185px}\n.empty{background:var(--room3);color:var(--lime);border-color:var(--magenta);display:flex;align-items:center;justify-content:center;text-align:center}\n.empty .card-head{position:absolute;top:0;left:0;right:0;border-color:var(--magenta)}\n.empty-copy{font-family:'Bricolage Grotesque','Glow Sans SC',sans-serif;font-size:29px;line-height:1;transform:rotate(-45deg);max-width:170px}\n.booking{background:var(--magenta);color:var(--ink);border-color:var(--lime);display:flex;flex-direction:column;justify-content:space-between}\n.booking .card-head{border-color:var(--ink)}\n.booking h2{font-size:clamp(36px,4vw,62px)}\n.booking p{font-size:20px;max-width:25ch}\n.btn{display:inline-block;background:var(--ink);color:var(--face);border:2px solid var(--ink);padding:12px 16px;font-family:'JetBrains Mono',monospace;font-weight:700;text-decoration:none;cursor:none;transition:transform 120ms steps(1),border-color 120ms steps(1)}\n.btn:hover{transform:translate(2px,2px);border-bottom-color:var(--magenta);border-right-color:var(--magenta)}\nfooter{display:flex;justify-content:space-between;gap:20px;margin-top:42px;padding-top:16px;border-top:2px solid var(--lime);font-family:'JetBrains Mono',monospace;font-size:12px;color:var(--lime)}\n.cursor{position:fixed;width:20px;height:20px;border:2px solid var(--lime);pointer-events:none;z-index:10;transform:translate(-50%,-50%)}\n.cursor.in-hole{background:repeating-linear-gradient(135deg,var(--magenta) 0 4px,var(--face) 4px 8px)}\n.reveal{will-change:transform}\n@keyframes drop{0%{opacity:0;transform:translateY(-40px)}70%{opacity:1;transform:translateY(6px)}100%{opacity:1;transform:translateY(0)}}\n@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}.hole{animation:none;opacity:1;transform:none}.btn,.stripe{transition:none}.cursor{display:none}body{cursor:auto}}\n@media (max-width:850px){body{cursor:auto}.page{padding:20px 18px 36px}.mast{margin-bottom:24px}.hero{grid-template-columns:1fr;gap:24px;margin-bottom:28px}h1{font-size:clamp(58px,17vw,88px)}.hero-note{max-width:none}.holes{display:flex;flex-direction:column;gap:14px}.hole,.hole:nth-child(n){min-height:290px;width:100%}.hole:nth-child(1),.hole:nth-child(2),.hole:nth-child(3),.hole:nth-child(4),.hole:nth-child(5),.hole:nth-child(6),.hole:nth-child(7){grid-column:auto}.photo,.tall .photo{height:190px}footer{flex-direction:column}}\n</style>\n</head>\n<body>\n<div class=\"cursor\" aria-hidden=\"true\"></div>\n<main class=\"page\">\n<header class=\"mast\"><div class=\"logo\">咔哒 / KADa</div><div class=\"status\">修鞋 · 配钥匙 · 不修闷<br>OPEN 10:00—20:00</div></header>\n<section class=\"hero reveal\">\n<div><p class=\"kicker\">S12 / LIME KNOCKOUT WALL / 01—07</p><h1>鞋坏了？<br>钥匙丢了？<br>别急着演。</h1></div>\n<div class=\"hero-note\"><strong>本店宣言</strong>我们把鞋底钉回去，把门外的世界重新打开。电话响了就算预约成功一半。</div>\n</section>\n<section class=\"holes\" aria-label=\"服务项目\">\n<article class=\"hole tall\"><div class=\"card-head\"><span>01 / REPAIR</span><span class=\"num\">¥ 30—</span></div><img class=\"photo\" src=\"images/占位-1.jpg\" width=\"720\" height=\"360\" alt=\"正在修补的皮鞋\"><div class=\"content\"><h2>鞋底<br>复活</h2><p>磨平了？开胶了？鞋子只是暂时不想走路。</p><span class=\"price\">FROM 30</span></div><i class=\"stripe\"></i></article>\n<article class=\"hole\"><div class=\"card-head\"><span>02 / KEY</span><span class=\"num\">¥ 10—</span></div><img class=\"photo\" src=\"images/占位-2.jpg\" width=\"560\" height=\"310\" alt=\"一串钥匙和钥匙坯\"><div class=\"content\"><h2>配钥匙<br>咔哒一下</h2><p>旧钥匙带来，新钥匙带走。门表示同意。</p><span class=\"price\">FROM 10</span></div><i class=\"stripe\"></i></article>\n<article class=\"hole\"><div class=\"card-head\"><span>03 / ZIPPER</span><span class=\"num\">¥ 25—</span></div><img class=\"photo\" src=\"images/占位-3.jpg\" width=\"420\" height=\"310\" alt=\"拉链维修工具\"><div class=\"content\"><h2>拉链<br>别摆烂</h2><p>卡住、掉齿、闹脾气，统统让它重新排队。</p><span class=\"price\">FROM 25</span></div><i class=\"stripe\"></i></article>\n<article class=\"hole\"><div class=\"card-head\"><span>04 / SOLE</span><span class=\"num\">¥ 60—</span></div><img class=\"photo\" src=\"images/占位-4.jpg\" width=\"560\" height=\"310\" alt=\"皮鞋鞋底细节\"><div class=\"content\"><h2>换底<br>走远点</h2><p>一双鞋的第二人生，从一块新底开始。</p><span class=\"price\">FROM 60</span></div><i class=\"stripe\"></i></article>\n<article class=\"hole\"><div class=\"card-head\"><span>05 / DETAIL</span><span class=\"num\">¥ 20—</span></div><img class=\"photo\" src=\"images/占位-5.jpg\" width=\"560\" height=\"310\" alt=\"鞋面清洁护理\"><div class=\"content\"><h2>清洁<br>亮到有理</h2><p>灰尘退场，鞋面恢复发言权。</p><span class=\"price\">FROM 20</span></div><i class=\"stripe\"></i></article>\n<article class=\"hole empty\"><div class=\"card-head\"><span>06 / BLANK</span><span class=\"num\">—</span></div><div class=\"empty-copy\">这里故意<br>空一下</div><i class=\"stripe\"></i></article>\n<article class=\"hole booking\"><div class=\"card-head\"><span>07 / CALL</span><span class=\"num\">NOW</span></div><div class=\"content\"><h2>先打电话<br>再出门</h2><p>说一声“我到了”，我们就开始把问题钉回原位。</p><a class=\"btn\" href=\"tel:13800000000\">☎ 138 0000 0000</a></div><i class=\"stripe\"></i></article>\n</section>\n<footer><span>编号印在面板上，不是装饰。</span><span>地址：街角那家亮着青柠灯的小店</span><span>© KADa 2024</span></footer>\n</main>\n<script>\n(function(){\n const cursor=document.querySelector('.cursor');\n document.addEventListener('mousemove',e=>{cursor.style.left=e.clientX+'px';cursor.style.top=e.clientY+'px'});\n document.querySelectorAll('.hole').forEach(el=>{el.addEventListener('mouseenter',()=>cursor.classList.add('in-hole'));el.addEventListener('mouseleave',()=>cursor.classList.remove('in-hole'))});\n const io=new IntersectionObserver(entries=>entries.forEach(e=>{if(e.isIntersecting){e.target.style.animationPlayState='running';io.unobserve(e.target)}}),{threshold:.6});\n document.querySelectorAll('.reveal').forEach(el=>io.observe(el));\n})();\n</script>\n</body>\n</html>"
