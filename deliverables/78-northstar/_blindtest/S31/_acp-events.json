argin-bottom: 28px;\n      color: var(--ink-soft);\n      font-size: 15px;\n      line-height: 1.75;\n    }\n\n    .service-meta {\n      display: flex;\n      align-items: baseline;\n      justify-content: space-between;\n      gap: 12px;\n      padding-top: 12px;\n      border-top: 1px solid var(--rule);\n      font-size: 12px;\n    }\n\n    .price {\n      color: var(--ink);\n      font-family: \"Jost\", \"Noto Sans SC\";\n      font-size: 20px;\n      letter-spacing: 0;\n    }\n\n    .work-record {\n      display: grid;\n      grid-template-columns: 1.15fr 0.85fr;\n      gap: 0;\n      margin-top: 42px;\n      border-top: 1.5px solid var(--rule);\n      border-bottom: 1px solid var(--rule);\n    }\n\n    .record-copy {\n      padding: 28px 34px 32px 0;\n    }\n\n    .record-copy h2 {\n      margin-bottom: 18px;\n    }\n\n    .record-copy p {\n      max-width: 520px;\n      margin-bottom: 24px;\n      color: var(--ink-soft);\n      font-size: 16px;\n    }\n\n    .record-list {\n      display: grid;\n      grid-template-columns: 1fr 1fr;\n      max-width: 520px;\n      border-top: 1px solid var(--rule);\n    }\n\n    .record-list div {\n      padding: 11px 14px 11px 0;\n      border-bottom: 1px solid var(--rule);\n      color: var(--ink-soft);\n      font-size: 14px;\n    }\n\n    .record-list div:nth-child(odd) {\n      border-right: 1px solid var(--rule);\n    }\n\n    .record-list div:nth-child(even) {\n      padding-left: 14px;\n    }\n\n    .image-frame {\n      min-height: 300px;\n      border-left: 1px solid var(--rule);\n      overflow: hidden;\n      background: var(--paper-deep);\n    }\n\n    .image-frame img {\n      display: block;\n      width: 100%;\n      height: 100%;\n      min-height: 300px;\n      object-fit: cover;\n      border: 0;\n    }\n\n    .contact-strip {\n      display: grid;\n      grid-template-columns: 0.75fr 1.25fr;\n      align-items: center;\n      gap: 32px;\n      padding: 36px 0 44px;\n    }\n\n    .contact-strip h2 {\n      max-width: 440px;\n      font-size: 34px;\n    }\n\n    .contact-detail {\n      display: grid;\n      grid-template-columns: 1fr auto;\n      align-items: end;\n      gap: 24px;\n      padding-left: 24px;\n      border-left: 1px solid var(--rule);\n    }\n\n    .phone-number {\n      font-family: \"Jost\", \"Noto Sans SC\";\n      font-size: clamp(30px, 4vw, 52px);\n      letter-spacing: -0.04em;\n      line-height: 1;\n    }\n\n    .hours {\n      margin: 8px 0 0;\n      color: var(--ink-soft);\n      font-size: 14px;\n    }\n\n    footer {\n      display: flex;\n      justify-content: space-between;\n      gap: 24px;\n      padding: 16px 0 26px;\n      border-top: 1px solid var(--rule);\n      color: var(--ink-soft);\n      font-size: 12px;\n    }\n\n    @media (max-width: 820px) {\n      .site-shell {\n        padding: 0 20px;\n      }\n\n      .masthead,\n      .work-record,\n      .contact-strip {\n        grid-template-columns: 1fr;\n        gap: 0;\n      }\n\n      .masthead {\n        padding: 38px 0 44px;\n      }\n\n      h1 {\n        font-size: clamp(58px, 17vw, 90px);\n      }\n\n      .header-spec {\n        margin-top: 42px;\n        padding-left: 16px;\n      }\n\n      .services-grid {\n        grid-template-columns: 1fr;\n      }\n\n      .service,\n      .service:nth-child(1),\n      .service:nth-child(2),\n      .service:nth-child(3),\n      .service:nth-child(4),\n      .service:nth-child(5) {\n        min-height: auto;\n      }\n\n      .service p {\n        max-width: 500px;\n      }\n\n      .record-copy {\n        padding: 28px 0;\n      }\n\n      .image-frame {\n        min-height: 220px;\n        border-top: 1px solid var(--rule);\n        border-left: 0;\n      }\n\n      .image-frame img {\n        min-height: 220px;\n      }\n\n      .contact-strip {\n        padding-top: 32px;\n      }\n\n      .contact-strip h2 {\n        margin-bottom: 28px;\n      }\n\n      .contact-detail {\n        padding-left: 16px;\n      }\n    }\n\n    @media (prefers-reduced-motion: reduce) {\n      html {\n        scroll-behavior: auto;\n      }\n\n      .is-live .tick.major,\n      .call-button,\n      .service {\n        transition: none;\n      }\n\n      .ruler .tick.major {\n        border-left-width: 2px;\n      }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"site-shell\">\n    <div class=\"ruler\" data-ruler aria-hidden=\"true\">\n      <div class=\"ruler-track\">\n        <span class=\"tick major\"></span>\n        <span class=\"tick\"></span>\n        <span class=\"tick\"></span>\n        <span class=\"tick\"></span>\n        <span class=\"tick\"></span>\n        <span class=\"tick major\"></span>\n        <span class=\"tick\"></span>\n        <span class=\"tick\"></span>\n        <span class=\"tick\"></span>\n        <span class=\"tick\"></span>\n        <span class=\"tick major\"></span>\n        <span class=\"tick\"></span>\n        <span class=\"tick\"></span>\n        <span class=\"tick\"></span>\n        <span class=\"tick\"></span>\n        <span class=\"tick major\"></span>\n        <span class=\"tick\"></span>\n        <span class=\"tick\"></span>\n        <span class=\"tick\"></span>\n        <span class=\"tick\"></span>\n        <span class=\"tick major\"></span>\n        <span class=\"tick\"></span>\n        <span class=\"tick\"></span>\n        <span class=\"tick\"></span>\n        <span class=\"tick\"></span>\n        <span class=\"tick major\"></span>\n        <span class=\"tick\"></span>\n        <span class=\"tick\"></span>\n        <span class=\"tick\"></span>\n        <span class=\"tick\"></span>\n        <span class=\"tick major\"></span>\n        <span class=\"tick\"></span>\n        <span class=\"tick\"></span>\n        <span class=\"tick\"></span>\n        <span class=\"tick\"></span>\n        <span class=\"tick major\"></span>\n        <span class=\"tick\"></span>\n        <span class=\"tick\"></span>\n        <span class=\"tick\"></span>\n        <span class=\"tick\"></span>\n        <span class=\"tick major\"></span>\n        <span class=\"tick\"></span>\n        <span class=\"tick\"></span>\n        <span class=\"tick\"></span>\n        <span class=\"tick\"></span>\n        <span class=\"tick major\"></span>\n        <span class=\"tick\"></span>\n        <span class=\"tick\"></span>\n        <span class=\"tick\"></span>\n        <span class=\"tick end major\"></span>\n      </div>\n    </div>\n\n    <header class=\"masthead\">\n      <div>\n        <p class=\"eyebrow\">NORTH LINE / SERVICE SPECIFICATION 01—05</p>\n        <h1>修鞋<br>配钥匙</h1>\n        <p class=\"lead\">按件报价，按时交付。先电话确认材料与工时，再到店处理。</p>\n        <div class=\"action-row\">\n          <a class=\"call-button\" href=\"tel:021-6428-0731\">电话预约 021 6428 0731</a>\n          <span class=\"phone-note\">工作日 09:00—19:00</span>\n        </div>\n      </div>\n\n      <div class=\"header-spec\" aria-label=\"店铺规格\">\n        <div class=\"spec-row\">\n          <span class=\"spec-label\">编号</span>\n          <span class=\"spec-value\">NL—SH—05</span>\n        </div>\n        <div class=\"spec-row\">\n          <span class=\"spec-label\">处理范围</span>\n          <span class=\"spec-value\">鞋件 / 锁具 / 钥匙</span>\n        </div>\n        <div class=\"spec-row\">\n          <span class=\"spec-label\">地址</span>\n          <span class=\"spec-value\">静安区北站街 18 号</span>\n        </div>\n        <div class=\"spec-row\">\n          <span class=\"spec-label\">取件</span>\n          <span class=\"spec-value\">当日或次日</span>\n        </div>\n      </div>\n    </header>\n\n    <main>\n      <section aria-labelledby=\"service-title\">\n        <div class=\"section-head\">\n          <div>\n            <span class=\"section-index\">01 / SERVICE TABLE</span>\n            <h2 id=\"service-title\">服务与价格</h2>\n          </div>\n          <p class=\"section-note\">价格为常规工况参考，特殊材料电话确认。</p>\n        </div>\n\n        <div class=\"services-grid\">\n          <article class=\"service\">\n            <span class=\"service-code\">S—01</span>\n            <h3>鞋底更换</h3>\n            <p>整底拆换，检查中底与沿条。普通橡胶底按鞋型核价。</p>\n            <div class=\"service-meta\">\n              <span>工时 1—2 日</span>\n              <strong class=\"price\">¥80 起</strong>\n            </div>\n          </article>\n\n          <article class=\"service\">\n            <span class=\"service-code\">S—02</span>\n            <h3>鞋跟修补</h3>\n            <p>适用于皮鞋、休闲鞋及工作鞋。先处理磨损面，再固定新跟。</p>\n            <div class=\"service-meta\">\n              <span>工时 当日</span>\n              <strong class=\"price\">¥35 起</strong>\n            </div>\n          </article>\n\n          <article class=\"service\">\n            <span class=\"service-code\">S—03</span>\n            <h3>钥匙复制</h3>\n            <p>民用平钥匙、十字钥匙、部分防盗门钥匙均可现场检测。</p>\n            <div class=\"service-meta\">\n              <span>工时 10 分钟</span>\n              <strong class=\"price\">¥15 起</strong>\n            </div>\n          </article>\n\n          <article class=\"service\">\n            <span class=\"service-code\">S—04</span>\n            <h3>皮具补线</h3>\n            <p>断线、开口、边缘脱胶。保留原结构，不改动有效部位。</p>\n            <div class=\"service-meta\">\n              <span>工时 1 日</span>\n              <strong class=\"price\">¥30 起</strong>\n            </div>\n          </article>\n\n          <article class=\"service\">\n            <span class=\"service-code\">S—05</span>\n            <h3>锁具调整</h3>\n            <p>处理门锁卡顿、锁舌偏位与钥匙转动不顺。上门服务需先电话确认。</p>\n            <div class=\"service-meta\">\n              <span>工时 30 分钟</span>\n              <strong class=\"price\">¥60 起</strong>\n            </div>\n          </article>\n        </div>\n      </section>\n\n      <section class=\"work-record\" aria-labelledby=\"record-title\">\n        <div class=\"record-copy\">\n          <span class=\"section-index\">02 / WORK RECORD</span>\n          <h2 id=\"record-title\">到店前，带上可读的信息</h2>\n          <p>请说明物件类型、故障位置和期望取件时间。需要确认材料时，电话中直接给出判断。</p>\n          <div class=\"record-list\">\n            <div>鞋类：鞋底 / 鞋跟 / 开线</div>\n            <div>钥匙：原钥匙 / 锁型 / 数量</div>\n            <div>时间：当日 / 次日 / 预约</div>\n            <div>方式：到店 / 电话确认</div>\n          </div>\n        </div>\n        <div class=\"image-frame\">\n          <img src=\"images/占位-1.jpg\" width=\"760\" height=\"420\" alt=\"修鞋与配钥匙工作台\">\n        </div>\n      </section>\n\n      <section class=\"contact-strip\" aria-labelledby=\"contact-title\">\n        <h2 id=\"contact-title\">有项目，再打电话。</h2>\n        <div class=\"contact-detail\">\n          <div>\n            <a class=\"phone-number\" href=\"tel:021-6428-0731\">021 6428 0731</a>\n            <p class=\"hours\">周一至周六 09:00—19:00　/　周日 10:00—16:00</p>\n          </div>\n          <a class=\"call-button\" href=\"tel:021-6428-0731\">现在预约</a>\n        </div>\n      </section>\n    </main>\n\n    <footer>\n      <span class=\"footer-label\">NL—SH—05 / NORTH LINE</span>\n      <span>尺寸以现场检测为准</span>\n    </footer>\n  </div>\n\n  <script>\n    (function () {\n      var ruler = document.querySelector(\"[data-ruler]\");\n      if (!ruler || !(\"IntersectionObserver\" in window)) return;\n\n      var observer = new IntersectionObserver(function (entries) {\n        entries.forEach(function (entry) {\n          if (entry.isIntersecting) {\n            ruler.classList.add(\"is-live\");\n            observer.unobserve(ruler);\n          }\n        });\n      }, { threshold: 0, rootMargin: \"0px 0px -33% 0px\" });\n\n      observer.observe(ruler);\n    }());\n  </script>\n</body>\n</html>"
