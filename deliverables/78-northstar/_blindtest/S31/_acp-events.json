        "content": {
          "type": "text",
          "text": " <!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>北线修鞋配钥匙｜工程规格表</title>\n  <style>\n    :root {\n      --ink: #F2F0EC;\n      --paper: #5F5B55;\n      --ink-soft: #DEDAD3;\n      --paper-deep: #55514B;\n      --rule: #8A857C;\n      --hover-dark: #3D3A35;\n      --hover-deep: #1C1B19;\n    }\n\n    * {\n      box-sizing: border-box;\n    }\n\n    html {\n      background: var(--paper);\n      scroll-behavior: smooth;\n    }\n\n    body {\n      margin: 0;\n      background: var(--paper);\n      color: var(--ink);\n      font-family: \"Noto Serif SC\", Literata, Georgia;\n      font-size: 16px;\n      line-height: 1.6;\n    }\n\n    a {\n      color: inherit;\n      text-decoration: none;\n    }\n\n    .site-shell {\n      width: min(1440px, 100%);\n      min-height: 100vh;\n      margin: 0 auto;\n      padding: 0 40px;\n      overflow: hidden;\n    }\n\n    .ruler {\n      position: relative;\n      display: flex;\n      align-items: stretch;\n      height: 48px;\n      border-top: 1.5px solid var(--rule);\n      border-bottom: 1.5px solid var(--rule);\n      overflow: hidden;\n    }\n\n    .ruler-track {\n      display: flex;\n      align-items: flex-start;\n      width: max-content;\n      min-width: 100%;\n      height: 100%;\n    }\n\n    .tick {\n      display: block;\n      flex: 0 0 12px;\n      height: 12px;\n      margin-top: 0;\n      border-left: 1px solid var(--rule);\n    }\n\n    .tick.major {\n      height: 34px;\n      border-left-width: 1.5px;\n    }\n\n    .tick.end {\n      height: 30px;\n    }\n\n    .is-live .tick.major {\n      border-left-width: 2px;\n      transition: border-left-width 180ms ease;\n    }\n\n    .masthead {\n      display: grid;\n      grid-template-columns: minmax(0, 1.6fr) minmax(260px, 0.8fr);\n      gap: 48px;\n      padding: 54px 0 62px;\n      border-bottom: 1px solid var(--rule);\n    }\n\n    .eyebrow,\n    .section-index,\n    .service-code,\n    .service-meta,\n    .spec-label,\n    .footer-label {\n      font-family: \"Jost\", \"Noto Sans SC\";\n      letter-spacing: 0.08em;\n      text-transform: uppercase;\n    }\n\n    .eyebrow {\n      margin: 0 0 20px;\n      color: var(--ink-soft);\n      font-size: 13px;\n      line-height: 1.3;\n    }\n\n    h1,\n    h2,\n    h3,\n    p {\n      margin-top: 0;\n    }\n\n    h1 {\n      max-width: 900px;\n      margin-bottom: 24px;\n      font-family: \"Jost\", \"Noto Sans SC\";\n      font-size: clamp(64px, 8vw, 104px);\n      font-weight: 500;\n      letter-spacing: -0.055em;\n      line-height: 0.96;\n    }\n\n    .lead {\n      max-width: 590px;\n      margin-bottom: 0;\n      color: var(--ink-soft);\n      font-size: 18px;\n      line-height: 1.8;\n    }\n\n    .header-spec {\n      align-self: end;\n      border-left: 1px solid var(--rule);\n      padding-left: 24px;\n    }\n\n    .spec-row {\n      display: grid;\n      grid-template-columns: 92px 1fr;\n      gap: 12px;\n      padding: 10px 0;\n      border-bottom: 1px solid var(--rule);\n    }\n\n    .spec-row:first-child {\n      border-top: 1px solid var(--rule);\n    }\n\n    .spec-label {\n      color: var(--ink-soft);\n      font-size: 12px;\n    }\n\n    .spec-value {\n      color: var(--ink);\n      font-size: 15px;\n    }\n\n    .action-row {\n      display: flex;\n      align-items: center;\n      gap: 20px;\n      margin-top: 34px;\n    }\n\n    .call-button {\n      display: inline-flex;\n      align-items: center;\n      justify-content: center;\n      min-width: 190px;\n      min-height: 52px;\n      padding: 12px 20px;\n      border: 1.5px solid var(--ink);\n      background: var(--ink);\n      color: var(--paper-deep);\n      font-family: \"Jost\", \"Noto Sans SC\";\n      font-size: 15px;\n      letter-spacing: 0.04em;\n      transition: padding 80ms ease, transform 80ms ease;\n    }\n\n    .call-button:active {\n      padding: 13px