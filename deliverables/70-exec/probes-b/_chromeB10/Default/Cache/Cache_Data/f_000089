<script>
(function () {
  var reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
  var rail = document.getElementById('river-rail');
  var riverWrap = document.querySelector('.river-wrap');
  var cards = [].slice.call(document.querySelectorAll('.card'));
  var issue = document.getElementById('issue');
  var issueState = document.getElementById('issue-state');
  var emptyNote = document.getElementById('river-empty');
  var readBtn = document.getElementById('read-12');
  var RAIL_STEP = 96;          /* 轨道间距 96px */
  var DRIFT = 0.6;             /* 漂移速度 = 滚动量的 0.6 倍 */

  /* 卡片自轨道远端以 240ms 间隔逐张流入，位移 40px（缓动近匀速）。
     拍子由 CSS 的 --d 承担，不需要脚本；这里只做一件事：动画跑完后摘掉
     animation，好让后面的状态（最左一张淡出、锚定加深）改得动 opacity。 */
  cards.forEach(function (c) {
    c.addEventListener('animationend', function () { c.classList.add('is-settled'); }, { once: true });
  });

  /* 河道漂移：每张卡片沿轨道法线按滚动量的 0.6 倍漂移，
     系数 0.92–1.08 各不相同（写在 HTML 的固定表里），这一段是差速部分。 */
  function drift() {
    if (reduced.matches) return;
    var vh = window.innerHeight;
    cards.forEach(function (c) {
      var r = c.getBoundingClientRect();
      var prev = parseFloat(c.dataset.dy || '0');
      var natural = r.top + r.height / 2 - prev;      /* 扣掉上一次的位移，避免自反馈 */
      var lag = vh / 2 - natural;
      var coef = parseFloat(getComputedStyle(c).getPropertyValue('--coef')) || 1;
      var dy = lag * DRIFT * (coef - 1);
      if (dy > 46) dy = 46; else if (dy < -46) dy = -46;
      c.dataset.dy = dy.toFixed(2);
      c.style.setProperty('--dy', dy.toFixed(2) + 'px');
    });
    /* 轨道上的渍痕带按 0.6 倍的滚动量沿轨道滑，取 96px 的模让它无限流下去 */
    var slide = -((window.scrollY * DRIFT) % RAIL_STEP);
    riverWrap.style.setProperty('--rail-drift', slide.toFixed(1) + 'px');
  }
  var queued = false;
  function onScroll() {
    if (queued) return;
    queued = true;
    window.requestAnimationFrame(function () { queued = false; drift(); });
  }
  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll);
  drift();

  /* 期号切换：整条轨道横移 64px，最左一张卡片先淡出，不做交叉淡化 */
  var SHIFT = 64;
  function setIssue(v) {
    rail.classList.toggle('is-shifted', v === '66');
    rail.classList.toggle('is-idle', v === '68');
    var first = cards[0];
    if (v === '66') {
      first.classList.add('is-gone');
      issueState.textContent = '已切到第六十六期：轨道横移 ' + SHIFT + 'px，第 12 期（最左一张）淡出，其余九张留在原处，不做交叉淡化。';
    } else if (v === '68') {
      first.classList.remove('is-gone');
      issueState.textContent = '第六十八期还没开工。这一期还没有新稿。灶上正煮着深焙，二十分钟后再回来看看。';
    } else {
      first.classList.remove('is-gone');
      issueState.textContent = '轨道上是第 3 期到第 12 期共十张卡片，加轨道尾端三张空白卡片。切换期号时整条轨道横移 64px，最左一张先淡出。';
    }
    emptyNote.classList.toggle('is-on', v === '68');
  }
  issue.addEventListener('change', function () { setIssue(issue.value); });

  /* 主张句那颗按钮：把轨道锚到第 12 期，并把它的杯渍环调深 2% */
  readBtn.addEventListener('click', function () {
    issue.value = '67';
    setIssue('67');
    var target = cards[0];
    target.classList.add('is-picked');
    target.scrollIntoView({
      behavior: reduced.matches ? 'auto' : 'smooth',
      block: 'center'
    });
    window.setTimeout(function () { target.classList.remove('is-picked'); }, 1600);
    issueState.textContent = '已锚到第 12 期：一把用了 17 年的铜壶。这张卡片的杯渍环加深 2% 不透明度，标记它是最深的一圈。';
  });

  if (reduced.matches) {
    /* 降级时轨道不漂：卡片回到轨道上的固定错位，只留 120ms 不透明度切换 */
    cards.forEach(function (c) { c.style.removeProperty('--dy'); });
    riverWrap.style.setProperty('--rail-drift', '0px');
    issueState.textContent = '本机开启了减少动态效果：轨道静止，卡片的漂移速度差改成固定错位（每级 12px，系数照旧 0.92–1.08），渍痕带停在 96px 处，只保留 120ms 的不透明度切换与杯渍加深。';
  }
  reduced.addEventListener('change', function () {
    if (reduced.matches) { cards.forEach(function (c) { c.style.removeProperty('--dy'); }); riverWrap.style.setProperty('--rail-drift', '0px'); }
    else { drift(); }
  });
})();
</script>
