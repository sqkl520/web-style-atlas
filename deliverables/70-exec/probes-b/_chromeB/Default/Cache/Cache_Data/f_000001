<script>
(function () {
  var reduce = matchMedia('(prefers-reduced-motion: reduce)');
  var cols = [].slice.call(document.querySelectorAll('.col'));

  // 加载：纸纹先出（见 style.css 的 .sheet::before），300ms 后四栏按 60ms 间隔逐栏落版。
  document.documentElement.classList.add('is-landing');

  // 区块进入视口 10% 时自左下 12px 就位，320ms，先快后顿（像铅块落版）。
  var blocks = [].slice.call(document.querySelectorAll('.plate, .state-band, .makeup, .foot'));
  if ('IntersectionObserver' in window) {
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (e.isIntersecting) { e.target.classList.add('is-set'); io.unobserve(e.target); }
      });
    }, { threshold: 0.1, rootMargin: '0px 0px -4% 0px' });
    blocks.forEach(function (b) { io.observe(b); });
  } else {
    blocks.forEach(function (b) { b.classList.add('is-set'); });
  }

  // 折角：整叠翻开／合上。
  var panel = document.getElementById('fold-panel');
  var corner = document.getElementById('unfold');
  var items = [].slice.call(document.querySelectorAll('.fold-item'));
  function setItem(btn, open) {
    btn.setAttribute('aria-expanded', open ? 'true' : 'false');
    var body = btn.parentNode.querySelector('.fold-body');
    if (body) { body.hidden = !open; }
  }
  function anyOpen() { return items.some(function (b) { return b.getAttribute('aria-expanded') === 'true'; }); }
  corner.addEventListener('click', function () {
    var open = !anyOpen();
    items.forEach(function (b) { setItem(b, open); });
    corner.setAttribute('aria-expanded', open ? 'true' : 'false');
    panel.classList.toggle('is-open', open);
  });
  items.forEach(function (btn) {
    btn.addEventListener('click', function () {
      setItem(btn, btn.getAttribute('aria-expanded') !== 'true');
      corner.setAttribute('aria-expanded', anyOpen() ? 'true' : 'false');
    });
  });
  document.getElementById('to-fold').addEventListener('click', function () {
    panel.scrollIntoView({ behavior: reduce.matches ? 'auto' : 'smooth', block: 'start' });
    var closed = items.filter(function (b) { return b.getAttribute('aria-expanded') !== 'true'; })[0];
    if (closed) { setItem(closed, true); closed.focus(); }
    else { corner.focus(); }
  });

  // 上版重试：仍然是失败态，错误码不变。
  var tries = 1;
  var retry = document.getElementById('retry');
  var note = document.getElementById('retry-note');
  retry.addEventListener('click', function () {
    tries += 1;
    retry.setAttribute('aria-busy', 'true');
    retry.disabled = true;
    note.textContent = '第 ' + tries + ' 次重排：走版到第五百七十' + (tries > 2 ? '九' : '二') + '行，3 号铅条再次卡住，错误码仍是 P-03。';
    setTimeout(function () {
      retry.removeAttribute('aria-busy');
      retry.disabled = false;
    }, reduce.matches ? 120 : 900);
  });

  // 栏号：滚动时以 steps(1) 跳变，不做补间。
  var no = document.getElementById('colno');
  var ticking = false;
  function pick() {
    ticking = false;
    var line = 24 + 148;
    var cur = 1;
    for (var i = 0; i < cols.length; i++) {
      var top = cols[i].getBoundingClientRect().top;
      if (top <= line) { cur = i + 1; }
    }
    var v = String(cur);
    if (no.textContent !== v) { no.textContent = v; }
  }
  addEventListener('scroll', function () {
    if (!ticking) { ticking = true; requestAnimationFrame(pick); }
  }, { passive: true });
  pick();
})();
</script>
