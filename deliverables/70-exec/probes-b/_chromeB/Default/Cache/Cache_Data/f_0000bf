<script>
(function () {
  var plane = document.getElementById('plane');
  var rm = window.matchMedia('(prefers-reduced-motion: reduce)');
  var plates = [].slice.call(document.querySelectorAll('.plate'));

  window.setTimeout(function () { plane.removeAttribute('data-settling'); }, 180 * 6 + 260);

  var ticking = false;
  function par() {
    ticking = false;
    if (rm.matches) { return; }
    var p = Math.min(1, window.scrollY / 200);
    plates.forEach(function (el) {
      var l = parseInt(el.getAttribute('data-layer'), 10);
      var amp = l >= 4 ? 12 : (l >= 2 ? 6 : 3);
      var face = el.querySelector('.plate-face');
      var ink = el.querySelector('.plate-ink');
      if (face) { face.style.transform = 'translateY(' + (amp * p).toFixed(2) + 'px)'; }
      if (ink) { ink.style.transform = 'translateY(' + (6 * p).toFixed(2) + 'px)'; }
    });
  }
  function req() { if (!ticking) { ticking = true; window.requestAnimationFrame(par); } }
  window.addEventListener('scroll', req, { passive: true });
  par();

  var retract = document.querySelector('[data-retract-btn]');
  if (retract) {
    retract.addEventListener('click', function () {
      plane.setAttribute('data-retract', 'on');
      window.setTimeout(function () {
        plane.removeAttribute('data-retract');
        plane.style.setProperty('--stagger', '70ms');
        plane.setAttribute('data-settling', 'on');
        window.setTimeout(function () {
          plane.removeAttribute('data-settling');
          plane.style.setProperty('--stagger', '180ms');
        }, 70 * 6 + 260);
      }, 240);
    });
  }

  var sp = document.getElementById('specimen-off');
  var ob = document.getElementById('offset-btn');
  if (sp && ob) {
    ob.addEventListener('click', function () {
      var on = sp.getAttribute('data-zoom') === 'on';
      sp.setAttribute('data-zoom', on ? 'off' : 'on');
      ob.textContent = on ? '看 1.2mm 套印错位的对比图' : '回到整张样张';
    });
  }

  var lb = document.getElementById('load-btn');
  if (lb) {
    lb.addEventListener('click', function () {
      if (lb.disabled) { return; }
      lb.disabled = true;
      lb.setAttribute('data-loading', '');
      plane.removeAttribute('data-settling');
      void plane.offsetWidth;
      plane.setAttribute('data-settling', 'on');
      window.setTimeout(function () {
        lb.disabled = false;
        lb.removeAttribute('data-loading');
        plane.removeAttribute('data-settling');
      }, 180 * 6 + 260);
    });
  }

  if (rm.addEventListener) { rm.addEventListener('change', par); }
})();
</script>


</body>
</html>
