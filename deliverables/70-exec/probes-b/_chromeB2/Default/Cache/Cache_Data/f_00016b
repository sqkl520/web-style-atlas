  <p class="colophon__quirk" id="quirk">末字收力不足：该字压深由 0.4mm 降至 0.25mm，右下角留 1.5px 未压满的浅槽，模拟手摇压印机走到末尾时力气不够。<span class="quirk__char" id="quirkChar">力</span></p>
</footer>

<div class="cursorpress" id="cursorPress" aria-hidden="true"></div>

<script>
(function () {
  var root = document.documentElement;
  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

  /* 1. 条款进入视口 20% 时逐条压出：每条 120ms，缓动 steps(2)，模拟压印机一次压下 */
  var clauses = Array.prototype.slice.call(document.querySelectorAll('[data-press]'));
  if ('IntersectionObserver' in window) {
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (e.isIntersecting) { e.target.classList.add('is-pressed'); io.unobserve(e.target); }
      });
    }, { threshold: 0.2 });
    clauses.forEach(function (c) { io.observe(c); });
  } else {
    clauses.forEach(function (c) { c.classList.add('is-pressed'); });
  }

  /* 2. 签发栏：滚过 80% 后固定到视口底部（签发是最后一个动作，所以贴底不贴顶） */
  var signature = document.getElementById('signature');
  var logEl = document.getElementById('log');
  function onScroll() {
    var max = document.documentElement.scrollHeight - window.innerHeight;
    var ratio = max > 0 ? window.scrollY / max : 0;
    /* 滚过 80% 贴底；但「回函登记」一进入下半屏就收回，
       贴底栏只服务签发这一步，绝不压住后面的标题。 */
    var nearLog = logEl ? logEl.getBoundingClientRect().top <= window.innerHeight : false; /* 守卫边界原本是 innerHeight - 220：可贴底栏占的是视口底部约 208px，「回函登记」落在 624~844 这段时 innerHeight-220 判定为"不near"，栏反而保持显示、把标题 100% 盖住（闸门 covered-text）。改成"标题一进入视口就收回"，它就不可能出现在覆盖区里。 */
    var pinned = ratio >= 0.8 && !nearLog;
    signature.classList.toggle('is-pinned', pinned);
    document.body.classList.toggle('is-pinned', pinned);
  }
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
  /* 3. 按下时光源方位角 135° 翻到 315°：切换 120ms、下沉 0.8px；降级时改为瞬时位移加亮度变化 */
  var body = document.body;
  var statusOut = document.getElementById('statusOut');
  var azimuthOut = document.getElementById('azimuthOut');
  var signState = document.getElementById('signState');
  var logList = document.getElementById('logList');
  var logEmpty = document.getElementById('logEmpty');
  var logError = document.getElementById('logError');
  var issueBtn = document.getElementById('issueBtn');
  var issueLabel = document.getElementById('issueLabel');
  var archiveBtn = document.getElementById('archiveBtn');
  var attempts = 0;

  function mode() {
    var r = document.querySelector('input[name="azimuth"]:checked');
    return r ? r.value : 'auto';
  }
  function flip(to) {
    body.setAttribute('data-azimuth', to);
    if (azimuthOut) azimuthOut.textContent = to + '°';
  }
  function log(what, when) {
    var li = document.createElement('li');
    li.className = 'log__item';
    /* 时刻是字面数据，和静态标记里的实测值同口径：包进 <code role="none">。
       为什么不是直接写 class="log__when mono" —— 那会让「点过签发之后」的页面里
       多出一段落在 <code role="none"> 之外的等宽文字：初始渲染合规、交互后不合规，
       而闸门只渲染静态首屏，抓不到。 */
    li.innerHTML = '<span class="log__what"></span><span class="log__when mono"><code role="none"></code></span>';
    li.firstChild.textContent = what;
    li.lastChild.firstChild.textContent = when;
    logList.appendChild(li);
    logList.hidden = false;
    logEmpty.hidden = true;
  }
  function now() {
    var d = new Date();
    var p = function (n) { return (n < 10 ? '0' : '') + n; };
    return (d.getMonth() + 1) + ' 月 ' + d.getDate() + ' 日 ' + p(d.getHours()) + ':' + p(d.getMinutes());
  }
  function busy(on, text) {
    issueBtn.classList.toggle('is-loading', on);
    issueBtn.setAttribute('aria-busy', on ? 'true' : 'false');
    issueLabel.textContent = on ? '压印中…' : '按下即签发（注意光源会反转）';
    if (text) statusOut.textContent = text;
  }

  issueBtn.addEventListener('click', function () {
    var auto = mode() === 'auto';
    logError.hidden = true;
    issueBtn.classList.remove('is-error');
    busy(true, auto ? '压印中：等待光源在 120ms 内由 135° 翻到 315°…' : '压印中：静态 135° 压印，不翻转光源…');
    window.setTimeout(function () {
      attempts += 1;
      if (auto && attempts === 1) {
        /* 失败面：自动反转没能在 120ms 内完成，错误文案点名两条出路 */
        busy(false);
        issueBtn.classList.add('is-error');
        body.setAttribute('data-azimuth', '135');
        if (azimuthOut) azimuthOut.textContent = '135°';
        logError.hidden = false;
        statusOut.textContent = '压印未完成。方位角停在 135°，纸面只留一处半深的槽。';
        return;
      }
      busy(false);
      flip('315');
      signState.textContent = '已签发 · ' + now();
      archiveBtn.disabled = false;
      statusOut.textContent = '已签发。方位角 315°，下沉 0.8px，共 120ms。纸面上的槽现在是凸线。';
      log('签发完成 · 2024-徵-017', now());
      logError.hidden = true;
    }, 520);
  });

  document.getElementById('rejectBtn').addEventListener('click', function () {
    logError.hidden = true;
    statusOut.textContent = '已驳回。印样随原件退回，缺口圆环压在退回栏上。';
    signState.textContent = '已驳回 · ' + now();
    log('驳回 · 印样退回', now());
  });
  document.getElementById('forwardBtn').addEventListener('click', function () {
    logError.hidden = true;
    statusOut.textContent = '已转呈复核科。复核科将在三个工作日内接手本函。';
    signState.textContent = '已转呈 · ' + now();
    log('转呈复核科', now());
  });
  archiveBtn.addEventListener('click', function () {
    statusOut.textContent = '已归档。正本存卷，检索号 徵-2024-017-正。';
    log('归档 · 检索号 徵-2024-017-正', now());
  });

  /* 4. 光标压痕：6×6px 方形，按下加深；reduced-motion 时改为静态方框；触摸设备不启用 */
  var press = document.getElementById('cursorPress');
  var coarse = window.matchMedia('(pointer: coarse)');
  if (!coarse.matches) {
    document.addEventListener('pointermove', function (e) {
      press.style.transform = 'translate3d(' + e.clientX + 'px,' + e.clientY + 'px,0)';
      press.classList.add('is-on');
    });
    document.addEventListener('pointerdown', function () {
      if (!reduce.matches) press.classList.add('is-down');
    });
    document.addEventListener('pointerup', function () { press.classList.remove('is-down'); });
  }
  if (reduce.matches) { press.classList.add('is-static'); }
})();
</script>
</body>
</html>