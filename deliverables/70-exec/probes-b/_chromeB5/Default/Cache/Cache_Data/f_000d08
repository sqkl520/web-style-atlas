<script>
(function () {
  var reduce = matchMedia('(prefers-reduced-motion: reduce)');
  var root = document.documentElement;
  var rowsBox = document.getElementById('rows');
  var tilt = document.getElementById('rows-tilt');
  var lamp = document.querySelector('.lampbox');
  var status = document.getElementById('cat-status');
  var chips = [].slice.call(document.querySelectorAll('.cat'));
  var prices = document.querySelectorAll('#rows code');

  var FILL = '<svg class="trace" viewBox="0 0 118 44" width="118" height="44" aria-hidden="true" focusable="false"><use href="#stroke-outer"/><use href="#stroke-inner"/></svg>';

  /* 第二档价目：切换分类时整档换掉，行高与错开值照旧按固定表取 */
  var LEATHER = [
    ['皮包清洗', '每只 · 含上油', '20.00', '4px'],
    ['皮衣上色', '每件 · 两遍', '80.00', '7px'],
    ['换皮带扣', '含料 · 单只', '18.00', '12px'],
    ['补皮面破口', '每处 2cm', '12.00', '5px'],
    ['加厚鞋垫', '每双 · 裁切', '22.00', '9px'],
    ['皮靴保养', '每双 · 鞋蜡', '35.00', '6px'],
    ['换长拉链', '每 20cm', '28.00', '11px'],
    ['帽子缩号', '每顶 · 蒸汽', '16.00', '8px'],
    ['皮绳换新', '每根 · 含料', '10.00', '10px'],
    ['急件加价', '2 小时内取', '30.00', '4px']
  ];

  function build(data) {
    return data.map(function (r) {
      return '<li class="row" style="--start:' + r[3] + '"><span class="row-name">' + r[0] +
        '</span><span class="row-note">' + r[1] + '</span><span class="row-price">' + FILL +
        '<code>' + r[2] + '</code></span></li>';
    }).join('');
  }

  /* 加载编排：铁皮底先出（style.css 的 .board::before 0ms），漆面色块 200ms 压上，
     锈斑与灯箱最后亮起。行与行的刷出交给下面的 IntersectionObserver。 */
  var brush = function (el) { el.classList.add('is-brushed'); };
  var io = ('IntersectionObserver' in window) ? new IntersectionObserver(function (es) {
    es.forEach(function (e) { if (e.isIntersecting) { brush(e.target); io.unobserve(e.target); } });
  }, { threshold: 0.15, rootMargin: '0px 0px -8% 0px' }) : null;

  function watch(scope) {
    var list = [].slice.call(scope.querySelectorAll('.row, .plate, .tools li, .repaint, .shut, .foot'));
    list.forEach(function (el, i) {
      el.style.setProperty('--d', (i % 6) * 60 + 'ms');
      if (reduce.matches) { brush(el); return; }
      if (io) { io.observe(el); } else { brush(el); }
    });
    return list;
  }
  watch(document);

  /* 兜底：任何被观察元素在 1.2s 后仍未刷出，就直接显示，绝不把内容留在看不见的状态 */
  setTimeout(function () {
    [].slice.call(document.querySelectorAll('.row, .plate, .tools li, .repaint, .shut, .foot'))
      .forEach(function (el) { el.classList.add('is-brushed'); });
  }, 1200);

  /* 悬停重描：500ms 分六段落下，缺口位置由路径几何固定，重描结束仍在原处。 */
  prices.forEach(function (el) {
    var row = el.closest('.row');
    if (!row) return;
    row.addEventListener('mouseenter', function () { row.classList.add('is-retrace'); });
    row.addEventListener('mouseleave', function () { row.classList.remove('is-retrace'); });
  });

  /* 主按钮：跳到今天的分量标注 */
  var toPortions = document.getElementById('to-portions');
  toPortions.addEventListener('click', function () {
    var t = document.getElementById('portions');
    if (t) { t.scrollIntoView({ behavior: reduce.matches ? 'auto' : 'smooth', block: 'start' }); }
  });

  /* 转场：切档时灯箱先暗到 40% 亮度（80ms）再回升（160ms），价目行整体向右推 16px */
  function switchCat(key, btn) {
    chips.forEach(function (c) { c.setAttribute('aria-pressed', c === btn ? 'true' : 'false'); c.classList.toggle('is-on', c === btn); });
    lamp.classList.remove('is-dip');
    void lamp.offsetWidth;
    if (!reduce.matches) { lamp.classList.add('is-dip'); }
    if (!reduce.matches) {
      tilt.classList.add('is-push');
      setTimeout(function () { tilt.classList.remove('is-push'); }, 200);
    }
    if (key === 'shoe') {
      rowsBox.innerHTML = window.__shoeRows;
      status.textContent = '板上是修鞋与换跟这一档，10 行；这一档里改过价的有 3 处，都留在板上。';
    } else {
      rowsBox.innerHTML = build(LEATHER);
      status.textContent = '板上换成了皮具与上色这一档，10 行；皮具的价按只、按件、按处量，不改按双算的那几行。';
    }
    watch(rowsBox);
    [].slice.call(rowsBox.querySelectorAll('.row')).forEach(function (el) {
      el.addEventListener('mouseenter', function () { el.classList.add('is-retrace'); });
      el.addEventListener('mouseleave', function () { el.classList.remove('is-retrace'); });
    });
  }
  window.__shoeRows = rowsBox.innerHTML;
  chips.forEach(function (btn) {
    btn.addEventListener('click', function () { switchCat(btn.getAttribute('data-cat'), btn); });
  });

  /* 板上的灯：进视口时亮起，之后不再动（no-op 兜底，避免任何"永远暗着"的状态） */
  setTimeout(function () { lamp.classList.add('is-lit'); }, reduce.matches ? 0 : 240);
})();
</script>
</body>
</html>
