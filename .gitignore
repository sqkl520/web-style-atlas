# ── 第三方工具：带自己的 LICENSE 与 .git，属于 vendor，不入本仓库 ──
tools/

# ── 各原型的构建中间物：原始下载、成品图版、质检联系表、字体源文件 ──
# 页面运行只需要 index.html / style.css / assets/ / .inspect/，
# 这三类之外的 build/ 属于过程产物（含 8.7MB 级的 OTF 字体源）。
prototypes/*/build/

# ── 未被页面引用的素材副本（已核：S09 的 8 张 raw 原图没有一个被引用） ──
prototypes/S09-batik-price-board/assets/raw/

# ── 审查阶段的备份与过程大图（文档 md 保留，图片排除） ──
deliverables/_backup-*/
deliverables/tool-runs/

# ── 渲染产物里可再生成的缓存 ──
.taste-skill/
**/.taste-skill/

# ── 临时文件 ──
_tmp_*
_compiler-*.ps1
*.tmp
*.bak-fonts
prototypes/_build/_gate-*.txt
prototypes/_build/_collect-diag.txt

# ── 系统与编辑器 ──
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
node_modules/
__pycache__/
*.pyc

# ── 模板与审查的临时截图/测量目录（用完即删，不入库） ──
_m0*-test/
_m0*-verify*/
_audit*/
.audit-tmp/
_tpl-view/
_vw-out/
_vw-probe.html
.shot-test/

# ── 各模板自带的测量脚本目录（可选保留；默认不入库） ──
templates/*/build/

# ── 锐评/审查 agent 的临时取证目录（截图与中间 JSON 极其庞大）──
# 漏掉这一条我曾把 2833 个文件、75 万行差异误提交进去过。
_crit*/
_audit*/
_s2*w/
_s1*f/
_m0*-test/
_m0*-verify*/
_tpl-view/
_vw-out/

# ── 审查 agent 的草稿目录（放在 deliverables/ 下以免被临时目录 sweeper 扫掉；不进 git）──
deliverables/*-scratch/

# ── deliverables 里的实验产物（2026-11-05）──────────────────────────────────
# 每个复刻/盲测实验都会整份拷贝字体、截图、html、css。实测积到 19523 个文件 /
# 1.43 GB，其中 12498 个 woff2 是 946 个唯一字体被复制成平均 13 份。
# 而 README 只引用 deliverables 里的 5 处。
#
# 结论写在 `.md` 里，产物本身可从 `.mjs` 重跑 —— 所以只留文档、脚本、实测数据，
# 不留这些可再生的二进制与副本。
#
# ⚠️ 排除 78-northstar：那是当前主线工作区，里面的 _probe 是报告本体。
deliverables/[0-9][0-9]-*/**/*.woff2
deliverables/[0-9][0-9]-*/**/*.png
deliverables/[0-9][0-9]-*/**/*.jpg
deliverables/[0-9][0-9]-*/**/*.jpeg
deliverables/[0-9][0-9]-*/**/*.gif
deliverables/[0-9][0-9]-*/**/*.svg
deliverables/[0-9][0-9]-*/**/*.html
deliverables/[0-9][0-9]-*/**/*.css
!deliverables/78-northstar/**

# ---- one-shot scratch left at repo root by review sessions (root-anchored) ----
/.tmp-*
/.tmp_*
/_ud_*/
/_dom_*
/_probe_*
/_scan_reports/
/_audit_*
/_license_probe*
/_srv.*
/_tpl-view/

# 外部 README skill（本地校验工具，与 tools/ 同等对待：不 vendor、不入库）
_readme-skill-fetch/

# Claude Code 的本地状态（worktrees / sessions / 设置），不入库
.claude/

_commitmsg.txt

# ── 实验中间产物：由脚本可复现生成，不入库 ──────────────────────────
# _fallback-consequence.mjs 生成的 20 份对照 HTML（链末补/不补终止符）。
# 它们每次跑都会重新生成，且内容能从脚本推出来 —— 入库只会变成 20 个噪音文件。
deliverables/78-northstar/_probe/_fa-out/
