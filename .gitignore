# ── 第三方工具：带自己的 LICENSE 与 .git，属于 vendor，不入本仓库 ──
tools/

# ── 各原型的构建中间物：原始下载、成品图版、质检联系表、字体源文件 ──
# 页面运行只需要 index.html / style.css / assets/ / .inspect/，
# 这三类之外的 build/ 属于过程产物（含 8.7MB 级的 OTF 字体源）。
prototypes/*/build/

# ── 未被页面引用的素材副本（已核：S09 的 8 张 raw 原图没有一个被引用） ──
prototypes/S09-batik-price-board/assets/raw/

# ── 审查阶段的备份与过程大图（文档 md 保留，图片排除） ──
deliverables/_backup-*/
deliverables/tool-runs/

# ── 渲染产物里可再生成的缓存 ──
.taste-skill/
**/.taste-skill/

# ── 临时文件 ──
_tmp_*
_compiler-*.ps1
*.tmp
*.bak-fonts
prototypes/_build/_gate-*.txt
prototypes/_build/_collect-diag.txt

# ── 系统与编辑器 ──
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
node_modules/
__pycache__/
*.pyc

# ── 模板与审查的临时截图/测量目录（用完即删，不入库） ──
_m0*-test/
_m0*-verify*/
_audit*/
_tpl-view/
_vw-out/
_vw-probe.html
.shot-test/

# ── 各模板自带的测量脚本目录（可选保留；默认不入库） ──
templates/*/build/

# ── 锐评/审查 agent 的临时取证目录（截图与中间 JSON 极其庞大）──
# 漏掉这一条我曾把 2833 个文件、75 万行差异误提交进去过。
_crit*/
_audit*/
_s2*w/
_s1*f/
_m0*-test/
_m0*-verify*/
_tpl-view/
_vw-out/

# ── 审查 agent 的草稿目录（放在 deliverables/ 下以免被临时目录 sweeper 扫掉；不进 git）──
deliverables/*-scratch/

# ── 实习课题双选平台：运行期数据不得入库（含首启生成的 data/secret.key、会话库、单实例锁）──
# 出厂初始态在 internship-portal/data.example/，是入库的。
# 写 `data/*` 而不是 `data/`：Git 对被整体排除的目录不再向下遍历，
# 于是 `data/` + 任何 `!data/xxx` 重包含都失效（本层需要保留 data/.gitkeep 与
# data/.gitignore 两个哨兵，好让 clone 出来的目录存在且自带屏蔽规则）。
internship-portal/data/*
!internship-portal/data/.gitkeep
!internship-portal/data/.gitignore
# ⚠️ 注意：上面第 2 行的 `tools/` 是未锚定模式，在任意深度都匹配——
# 所以本项目的脚本目录叫 internship-portal/scripts/，不叫 tools/（详见方案 §3 F-16 的注解）。

# ---- foreign project: protect against 'git add -A' sweeping it into this public repo ----
# (its own data/secret.key must never be pushed here)
internship-portal/
new_api_internship_project_plan.md
# ---- one-shot scratch left at repo root by review sessions (root-anchored) ----
/.tmp-*
/.tmp_*
/_ud_*/
/_dom_*
/_probe_*
/_scan_reports/
/_audit_*
/_license_probe*
/_srv.*
/_tpl-view/

# 外部 README skill（本地校验工具，与 tools/ 同等对待：不 vendor、不入库）
_readme-skill-fetch/
